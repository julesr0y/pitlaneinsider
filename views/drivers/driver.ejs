                dropShadow: {
                    enabled: false,
                },
                toolbar: {
                    show: false,
                },
            },
            tooltip: {
                enabled: true,
                x: {
                    show: false,
                    formatter: function (value, { series, seriesIndex, dataPointIndex, w }) {
                        return allYears[dataPointIndex]; // Afficher toutes les années dans le tooltip
                    }
                },
                style: {
                    fontSize: '12px',
                    fontFamily: 'F1Regular',
                    color: '#FFFFFF', // Changez cette couleur pour celle que vous souhaitez
                },
                theme: 'dark'
            },
            colors: [chartColor],
            dataLabels: {
                enabled: false,
            },
            stroke: {
                width: 3,
            },
            grid: {
                show: false,
                strokeDashArray: 4,
            },
            series: [
                {
                    name: "Position",
                    data: dataStandings,
                    color: chartColor,
                },
            ],
            xaxis: {
                categories: labelYears,
                axisTicks: {
                    show: false,
                },
                labels: {
                    style: {
                        colors: '#FFFFFF',
                    }
                }
            },
            yaxis: {
                axisBorder: {
                    show: true,
                },
                axisTicks: {
                    show: false,
                },
                labels: {
                    style: {
                        colors: '#FFFFFF',
                        fontSize: '12px',
                    }
                }
            },
        };

        if (document.getElementById("area-chart2") && typeof ApexCharts !== 'undefined') {
            const chart = new ApexCharts(document.getElementById("area-chart2"), options);
            chart.render();
        }
    });
</script>

</html>