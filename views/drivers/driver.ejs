<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <title>PLI - <%= dataDriver.firstName %> <%= dataDriver.lastName %></title>
        <link rel="stylesheet" href="/stylesheets/constructorscolors.css" />
        <script src="/js/apexcharts.min.js"></script>
    </head>

    <body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
        <main>
            <div class="pt-10 px-4 h-auto flex flex-col justify-center">
                <div class="bg-s-<%= theme %> p-4 sm:p-8 rounded-3xl mx-auto max-w-sm sm:max-w-xl h-2/3">
                    <div>
                        <% if (dataDriver.currentSeasonDriver===true) { %>
                        <div class="grid grid-cols-2 grid-rows-2 gap-0 h-full w-full">
                            <div class="flex justify-center items-center h-32 w-auto">
                                <img src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= dataDriver.id %>.webp" alt="<%= dataDriver.firstName %> <%= dataDriver.lastName %>" class="h-32 w-auto" />
                            </div>

                            <div class="flex flex-col justify-center items-center h-32 w-auto">
                                <h1 class="text-lg sm:text-xl font-semibold text-center m-0 leading-none"><%= dataDriver.firstName %> <%= dataDriver.lastName %></h1>
                                <p class="text-sm sm:text-base text-t-s-<%= theme %> text-center m-0 leading-none">
                                    <% if (dataDriver.dateOfDeath===null) { %>
                                    <span>
                                        <%= dataDriver.dateOfBirth %>
                                        (<%= dataDriver.age %>
                                        <%= __('driver.age') %>)
                                    </span>
                                    <% } else { %>
                                    <span>
                                        <%= dataDriver.dateOfBirth %>
                                    </span>
                                    <span>
                                        <%= dataDriver.dateOfDeath %>
                                        (<%= dataDriver.age %>
                                        <%= __('driver.age') %>)
                                    </span>
                                    <% } %>
                                </p>
                            </div>

                            <div class="flex justify-center items-center h-32 w-full">
                                <div class="bg-<%= dataDriver.actualTeam %> text-white sm:p-4 shadow-md w-44 h-full p-2">
                                    <p class="text-base font-F1Bold mt-2 sm:mt-0"><%= __('driver.actual_season') %> <%= __('global.current_year') %></p>
                                    <p class="text-sm mt-1 leading-none"><%= __('driver.races') %>: <%= dataDriver.numberOfRacesCurrentSeason %></p>
                                    <p class="text-sm mt-1 leading-none"><%= __('driver.points') %>: <%= dataDriver.numberOfPointsCurrentSeason %></p>
                                    <p class="text-sm mt-1 leading-none"><%= __('driver.podiums') %>: <%= dataDriver.numberOfPodiumsCurrentSeason %></p>
                                    <p class="text-sm mt-1 leading-none"><%= __('driver.victories') %>: <%= dataDriver.numberOfWinsCurrentSeason %></p>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 grid-rows-2 gap-0 h-32 w-auto items-center">
                                <div class="flex justify-center items-center">
                                    <img src="/img/numbers/number-<%= dataDriver.id %>.avif" alt="<%= dataDriver.permanentNumber %>" class="h-auto w-auto max-h-12" />
                                </div>
                                <div class="flex justify-center items-center">
                                    <a href="/constructor/<%= dataDriver.actualTeam %>">
                                        <img src="/img/constructors/<%= dataDriver.actualTeam %>.webp" alt="<%= dataDriver.actualTeam %>" class="h-auto w-auto max-h-12" />
                                    </a>
                                </div>
                                <div class="flex justify-center items-center">
                                    <img src="/img/countryFlags/<%= dataDriver.nationality.toLowerCase() %>.svg" alt="<%= dataDriver.nationality %>.svg" class="h-14 w-auto" />
                                </div>
                                <div class="flex justify-center items-center">
                                    <img src="/img/helmets/helmet-<%= dataDriver.id %>.avif" alt="Helmet of <%= dataDriver.firstName %> <%= dataDriver.lastName %>" class="h-12 w-auto" />
                                </div>
                            </div>
                            <% } else { %>
                            <div class="grid grid-cols-2 grid-rows-1 gap-0 h-32 w-auto">
                                <div class="flex justify-center items-center h-32 w-auto">
                                    <img src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= dataDriver.id %>.webp" alt="<%= dataDriver.firstName %> <%= dataDriver.lastName %>" class="h-32 w-auto" />
                                </div>

                                <div class="flex flex-col justify-center items-center h-32 w-auto">
                                    <h1 class="text-lg sm:text-xl font-semibold text-center m-0 leading-none"><%= dataDriver.firstName %> <%= dataDriver.lastName %></h1>
                                    <p class="text-sm sm:text-base text-t-s-<%= theme %> text-center m-0 leading-none">
                                        <% if (dataDriver.dateOfDeath === null) { %>
                                        <span>
                                            <%= dataDriver.dateOfBirth %>
                                            (<%= dataDriver.age %>
                                            <%= __('driver.age') %>)
                                        </span>
                                        <% } else { %>
                                        <span>
                                            <%= dataDriver.dateOfBirth %>
                                            -
                                        </span>
                                        <span>
                                            <%= dataDriver.dateOfDeath %>
                                            (<%= dataDriver.age %>
                                            <%= __('driver.age') %>)
                                        </span>
                                        <% } %>
                                    </p>
                                </div>
                            </div>
                            <% } %>
                        </div>

                        <div class="flex flex-col">
                            <div class="text-center mt-4">
                                <h3 class="text-base sm:text-lg font-bold"><%= __('driver.carreer_title') %>:</h3>

                                <% if(dataDriver.totalChampionshipWins !==0) { %>
                                <span class="grid grid-cols-12 mt-4">
                                    <span class="col-span-12 flex flex-col items-center">
                                        <span class="text-gold"> <%= dataDriver.totalChampionshipWins %> </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.totalChampionshipWins') %> </span>
                                    </span>
                                </span>

                                <% } %>

                                <span class="grid grid-cols-12 mt-4">
                                    <span class="col-span-4 flex flex-col">
                                        <span>
                                            <%= dataDriver.firstYear %>
                                        </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.first_year') %> </span>
                                    </span>
                                    <span class="col-span-4 flex flex-col">
                                        <span>
                                            <%= dataDriver.numberOfSeasons %>
                                        </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.number_of_seasons') %> </span>
                                    </span>
                                    <span class="col-span-4 flex flex-col">
                                        <span>
                                            <%= dataDriver.totalRaceStarts %>
                                        </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_races') %> </span>
                                    </span>
                                </span>
                                <span class="grid grid-cols-12 mt-4">
                                    <span class="col-span-4 flex flex-col">
                                        <span>
                                            <%= dataDriver.totalRaceWins %>
                                        </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_victories') %> </span>
                                    </span>
                                    <span class="col-span-4 flex flex-col">
                                        <span>
                                            <%= dataDriver.totalPodiums %>
                                        </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_podiums') %> </span>
                                    </span>
                                    <span class="col-span-4 flex flex-col">
                                        <span>
                                            <%= dataDriver.totalPolePositions %>
                                        </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_poles') %> </span>
                                    </span>
                                </span>
                                <span class="grid grid-cols-12 mt-4">
                                    <span class="col-span-4 flex flex-col">
                                        <span> <%= dataDriver.victoryRatio %>% </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.victory_ratio') %> </span>
                                    </span>
                                    <span class="col-span-4 flex flex-col">
                                        <span> <%= dataDriver.podiumRatio %>% </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.podium_ratio') %> </span>
                                    </span>
                                    <span class="col-span-4 flex flex-col">
                                        <span> <%= dataDriver.poleRatio %>% </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.pole_ratio') %> </span>
                                    </span>
                                </span>
                                <span class="grid grid-cols-12 mt-4">
                                    <span class="col-span-4 flex flex-col">
                                        <span>
                                            <%= dataDriver.totalDriverOfTheDay %>
                                        </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_driver_of_the_day') %> </span>
                                    </span>
                                    <span class="col-span-4 flex flex-col">
                                        <span>
                                            <%= dataDriver.totalFastestLaps %>
                                        </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_fastest_laps') %> </span>
                                    </span>
                                    <span class="col-span-4 flex flex-col">
                                        <span>
                                            <%= dataDriver.totalPoints %>
                                        </span>
                                        <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_points') %> </span>
                                    </span>
                                </span>
                            </div>

                            <div class="text-center mt-4">
                                <h3 class="text-base sm:text-lg font-bold"><%= __('driver.constructors_title') %>:</h3>

                                <div class="mt-6">
                                    <span class="grid grid-cols-12 gap-y-2">
                                        <% dataDriver.teams.forEach(function(team) { %>
                                        <span class="col-span-12 md:col-span-4 flex flex-col items-center mt-4 justify-end">
                                            <a href="/constructor/<%= team.teamId %>" class="flex flex-col items-center gap-y-2">
                                                <img src="/img/constructors/<%= team.teamId %>.webp" alt="<%= team.teamId %>" class="w-auto h-10" />
                                                <span class="text-sm">
                                                    <p class="text-sm sm:text-base"><%= team.teamName %></p>
                                                </span>
                                            </a>
                                            <span class="text-t-s-<%= theme %> text-xs text-center"> <%= team.year %> </span>
                                        </span>
                                        <% }); %>
                                    </span>
                                </div>
                            </div>

                            <% if(dataDriver.allVictories !== null) { %>

                            <div class="text-center mt-4">
                                <h3 class="text-base sm:text-lg font-bold"><%= __('driver.victories_title') %>:</h3>

                                <% for(const year in dataDriver.allVictories) { %>
                                <div class="mt-6 flex flex-col justify-start">
                                    <p class="text-xl"><%= year %></p>
                                    <span class="grid grid-cols-12">
                                        <% (dataDriver.allVictories[year]).forEach(function(victory) { %>
                                        <span class="col-span-3">
                                            <a href="/retrogpdetails/<%= year %>/<%= victory.id %>">
                                                <span class="flex flex-col items-center mt-4">
                                                    <img src="/img/countryFlags/<%= victory.country %>.svg" alt="<%= victory.country %>" class="w-auto h-12" />
                                                    <span class="text-t-s-<%= theme %> text-xs"> <%= victory.shortName %> </span>
                                                </span>
                                            </a>
                                        </span>
                                        <% }); %>
                                    </span>
                                </div>

                                <% }; %>
                            </div>

                            <% } %>

                            <br />
                            <div class="flex justify-center">
                                <div class="max-w-sm w-full rounded-lg">
                                    <div class="flex justify-center"><%= __('driver.points_by_season') %></div>
                                    <div id="area-chart"></div>
                                </div>
                            </div>
                            <div class="flex justify-center">
                                <div class="max-w-sm w-full rounded-lg">
                                    <div class="flex justify-center"><%= __('driver.standing_by_season') %></div>
                                    <div id="area-chart2"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <%- include("../partials/footer.ejs") %>
    </body>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var chartColor = getComputedStyle(document.documentElement).getPropertyValue('--team-<%= dataDriver.actualTeam %>').trim();
            if (chartColor === '') {
                chartColor = '#058785';
            }

            const tableYears = [];
            const allYears = [];
            const tablePoints = [];
            let i = 0;

            ('<% dataDriver.allPointsData.forEach(function(season) { %>');
            allYears.push('<%= season.year %>');
            if (i % 2 == 0) {
                tableYears.push('<%= season.year %>');
            } else {
                tableYears.push('');
            }
            tablePoints.push('<%= season.points %>');
            i++;
            ('<% }) %>');

            const labelYears = tableYears;
            const dataPoints = tablePoints;

            const options = {
                chart: {
                    height: '100%',
                    maxWidth: '100%',
                    type: 'line',
                    fontFamily: 'F1Regular',
                    dropShadow: {
                        enabled: false,
                    },
                    toolbar: {
                        show: false,
                    },
                },
                tooltip: {
                    enabled: true,
                    x: {
                        show: false,
                        formatter: function (value, { series, seriesIndex, dataPointIndex, w }) {
                            return allYears[dataPointIndex]; // Afficher toutes les années dans le tooltip
                        },
                    },
                    style: {
                        fontSize: '12px',
                        fontFamily: 'F1Regular',
                        color: '#FFFFFF', // Changez cette couleur pour celle que vous souhaitez
                    },
                    theme: 'dark',
                },
                colors: [chartColor],
                dataLabels: {
                    enabled: false,
                },
                stroke: {
                    width: 3,
                },
                grid: {
                    show: false,
                    strokeDashArray: 4,
                },
                series: [
                    {
                        name: 'Points',
                        data: dataPoints,
                        color: chartColor,
                    },
                ],
                xaxis: {
                    categories: labelYears,
                    axisTicks: {
                        show: false,
                    },
                    labels: {
                        style: {
                            colors: '#FFFFFF',
                        },
                    },
                },
                yaxis: {
                    axisBorder: {
                        show: true,
                    },
                    axisTicks: {
                        show: false,
                    },
                    labels: {
                        style: {
                            colors: '#FFFFFF',
                            fontSize: '12px',
                        },
                    },
                },
            };

            if (document.getElementById('area-chart') && typeof ApexCharts !== 'undefined') {
                const chart = new ApexCharts(document.getElementById('area-chart'), options);
                chart.render();
            }
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var chartColor = getComputedStyle(document.documentElement).getPropertyValue('--team-<%= dataDriver.actualTeam %>').trim();
            if (chartColor === '') {
                chartColor = '#058785';
            }

            const tableYears = [];
            const allYears = [];
            const tableStandings = [];
            let i = 0;

            ('<% dataDriver.allPositionsData.forEach(function(season) { %>');
            allYears.push('<%= season.year %>');
            if (i % 2 == 0) {
                tableYears.push('<%= season.year %>');
            } else {
                tableYears.push('');
            }
            tableStandings.push('<%= season.position %>');
            i++;
            ('<% }) %>');

            const labelYears = tableYears;
            const dataStandings = tableStandings;

            const options = {
                chart: {
                    height: '100%',
                    maxWidth: '100%',
                    type: 'line',
                    fontFamily: 'F1Regular',
                    dropShadow: {
                        enabled: false,
                    },
                    toolbar: {
                        show: false,
                    },
                },
                tooltip: {
                    enabled: true,
                    x: {
                        show: false,
                        formatter: function (value, { series, seriesIndex, dataPointIndex, w }) {
                            return allYears[dataPointIndex]; // Afficher toutes les années dans le tooltip
                        },
                    },
                    style: {
                        fontSize: '12px',
                        fontFamily: 'F1Regular',
                        color: '#FFFFFF', // Changez cette couleur pour celle que vous souhaitez
                    },
                    theme: 'dark',
                },
                colors: [chartColor],
                dataLabels: {
                    enabled: false,
                },
                stroke: {
                    width: 3,
                },
                grid: {
                    show: false,
                    strokeDashArray: 4,
                },
                series: [
                    {
                        name: 'Position',
                        data: dataStandings,
                        color: chartColor,
                    },
                ],
                xaxis: {
                    categories: labelYears,
                    axisTicks: {
                        show: false,
                    },
                    labels: {
                        style: {
                            colors: '#FFFFFF',
                        },
                    },
                },
                yaxis: {
                    axisBorder: {
                        show: true,
                    },
                    axisTicks: {
                        show: false,
                    },
                    labels: {
                        style: {
                            colors: '#FFFFFF',
                            fontSize: '12px',
                        },
                    },
                },
            };

            if (document.getElementById('area-chart2') && typeof ApexCharts !== 'undefined') {
                const chart = new ApexCharts(document.getElementById('area-chart2'), options);
                chart.render();
            }
        });
    </script>
</html>
