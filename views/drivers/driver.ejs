<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <title>PLI - <%= dataDriver.driver.firstName %> <%= dataDriver.driver.lastName %></title>
        <link rel="stylesheet" href="/stylesheets/constructorscolors.css" />
        <script src="/js/apexcharts.min.js"></script>
    </head>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %>">
        <main>
            <div class="pt-10 px-4 h-auto flex flex-col justify-center">
                <div class="bg-s-<%= theme %> p-4 sm:p-8 rounded-3xl mx-auto max-w-sm sm:max-w-xl h-2/3 flex flex-col justify-center">
                    <div class="flex flex-col justify-center items-center gap-0">
                        <% const birth=new Date(dataDriver.driver.dateOfBirth); const now=new Date(); let age=0; if (dataDriver.driver.dateOfDeath==null) { age=now.getFullYear() - birth.getFullYear(); if (now < new Date(birth.setFullYear(birth.getFullYear() + age))) { age--; } } else { const death=new Date(dataDriver.driver.dateOfDeath); age=death.getFullYear() - birth.getFullYear(); if (death < new Date(birth.setFullYear(birth.getFullYear() + age))) { age--; } } %>

                        <div class="flex flex-col justify-center items-center">
                            <h1 class="text-lg sm:text-xl font-semibold text-center m-0 leading-none"><%= dataDriver.driver.firstName %> <%= dataDriver.driver.lastName %></h1>
                            <p class="text-sm sm:text-base text-t-s-<%= theme %> text-center m-0 leading-none">
                                <% if (dataDriver.driver.dateOfDeath===null) { %>
                                <span>
                                    <%= dataDriver.driver.dateOfBirth %>
                                </span>
                                <% } else { %>
                                <span>
                                    <%= dataDriver.driver.dateOfBirth %>
                                    -
                                    <%= dataDriver.driver.dateOfDeath %>
                                </span>
                                <% } %>
                                <span>
                                    (<%= age %>
                                    <%= __('driver.age') %>)
                                </span>
                            </p>
                        </div>

                        <div class="flex flex-col justify-center items-center pt-2">
                            <img src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= dataDriver.driver.id %>.webp" alt="<%= dataDriver.driver.firstName %> <%= dataDriver.driver.lastName %>" class="h-auto w-auto max-w-36" />
                            <% let bgClass=dataDriver.currentSeason ? `bg-${dataDriver.currentSeason.constructorId}` :
                                `bg-t-${theme}`; %>
                            <div class="<%= bgClass %> h-16 min-w-48 flex justify-evenly items-center gap-2 rounded-lg px-4">
                                <img src="/img/countryFlags/<%= dataDriver.driver.nationalityCountryId.toLowerCase() %>.svg" alt="<%= dataDriver.driver.nationalityCountryId %>.svg" class="h-12 w-auto" />
                                <% if (dataDriver.currentSeason===true) { %>
                                <img src="/img/constructors-driverPage/<%= dataDriver.currentSeason.constructorId %>.webp" alt="<%= dataDriver.currentSeason.constructorId %>" class="h-auto w-auto max-h-12 max-w-20" />
                                <img src="/img/helmets/helmet-<%= dataDriver.driver.id %>.webp" alt="Helmet" class="max-h-12 w-auto" />
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col">
                        <div class="text-center mt-4">
                            <h3 class="text-base sm:text-lg font-bold"><%= __('driver.carreer_title') %></h3>

                            <% if(dataDriver.driver.totalChampionshipWins !==0) { %>
                            <span class="grid grid-cols-12 mt-4">
                                <span class="col-span-12 flex flex-col items-center">
                                    <span class="text-gold"> <%= dataDriver.driver.totalChampionshipWins %> </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.totalChampionshipWins') %> </span>
                                </span>
                            </span>

                            <% } %>

                            <span class="grid grid-cols-12 mt-4">
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= dataDriver.history.firstYear %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.first_year') %> </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= dataDriver.history.numberOfSeasons %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.number_of_seasons') %> </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= dataDriver.driver.totalRaceStarts %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_races') %> </span>
                                </span>
                            </span>
                            <span class="grid grid-cols-12 mt-4">
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= dataDriver.driver.totalRaceWins %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_victories') %> </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= dataDriver.driver.totalPodiums %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_podiums') %> </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= dataDriver.driver.totalPolePositions %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_poles') %> </span>
                                </span>
                            </span>
                            <span class="grid grid-cols-12 mt-4">
                                <span class="col-span-4 flex flex-col">
                                    <span> <%= dataDriver.driver.totalRaceStarts > 0 ? (dataDriver.driver.totalRaceWins / dataDriver.driver.totalRaceStarts * 100).toFixed(1) : 0 %>% </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.victory_ratio') %> </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span> <%= dataDriver.driver.totalRaceStarts > 0 ? (dataDriver.driver.totalPodiums / dataDriver.driver.totalRaceStarts * 100).toFixed(1) : 0 %>% </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.podium_ratio') %> </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span> <%= dataDriver.driver.totalRaceStarts > 0 ? (dataDriver.driver.totalPolePositions / dataDriver.driver.totalRaceStarts * 100).toFixed(1) : 0 %>% </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.pole_ratio') %> </span>
                                </span>
                            </span>
                            <span class="grid grid-cols-12 mt-4">
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= dataDriver.driver.totalDriverOfTheDay %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_driver_of_the_day') %> </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= dataDriver.driver.totalFastestLaps %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_fastest_laps') %> </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= dataDriver.driver.totalPoints %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs"> <%= __('driver.total_points') %> </span>
                                </span>
                            </span>
                        </div>

                        <div class="text-center mt-4">
                            <h3 class="text-base sm:text-lg font-bold"><%= __('driver.constructors_title') %></h3>

                            <div class="mt-6">
                                <span class="grid grid-cols-12 md:grid-cols-10 gap-y-2">
                                    <% dataDriver.teamsHistory.forEach(function(team) { %>
                                    <span class="col-span-3 md:col-span-2 flex flex-col items-center mt-4 justify-end">
                                        <a href="/constructor/<%= team.constructor.id %>" class="flex flex-col items-center gap-y-2" title="<%= team.constructor.name %>">
                                            <img src="/img/constructors/<%= team.constructor.id %>.webp" alt="<%= team.constructor.id %>" class="w-auto h-8" />
                                        </a>
                                        <span class="text-t-s-<%= theme %> text-xs text-center pt-1"> <%= team.year %> </span>
                                    </span>
                                    <% }); %>
                                </span>
                            </div>
                        </div>

                        <% if(dataDriver.driver.totalRaceWins !== 0) { %>

                        <div class="text-center mt-4">
                            <h3 class="text-base sm:text-lg font-bold"><%= __('driver.victories_title') %></h3>

                            <% for(const year in dataDriver.allVictories) { %>
                            <div class="mt-6 flex flex-col justify-start">
                                <p class="text-xl"><%= year %></p>
                                <span class="grid grid-cols-12">
                                    <% (dataDriver.allVictories[year] || []).forEach(function(victory) { %>
                                    <span class="col-span-3">
                                        <a href="/retrogpdetails/<%= year %>/<%= victory.id %>">
                                            <span class="flex flex-col items-center mt-4">
                                                <img src="/img/countryFlags/<%= victory.country %>.svg" alt="<%= victory.country %>" class="w-auto h-12" />
                                                <span class="text-t-s-<%= theme %> text-xs"> <%= victory.shortName %> </span>
                                            </span>
                                        </a>
                                    </span>
                                    <% }); %>
                                </span>
                            </div>

                            <% }; %>
                        </div>

                        <% } %>

                        <br />
                        <% if (dataDriver.driver.totalPoints > 0) { %>
                        <div class="flex justify-center">
                            <div class="max-w-sm w-full rounded-lg">
                                <div class="flex justify-center"><%= __('driver.points_by_season') %></div>
                                <div id="area-chart"></div>
                            </div>
                        </div>
                        <% } else { %>
                        <div class="flex justify-center mb-4">
                            <p class="text-center text-t-s-<%= theme %> italic"><%= __('driver.no_points_scored') || 'Aucun point inscrit en championnat du monde.' %></p>
                        </div>
                        <% } %>
                        
                        <% if (dataDriver.charts.length > 0) { %>
                        <div class="flex justify-center">
                            <div class="max-w-sm w-full rounded-lg">
                                <div class="flex justify-center"><%= __('driver.standing_by_season') %></div>
                                <div id="area-chart2"></div>
                            </div>
                        </div>
                        <% } else { %>
                        <div class="flex justify-center mb-8">
                            <p class="text-center text-t-s-<%= theme %> italic"><%= __('driver.no_standing') || 'Aucun classement général en championnat du monde.' %></p>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
        <%- include("../partials/footer.ejs") %>
    </body>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var chartColor = getComputedStyle(document.documentElement).getPropertyValue('--team-<%= dataDriver.currentSeason ? dataDriver.currentSeason.constructorId : "default" %>').trim();
            if (chartColor === '') {
                chartColor = '#058785';
            }

            const tableYears = [];
            const allYears = [];
            const tablePoints = [];
            let i = 0;

            ('<% dataDriver.charts.forEach(function(season) { %>');
            allYears.push('<%= season.season %>');
            if (i % 2 == 0) {
                tableYears.push('<%= season.season %>');
            } else {
                tableYears.push('');
            }
            tablePoints.push('<%= season.points %>');
            i++;
            ('<% }) %>');

            const labelYears = tableYears;
            const dataPoints = tablePoints;

            const options = {
                chart: {
                    height: '100%',
                    maxWidth: '100%',
                    type: 'line',
                    fontFamily: 'F1Regular',
                    dropShadow: {
                        enabled: false,
                    },
                    toolbar: {
                        show: false,
                    },
                },
                tooltip: {
                    enabled: true,
                    x: {
                        show: false,
                        formatter: function (value, { series, seriesIndex, dataPointIndex, w }) {
                            return allYears[dataPointIndex]; // Afficher toutes les années dans le tooltip
                        },
                    },
                    style: {
                        fontSize: '12px',
                        fontFamily: 'F1Regular',
                        color: '#FFFFFF', // Changez cette couleur pour celle que vous souhaitez
                    },
                    theme: 'dark',
                },
                colors: [chartColor],
                dataLabels: {
                    enabled: false,
                },
                stroke: {
                    width: 3,
                },
                grid: {
                    show: false,
                    strokeDashArray: 4,
                },
                series: [
                    {
                        name: 'Points',
                        data: dataPoints,
                        color: chartColor,
                    },
                ],
                xaxis: {
                    categories: labelYears,
                    axisTicks: {
                        show: false,
                    },
                    labels: {
                        style: {
                            colors: '#FFFFFF',
                        },
                    },
                },
                yaxis: {
                    axisBorder: {
                        show: true,
                    },
                    axisTicks: {
                        show: false,
                    },
                    labels: {
                        style: {
                            colors: '#FFFFFF',
                            fontSize: '12px',
                        },
                    },
                },
            };

            if (document.getElementById('area-chart') && typeof ApexCharts !== 'undefined') {
                const chart = new ApexCharts(document.getElementById('area-chart'), options);
                chart.render();
            }
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var chartColor = getComputedStyle(document.documentElement).getPropertyValue('--team-<%= dataDriver.currentSeason ? dataDriver.currentSeason.constructorId : "default" %>').trim();
            if (chartColor === '') {
                chartColor = '#058785';
            }

            const tableYears = [];
            const allYears = [];
            const tableStandings = [];
            let i = 0;

            ('<% dataDriver.charts.forEach(function(season) { %>');
            allYears.push('<%= season.season %>');
            if (i % 2 == 0) {
                tableYears.push('<%= season.season %>');
            } else {
                tableYears.push('');
            }
            tableStandings.push('<%= season.position %>');
            i++;
            ('<% }) %>');

            const labelYears = tableYears;
            const dataStandings = tableStandings;

            const options = {
                chart: {
                    height: '100%',
                    maxWidth: '100%',
                    type: 'line',
                    fontFamily: 'F1Regular',
                    dropShadow: {
                        enabled: false,
                    },
                    toolbar: {
                        show: false,
                    },
                },
                tooltip: {
                    enabled: true,
                    x: {
                        show: false,
                        formatter: function (value, { series, seriesIndex, dataPointIndex, w }) {
                            return allYears[dataPointIndex]; // Afficher toutes les années dans le tooltip
                        },
                    },
                    style: {
                        fontSize: '12px',
                        fontFamily: 'F1Regular',
                        color: '#FFFFFF', // Changez cette couleur pour celle que vous souhaitez
                    },
                    theme: 'dark',
                },
                colors: [chartColor],
                dataLabels: {
                    enabled: false,
                },
                stroke: {
                    width: 3,
                },
                grid: {
                    show: false,
                    strokeDashArray: 4,
                },
                series: [
                    {
                        name: 'Position',
                        data: dataStandings,
                        color: chartColor,
                    },
                ],
                xaxis: {
                    categories: labelYears,
                    axisTicks: {
                        show: false,
                    },
                    labels: {
                        style: {
                            colors: '#FFFFFF',
                        },
                    },
                },
                yaxis: {
                    axisBorder: {
                        show: true,
                    },
                    axisTicks: {
                        show: false,
                    },
                    labels: {
                        style: {
                            colors: '#FFFFFF',
                            fontSize: '12px',
                        },
                    },
                },
            };

            if (document.getElementById('area-chart2') && typeof ApexCharts !== 'undefined') {
                const chart = new ApexCharts(document.getElementById('area-chart2'), options);
                chart.render();
            }
        });
    </script>
</html>
