        let i = 0;

        '<% dataDriver.allPositionsData.forEach(function(season) { %>'
        allYears.push('<%= season.year %>');
        if (i % 2 == 0) {
            tableYears.push('<%= season.year %>');
        } else {
            tableYears.push('');
        }
        tableStandings.push('<%= season.position %>');
        i++;
        '<% }) %>'

        const labelYears = tableYears;
        const dataStandings = tableStandings;

        const options = {
            chart: {
                height: "100%",
                maxWidth: "100%",
                type: "line",
