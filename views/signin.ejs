<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head.ejs') %>
        <%- include('partials/header.ejs') %>
            <title>PLI - Connexion</title>
</head>

<body class="font-F1Bold">
    <div class="flex items-center justify-center">
        <form class="px-10 py-8 rounded-lg w-full max-w-sm" action="/signinProcess" method="post">
            <div class="grid gap-4 mb-4">
                <input type="email" name="email" placeholder="Email"
                    class="input-bg px-4 py-2 rounded-3xl shadow-sm w-full bg-gray-200" required>
                <input type="password" name="mdp" placeholder="Mot de passe"
                    class="input-bg px-4 py-2 rounded-3xl shadow-sm w-full bg-gray-200" required>
            </div>
            <div class="flex items-center justify-between mb-4">
                <button type="submit" class="px-4 py-2 bg-main-color text-white font-semibold rounded-3xl w-full mr-2">
                    Connexion
                </button>
                <a href="/signup"
                    class="px-4 py-2 font-semibold rounded-3xl border-2 border-main-color w-full ml-2 text-main-color text-center">
                    Inscription
                </a>
            </div>
            <% if (typeof msg !=='undefined' ) { %>
                <p class="text-red-500">Erreur, email ou mot de passe incorrect, connexion impossible</p>
                <% } %>
        </form>
    </div>
    <%- include('partials/footer.ejs') %>
</body>

</html>