<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head.ejs') %>
        <%- include('partials/header.ejs') %>
            <title>PLI - <%= trackFront.trackName %>
            </title>
</head>

<body class="bg-gray-100 h-auto flex flex-col justify-center font-F1Regular">
    <div
        class="text-3xl font-bold text-center my-8 text-lg font-semibold mb-4 w-full pt-4 lg:pt-8 lg:text-3xl lg:font-bold lg:my-8">
        Saison 2024 - Circuits
    </div>
    <div class="bg-gray-200 p-4 sm:p-8 rounded-3xl mx-auto max-w-sm sm:max-w-xl h-2/3">
        <div class="flex items-center justify-center gap-4">
            <img src="/img/countryFlags/<%= trackFront.trackCountry.toLowerCase() %>.svg" alt="Drapeau de l'Italie"
                class="h-12 w-auto">
            <h1 class="text-lg font-F1Bold mb-2">
                <%= trackFront.trackName %>
            </h1>
        </div>

        <!-- Circuit Map -->
        <div class="flex justify-center">
            <img src="/img/2024/circuit/<%= trackFront.trackId.toLowerCase() %>.webp" alt="Map of Monza Circuit"
                class="w-full h-auto">
        </div>

        <!-- Race Info -->
        <div class="text-center mt-4">
            <p><strong>Création : </strong>
                <%= dataCircuit.creationYear %>
            </p>
            <p><strong>Tours : </strong>
                <%= dataCircuit.lapsNumber %>
            </p>
            <p><strong>Distance sur un tour : </strong>
                <%= dataCircuit.oneLapDistance %>km
            </p>
            <p><strong>Distance totale : </strong>
                <%= dataCircuit.totalDistance %>km
            </p>
            <p><strong>Pole record : </strong>
                <%= dataCircuit.lapRecord %>
            </p>
        </div>
    </div>
    <%- include('partials/footer.ejs') %>
</body>

</html>