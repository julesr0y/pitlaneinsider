<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <title>PLI - <%= teamFront.constructor.name %></title>
    </head>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %>">
        <main>
            <div class="pt-10 px-4 sm:px-8 h-auto flex flex-col justify-center">
                <div class="bg-s-<%= theme %> p-4 rounded-3xl mx-auto max-w-sm sm:max-w-xl h-2/3">
                    <div class="text-center">
                        <h1 class="text-lg font-bold mb-2"><%= teamFront.constructor.fullName %></h1>
                    </div>

                    <div class="flex justify-center">
                        <img src="/img/constructors/<%= teamFront.constructor.id %>.webp" alt="<%= teamFront.constructor.id %>" class="h-20 w-auto" />
                    </div>

                    <div class="text-center">
                        <% if(teamFront.constructor.totalChampionshipWins !==0) { %>
                        <span class="grid grid-cols-12 mt-4">
                            <span class="col-span-12 flex flex-col items-center">
                                <span class="text-gold"> <%= teamFront.constructor.totalChampionshipWins %> </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.totalChampionshipWins') %> </span>
                            </span>
                        </span>
                        <% } %>

                        <span class="grid grid-cols-12 mt-4">
                            <span class="col-span-4 flex flex-col">
                                <span>
                                    <%= teamFront.history.firstYear %>
                                </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.constructor_start') %> </span>
                            </span>
                            <span class="col-span-4 flex flex-col">
                                <span>
                                    <%= teamFront.history.numberOfSeasons %>
                                </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.number_of_seasons') %> </span>
                            </span>
                            <span class="col-span-4 flex flex-col">
                                <span>
                                    <%= teamFront.constructor.totalRaceStarts %>
                                </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.total_races') %> </span>
                            </span>
                        </span>

                        <span class="grid grid-cols-12 mt-4">
                            <span class="col-span-4 flex flex-col">
                                <span>
                                    <%= teamFront.constructor.totalRaceWins %>
                                </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.total_wins') %> </span>
                            </span>
                            <span class="col-span-4 flex flex-col">
                                <span>
                                    <%= teamFront.constructor.totalPodiumRaces %>
                                </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.total_podiums') %> </span>
                            </span>
                            <span class="col-span-4 flex flex-col">
                                <span>
                                    <%= teamFront.constructor.totalPolePositions %>
                                </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.total_poles') %> </span>
                            </span>
                        </span>

                        <span class="grid grid-cols-12 mt-4">
                            <span class="col-span-4 flex flex-col">
                                <span>
                                    <%= teamFront.constructor.totalChampionshipPoints %>
                                </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.total_points') %> </span>
                            </span>
                            <span class="col-span-4 flex flex-col">
                                <span>
                                    <%= teamFront.constructor.totalFastestLaps %>
                                </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.total_fastest_laps') %> </span>
                            </span>
                        </span>

                        <span class="grid grid-cols-12 mt-4">
                            <span class="col-span-4 flex flex-col">
                                <span> <%= teamFront.constructor.totalRaceStarts > 0 ? (teamFront.constructor.totalRaceWins / teamFront.constructor.totalRaceStarts * 100).toFixed(1) : 0 %>% </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.victory_ratio') %> </span>
                            </span>
                            <span class="col-span-4 flex flex-col">
                                <span> <%= teamFront.constructor.totalRaceStarts > 0 ? (teamFront.constructor.totalPodiumRaces / teamFront.constructor.totalRaceStarts * 100).toFixed(1) : 0 %>% </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.podium_ratio') %> </span>
                            </span>
                            <span class="col-span-4 flex flex-col">
                                <span> <%= teamFront.constructor.totalRaceStarts > 0 ? (teamFront.constructor.totalPolePositions / teamFront.constructor.totalRaceStarts * 100).toFixed(1) : 0 %>% </span>
                                <span class="text-t-s-<%= theme %> text-xs"> <%= __('constructor.pole_ratio') %> </span>
                            </span>
                        </span>

                        <% if (teamFront.currentSeason) { %>
                        <div class="my-4">
                            <h3 class="font-bold"><%= __('constructor.drivers') %> :</h3>
                            <% teamFront.currentSeason.drivers.forEach(function(driver){ %>
                            <div class="flex items-center justify-center">
                                <img src="/img/countryFlags/<%= driver.nationality %>.svg" alt="<%= driver.nationality %>" class="w-5 h-auto mr-2" />
                                <a href="/driver/<%= driver.id %>">
                                    <p>
                                        <%= driver.firstName %>
                                        <%= driver.lastName %>
                                        -
                                        <% if (driver.permanentNumber==33) { %>
                                        <%= 1 %>
                                        <% } else { %>
                                        <%= driver.permanentNumber %>
                                        <% } %>
                                    </p>
                                </a>
                            </div>
                            <% }) %>
                        </div>
                        <div class="text-center mt-4">
                            <h3 class="text-base sm:text-lg font-bold"><%= __('constructor.single_seater') %>:</h3>
                            <a href="/chassis/<%= teamFront.currentSeason.chassis.id %>">
                                <p class="text-t-s-<%= theme %> mt-2"><%= teamFront.currentSeason.chassis.name %></p>
                                <span class="flex justify-center mt-2">
                                    <img src="https://pitlaneinsider-data.alwaysdata.net/cars_img/<%= teamFront.currentSeason.chassis.id %>.webp" alt="<%= teamFront.currentSeason.chassis.name %>" class="w-2/3 h-auto" />
                                </span>
                            </a>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>
</html>
