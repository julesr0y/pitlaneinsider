<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>" class="bg-b-<%= theme %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <title>PLI - <%= __('constructors.tab_title') %></title>
    </head>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %>">
        <main>
            <div class="text-3xl font-bold text-center my-8 mb-4 w-full pt-4 lg:pt-8 lg:text-3xl lg:font-bold lg:my-8"><%= __('global.current_year') %> <%= __('constructors.season') %></div>
            <div class="w-9/10 mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 pt-10">
                <% teamsFront.forEach(function(team) { %>
                <div class="bg-s-<%= theme %> rounded-lg shadow-lg overflow-hidden transform transition duration-300 hover:scale-105 p-4 m-2">
                    <a href="/constructor/<%= team.id %>" class="block text-center relative">
                        <div class="relative mb-4">
                            <img src="/img/constructors/<%= team.id %>.webp" alt="<%= team.id %>" class="w-full h-40 object-contain" />
                        </div>
                        <div>
                            <span class="font-bold text-2xl"> <%= team.name %> </span>
                        </div>
                    </a>
                </div>
                <% }); %>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>
</html>
