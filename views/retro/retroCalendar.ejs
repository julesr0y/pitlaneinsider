<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
            <meta charset="UTF-8">
            <title>PLI - <%= __('retro_f1.all_seasons.calendar.tab_title') %>
            </title>

            <style>
                :root {
                    --primary-color: #3498db;
                    /* Bleu */
                    --primary-color-rgb: 52, 152, 219;
                    --second-color: #058785;
                    /* Vert pour le fond du sélecteur et du tableau */
                    --second-color-dark: #024644;
                    /* Vert foncé pour le survol */
                    --gray-400: #ccc;
                    --gray-500: #b3b3b3;
                    --text-color: #333;
                    /* Gris foncé pour le texte */
                    --white-color: #fff;
                    /* Blanc pour le texte sur les fonds colorés */
                }

                .custom-select {
                    background-color: var(--second-color);
                    border: 2px solid var(--gray-400);
                    border-radius: 9999px;
                    /* rounded-full */
                    padding: 0.5rem 1rem;
                    /* p-2 */
                    font-size: 1.25rem;
                    /* text-xl */
                    width: 100%;
                    /* w-full */
                    appearance: none;
                    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
                    color: var(--white-color);
                    /* Texte blanc */
                }

                .custom-select:hover {
                    background-color: var(--second-color-dark);
                    border-color: var(--gray-500);
                    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
                }

                .custom-select:focus {
                    outline: none;
                    border-color: var(--primary-color);
                    box-shadow: 0 0 0 3px rgba(var(--primary-color-rgb), 0.3);
                }

                .custom-select option {
                    background-color: var(--white-color);
                    /* Fond blanc pour les options */
                    color: var(--text-color);
                    /* Texte gris foncé */
                }

                /* Add a custom arrow */
                .custom-select-container {
                    position: relative;
                    display: inline-block;
                    width: 100%;
                }

                .custom-select-container::after {
                    content: '▼';
                    position: absolute;
                    top: 50%;
                    right: 1rem;
                    transform: translateY(-50%);
                    pointer-events: none;
                    font-size: 1rem;
                    color: var(--white-color);
                    /* Couleur blanche pour la flèche */
                }
            </style>
</head>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <div class="text-3xl font-bold text-center my-8 mb-4 w-full pt-4 lg:pt-8 lg:text-3xl lg:font-bold lg:my-8">
        <%= __('retro_f1.all_seasons.calendar.title') %>
    </div>
    <div class="app-container">
        <div class="season-title text-3xl font-bold text-center my-8">
            <div class="mx-4">
                <div class="custom-select-container">
                    <select id="seasonSelect" class="custom-select" onchange="changeSeason(this)">
                        <% for (let year=2023; year>= 1950; year--) { %>
                            <option value="<%= year %>" <% if (year==selectedYear) { %>selected<% } %>><%=
                                        __('retro_f1.all_seasons.season') %>
                                        <%= year %>
                            </option>
                            <% } %>
                    </select>
                </div>
                <script>
                    function changeSeason(select) {
                        var selectedYear = select.value;
                        window.location.href = '/retrocalendar/' + selectedYear;
                    }
                </script>
            </div>
        </div>
        <div class="tabs flex justify-center">
            <div class="flex justify-center items-start pt-10">
                <div class="flex mb-4">
                    <a id="classementLink" href="/retrostandings/<%= selectedYear %>"
                        class="mr-20 {{ Request::path() == 'retrodrivers' ? 'font-bold' : '' }}">
                        <%= __('retro_f1.all_seasons.link_standings') %>
                    </a>
                    <a id="calendrierLink" href="/retrocalendar/<%= selectedYear %>"
                        class="{{ Request::path() == 'retrotracks' ? 'font-bold border-b-2 border-<%= theme %>' : '' }}">
                        <%= __('retro_f1.all_seasons.link_calendar') %>
                    </a>
                </div>
            </div>
        </div>

        <!-- Affichage des courses pour la saison sélectionnée -->
        <div class="grid md:grid-cols-2 gap-4 justify-center">
            <% retro_calendrier.forEach(course=> { %>
                <% if (course.year==selectedYear) { %>
                    <a href="/retrogpdetails/<%= selectedYear %>/<%= String(course.raceId) %>"
                        data-round="<%= course.round %>"
                        class="gp-detail-link bg-s-<%= theme %> p-4 sm:p-8 shadow-md rounded-2xl mt-8 focus:outline-none focus:ring-2 focus:ring-gray-500">
                        <div class="flex flex-col items-center w-full">
                            <img src="/img/countryFlags/<%= course.country %>.svg" alt="<%= course.country %>"
                                class="h-56 w-auto my-auto rounded-xl">
                            <ul class="text-t-s-<%= theme %>">
                                <li class="text-xl text-center">
                                    <%= course.name %>
                                </li>
                                <li class="text-xl text-center">
                                    <%= course.date %>
                                </li>
                            </ul>
                        </div>
                    </a>
                    <% } %>
                        <% }); %>
        </div>

    </div>
    <%- include('../partials/footer.ejs') %>
</body>

</html>