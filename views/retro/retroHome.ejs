<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>" class="bg-b-<%= theme %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>PLI - <%= __('retro_f1.home.tab_title') %></title>
    </head>

    <style>
        .gold {
            background-color: gold;
        }

        .silver {
            background-color: silver;
        }

        .bronze {
            background-color: #cd7f32;
        }
    </style>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %>">
        <main>
            <div class="text-3xl font-bold text-center my-8 mb-4 w-full pt-4 lg:pt-8 lg:text-3xl lg:font-bold lg:my-8"><%= __('retro_f1.home.title') %></div>

            <div>
                <div class="flex flex-col md:flex-row justify-center items-start mt-4 space-y-4 md:space-y-0 md:space-x-4 px-4">
                    <a href="retrostandings" class="bg-s-<%= theme %> w-full md:w-1/2 lg:w-1/3 rounded-3xl pt-4 grow">
                        <h2 class="text-center font-bold mb-4"><%= __('retro_f1.home.all_seasons') %></h2>
                        <div class="flex flex-col justify-center items-center">
                            <img src="/img/assets/list-<%= theme %>.svg" alt="pli-logo" class="h-40 w-auto" />
                        </div>
                    </a>

                    <a href="retrodrivers" class="bg-s-<%= theme %> w-full md:w-1/2 lg:w-1/3 rounded-3xl pt-4 grow">
                        <h2 class="text-center font-bold mb-4"><%= __('retro_f1.home.all_data') %></h2>
                        <div class="flex flex-col justify-center items-center">
                            <img src="/img/assets/pli-logo-<%= theme %>.png" alt="pli-logo" class="h-40 w-auto" />
                        </div>
                    </a>
                </div>
            </div>

            <div>
                <div class="flex flex-col md:flex-row justify-center items-stretch mt-4 space-y-4 md:space-y-0 md:space-x-4 px-4">
                    <a href="retrodriverwinners" class="bg-s-<%= theme %> w-full md:w-1/2 rounded-3xl p-6 flex flex-col justify-between group transition duration-300 hover:shadow-xl">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <h2 class="text-lg md:text-xl font-bold"><%= __('retro_f1.home.winners_title') %></h2>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-60 group-hover:opacity-100 group-hover:translate-x-1 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </div>
                            <div class="space-y-3">
                                <% [0, 1, 2].forEach(index=> { %>
                                <% const driver=retroHome[index]; %>
                                <% if (driver) { %>
                                <% const isFirstTie=index===1 &&
                                            driver.totalChampionshipWins===retroHome[0].totalChampionshipWins; %>
                                <div class="flex items-center justify-between p-3 rounded-2xl bg-gray-500/10 transition group-hover:bg-gray-500/15">
                                    <div class="flex items-center space-x-3">
                                        <span class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shadow-xs flex-shrink-0 <%= index === 0 || isFirstTie ? 'gold text-black' : index === 1 ? 'silver text-black' : 'bronze text-white' %>"> <%= isFirstTie ? '1' : index + 1 %> </span>
                                        <img alt="<%= driver.name %>" src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= driver.id %>.webp" class="h-12 w-12 object-cover rounded-full flex-shrink-0 border border-gray-400/20" />
                                        <div>
                                            <div class="font-bold text-sm md:text-base leading-tight"><%= driver.name %></div>
                                        </div>
                                    </div>
                                    <div class="text-right font-black text-lg md:text-xl opacity-90 pl-2"><%= driver.totalChampionshipWins %> <%= __('retro_f1.home.driver_titles') %></div>
                                </div>
                                <% } %>
                                <% }); %>
                            </div>
                        </div>
                    </a>

                    <a href="retroconstructorwinners" class="bg-s-<%= theme %> w-full md:w-1/2 rounded-3xl p-6 flex flex-col justify-between group transition duration-300 hover:shadow-xl">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <h2 class="text-lg md:text-xl font-bold"><%= __('retro_f1.home.winners_constructors_title') %></h2>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-60 group-hover:opacity-100 group-hover:translate-x-1 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </div>
                            <div class="space-y-3">
                                <% [0, 1, 2].forEach(index=> { %>
                                <% const constructor=constructorWinners[index]; %>
                                <% if (constructor) { %>
                                <div class="flex items-center justify-between p-3 rounded-2xl bg-gray-500/10 transition group-hover:bg-gray-500/15">
                                    <div class="flex items-center space-x-3">
                                        <span class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shadow-xs flex-shrink-0 <%= index === 0 ? 'gold text-black' : index === 1 ? 'silver text-black' : 'bronze text-white' %>"> <%= index + 1 %> </span>
                                        <div class="w-12 h-12 flex items-center justify-center flex-shrink-0">
                                            <img alt="<%= constructor.name %>" src="/img/constructors/<%= constructor.id %>.webp" class="max-h-8 max-w-12 object-contain" />
                                        </div>
                                        <div>
                                            <div class="font-bold text-sm md:text-base leading-tight"><%= constructor.name %></div>
                                        </div>
                                    </div>
                                    <div class="text-right font-black text-lg md:text-xl opacity-90 pl-2"><%= constructor.totalChampionshipWins %> <%= __('retro_f1.home.driver_titles') %></div>
                                </div>
                                <% } %>
                                <% }); %>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="mt-8 px-4">
                <div class="bg-s-<%= theme %> w-full mx-auto rounded-3xl p-6 lg:p-8">
                    <h2 class="text-center text-xl lg:text-2xl font-bold mb-2"><%= __('retro_f1.home.wall_of_winners_title') %></h2>
                    <p class="text-center text-sm opacity-75 mb-6"><%= __('retro_f1.home.wall_of_winners_subtitle') %></p>

                    <div class="space-y-4">
                        <% Object.keys(wallOfWinners).forEach(decade=> { %>
                        <div class="flex flex-col sm:flex-row sm:items-center space-y-2 sm:space-y-0 sm:space-x-4 border-b border-gray-500/20 pb-4 last:border-b-0 last:pb-0">
                            <div class="w-16 flex-shrink-0 font-bold text-base md:text-lg"><%= decade %>s</div>
                            <div class="flex flex-wrap gap-1.5 flex-1 items-center">
                                <% wallOfWinners[decade].forEach(race=> { %>
                                <a href="/retrogpdetails/<%= race.year %>/<%= race.id %>" title="<%= race.year %> <%= race.gpName %> - <%= race.driverName %> (<%= race.constructorName %>)" class="bg-<%= race.constructorId %> w-5 h-5 md:w-6 md:h-6 rounded-xs transition-transform transform hover:scale-125 hover:z-10 relative block cursor-pointer flex-shrink-0"> </a>
                                <% }); %>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>
</html>
