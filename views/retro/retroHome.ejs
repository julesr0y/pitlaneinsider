<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>" class="bg-b-<%= theme %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>PLI - <%= __('retro_f1.home.tab_title') %></title>
    </head>

    <style>
        .gold {
            background-color: gold;
        }

        .silver {
            background-color: silver;
        }

        .bronze {
            background-color: #cd7f32;
        }
    </style>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %>">
        <main>
            <div class="text-3xl font-bold text-center my-8 mb-4 w-full pt-4 lg:pt-8 lg:text-3xl lg:font-bold lg:my-8"><%= __('retro_f1.home.title') %></div>

            <div>
                <div class="flex flex-col md:flex-row justify-center items-start mt-4 space-y-4 md:space-y-0 md:space-x-4 px-4">
                    <a href="retrostandings" class="bg-s-<%= theme %> w-full md:w-1/2 lg:w-1/3 rounded-3xl pt-4 grow">
                        <h2 class="text-center font-bold mb-4"><%= __('retro_f1.home.all_seasons') %></h2>
                        <div class="flex flex-col justify-center items-center">
                            <img src="/img/assets/list-<%= theme %>.svg" alt="pli-logo" class="h-40 w-auto" />
                        </div>
                    </a>

                    <a href="retrodrivers" class="bg-s-<%= theme %> w-full md:w-1/2 lg:w-1/3 rounded-3xl pt-4 grow">
                        <h2 class="text-center font-bold mb-4"><%= __('retro_f1.home.all_data') %></h2>
                        <div class="flex flex-col justify-center items-center">
                            <img src="/img/assets/pli-logo-<%= theme %>.png" alt="pli-logo" class="h-40 w-auto" />
                        </div>
                    </a>
                </div>
            </div>

            <div>
                <div class="flex flex-col md:flex-row justify-center items-stretch mt-4 space-y-4 md:space-y-0 md:space-x-4 px-4">
                    <a href="retrodriverwinners" class="bg-s-<%= theme %> w-full md:w-1/2 lg:w-1/3 rounded-3xl pt-4 grow flex flex-col justify-between">
                        <span class="flex justify-center text-center mb-4 font-bold">
                            <h2 class="text-center font-bold mt-4"><%= __('retro_f1.home.winners_title') %></h2>
                        </span>
                        <div class="flex justify-evenly items-end grow">
                            <div class="flex flex-col items-center">
                                <img alt="F1 Image" src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= retroHome[1].id %>.webp" class="h-20 w-auto" />
                                <div class="w-24 h-32 gold rounded-t-lg flex flex-col items-center justify-center">
                                    <span class="text-lg font-bold">1</span>
                                    <span class="text-sm font-bold mt-2"> <%= retroHome[1].abbreviation %> </span>
                                    <span>
                                        <%= retroHome[1].totalChampionshipWins %>
                                        <%= __('retro_f1.home.driver_titles') %>
                                    </span>
                                </div>
                            </div>
                            <div class="flex flex-col items-center">
                                <img alt="F1 Image" src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= retroHome[0].id %>.webp" class="h-20 w-auto" />
                                <div class="w-24 h-32 gold rounded-t-lg flex flex-col items-center justify-center">
                                    <span class="text-lg font-bold">1</span>
                                    <span class="text-sm font-bold mt-2"> <%= retroHome[0].abbreviation %> </span>
                                    <span>
                                        <%= retroHome[0].totalChampionshipWins %>
                                        <%= __('retro_f1.home.driver_titles') %>
                                    </span>
                                </div>
                            </div>
                            <div class="flex flex-col items-center">
                                <img alt="F1 Image" src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= retroHome[2].id %>.webp" class="h-20 w-auto" />
                                <div class="w-24 h-20 bronze rounded-t-lg flex flex-col items-center justify-center">
                                    <span class="text-lg font-bold">3</span>
                                    <span class="text-sm font-bold mt-2"> <%= retroHome[2].abbreviation %> </span>
                                    <span>
                                        <%= retroHome[2].totalChampionshipWins %>
                                        <%= __('retro_f1.home.driver_titles') %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </a>

                    <a href="retroconstructorwinners" class="bg-s-<%= theme %> w-full md:w-1/2 lg:w-1/3 rounded-3xl pt-4 grow flex flex-col justify-between">
                        <span class="flex justify-center text-center mb-4 font-bold">
                            <h2 class="text-center font-bold mt-4"><%= __('retro_f1.home.winners_constructors_title') %></h2>
                        </span>
                        <div class="flex justify-evenly items-end grow">
                            <div class="flex flex-col items-center gap-y-2">
                                <img alt="F1 Image" src="/img/constructors/<%= constructorWinners[1].id %>.webp" class="h-12 w-auto" />
                                <div class="w-24 h-24 silver rounded-t-lg flex flex-col items-center justify-center">
                                    <span class="text-lg font-bold">2</span>
                                    <span class="text-sm font-bold mt-2"> <%= constructorWinners[1].name %> </span>
                                    <span>
                                        <%= constructorWinners[1].totalChampionshipWins %>
                                        <%= __('retro_f1.home.driver_titles') %>
                                    </span>
                                </div>
                            </div>
                            <div class="flex flex-col items-center gap-y-2">
                                <img alt="F1 Image" src="/img/constructors/<%= constructorWinners[0].id %>.webp" class="h-12 w-auto" />
                                <div class="w-24 h-32 gold rounded-t-lg flex flex-col items-center justify-center">
                                    <span class="text-lg font-bold">1</span>
                                    <span class="text-sm font-bold mt-2"> <%= constructorWinners[0].name %> </span>
                                    <span>
                                        <%= constructorWinners[0].totalChampionshipWins %>
                                        <%= __('retro_f1.home.driver_titles') %>
                                    </span>
                                </div>
                            </div>
                            <div class="flex flex-col items-center gap-y-2">
                                <img alt="F1 Image" src="/img/constructors/<%= constructorWinners[2].id %>.webp" class="h-12 w-auto" />
                                <div class="w-24 h-20 bronze rounded-t-lg flex flex-col items-center justify-center">
                                    <span class="text-lg font-bold">3</span>
                                    <span class="text-sm font-bold mt-2"> <%= constructorWinners[2].name %> </span>
                                    <span>
                                        <%= constructorWinners[2].totalChampionshipWins %>
                                        <%= __('retro_f1.home.driver_titles') %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="mt-8 px-4">
                <div class="bg-s-<%= theme %> w-full mx-auto rounded-3xl p-6 lg:p-8">
                    <h2 class="text-center text-xl lg:text-2xl font-bold mb-2"><%= __('retro_f1.home.wall_of_winners_title') %></h2>
                    <p class="text-center text-sm opacity-75 mb-6"><%= __('retro_f1.home.wall_of_winners_subtitle') %></p>

                    <div class="space-y-4">
                        <% Object.keys(wallOfWinners).forEach(decade=> { %>
                        <div class="flex flex-col sm:flex-row sm:items-center space-y-2 sm:space-y-0 sm:space-x-4 border-b border-gray-500/20 pb-4 last:border-b-0 last:pb-0">
                            <div class="w-16 flex-shrink-0 font-bold text-base md:text-lg"><%= decade %>s</div>
                            <div class="flex flex-wrap gap-1.5 flex-1 items-center">
                                <% wallOfWinners[decade].forEach(race=> { %>
                                <a href="/retrogpdetails/<%= race.year %>/<%= race.id %>" title="<%= race.year %> <%= race.gpName %> - <%= race.driverName %> (<%= race.constructorName %>)" class="bg-<%= race.constructorId %> w-5 h-5 md:w-6 md:h-6 rounded-xs transition-transform transform hover:scale-125 hover:z-10 relative block cursor-pointer flex-shrink-0"> </a>
                                <% }); %>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>
</html>
