<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>" class="bg-b-<%= theme %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <meta charset="UTF-8" />
        <title>PLI - <%= __('retro_f1.all_seasons.standings.tab_title') %></title>
        <link href="" rel="stylesheet" />

        <style>
            :root {
                --primary-color: #3498db;
                --primary-color-rgb: 52, 152, 219;
                --second-color: #058785;
                --second-color-dark: #024644;
                --gray-400: #ccc;
                --gray-500: #b3b3b3;
                --text-color: #333;
                --white-color: #fff;
            }

            .glass-card {
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(10px);
                -webkit-backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.2);
                box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.15);
                transition:
                    transform 0.3s ease,
                    box-shadow 0.3s ease;
            }
            .glass-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.25);
            }

            /* Dark mode adjustments for glassmorphism */
            .bg-b-dark .glass-card {
                background: rgba(0, 0, 0, 0.2);
                border: 1px solid rgba(255, 255, 255, 0.05);
            }

            .season-nav-btn {
                background-color: var(--second-color);
                color: var(--white-color);
                transition: background-color 0.3s ease;
            }
            .season-nav-btn:hover {
                background-color: var(--second-color-dark);
            }

            .table-row-hover:hover {
                background-color: #058785;
            }
            .bg-b-dark .table-row-hover:hover {
                background-color: #058785;
            }

            /* Modal styles */
            #yearModal {
                background-color: rgba(0, 0, 0, 0.6);
                backdrop-filter: blur(5px);
            }
        </style>
    </head>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %>">
        <main>
            <div class="text-3xl font-bold text-center my-8 mb-4 w-full pt-4 lg:pt-8 lg:text-3xl lg:font-bold lg:my-8"><%= __('retro_f1.all_seasons.standings.title') %></div>
            <div class="app-container flex flex-col items-center">
                <div class="flex justify-center items-center space-x-6">
                    <% const currentY = parseInt(selectedYear); const prevY = currentY > 1950 ? currentY - 1 : 1950; const nextY = currentY < currentYear-1 ? currentY + 1 : currentYear-1; %>
                    <a href="/retrostandings/<%= prevY %>" class="season-nav-btn rounded-full p-2 <%= currentY <= 1950 ? 'opacity-50 cursor-not-allowed pointer-events-none' : '' %>">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                    </a>

                    <p class="text-xl lg:text-3xl font-bold cursor-pointer hover:text-<%= theme === 'dark' ? 'gray-300' : 'gray-600' %> transition" onclick="document.getElementById('yearModal').classList.remove('hidden')"><%= currentY %></p>

                    <a href="/retrostandings/<%= nextY %>" class="season-nav-btn rounded-full p-2 <%= currentY >= currentYear-1 ? 'opacity-50 cursor-not-allowed pointer-events-none' : '' %>">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                </div>
                <button onclick="document.getElementById('yearModal').classList.remove('hidden')" class="mt-3 text-center text-sm underline text-gray-500 hover:text-gray-700"><%= __('retro_f1.all_seasons.standings.change_year') %></button>
            </div>

            <!-- Modal Choix de l'année -->
            <div id="yearModal" class="fixed inset-0 z-50 hidden flex justify-center items-center p-4">
                <div class="bg-s-<%= theme %> rounded-3xl p-6 lg:p-8 max-w-4xl w-full max-h-[60vh] overflow-y-auto relative shadow-2xl border border-gray-200 dark:border-gray-700">
                    <button onclick="document.getElementById('yearModal').classList.add('hidden')" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800 dark:hover:text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                    <h2 class="text-2xl font-bold mb-6 text-center"><%= __('retro_f1.all_seasons.standings.select_season') %></h2>

                    <% 
                        const decades = [1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020];
                    %>
                    <div class="space-y-6">
                        <% decades.forEach(decade => { %>
                        <div>
                            <h3 class="text-xl font-bold mb-3 border-b pb-1 border-gray-300 dark:border-gray-600"><%= decade %>s</h3>
                            <div class="grid grid-cols-5 md:grid-cols-10 gap-2">
                                <% for(let y = decade; y < decade + 10 && y <= currentYear-1; y++) { %>
                                <a href="/retrostandings/<%= y %>" class="py-2 text-center rounded-lg hover:text-main-color hover:bg-white transition <%= currentY === y ? 'bg-white text-main-color font-bold' : 'bg-main-color text-white' %>"> <%= y %> </a>
                                <% } %>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <div class="app-container">
                <div class="tabs flex justify-center">
                    <div class="flex justify-center items-start pt-10">
                        <div class="flex mb-4">
                            <a id="classementLink" href="/retrostandings/<%= selectedYear %>" class="mr-20 {{ Request::path() == 'retrodrivers' ? 'font-bold border-b-2 border-<%= theme %>' : '' }}"> <%= __('retro_f1.all_seasons.link_standings') %> </a>
                            <a id="calendrierLink" href="/retrocalendar/<%= selectedYear %>" class="{{ Request::path() == 'retrocalendar' ? 'font-bold' : '' }}"> <%= __('retro_f1.all_seasons.link_calendar') %> </a>
                        </div>
                    </div>
                </div>

                <div class="tabs flex justify-center">
                    <div class="tab">
                        <button id="btnDrivers" class="tablink active mr-4 underline" onclick="openTab('drivers')"><%= __('retro_f1.all_seasons.standings.drivers') %></button>
                        <button id="btnConstructors" class="tablink" onclick="openTab('constructors')"><%= __('retro_f1.all_seasons.standings.constructors') %></button>
                    </div>
                </div>

                <div id="drivers" class="bg-s-<%= theme %> p-4 mt-8 rounded-3xl mx-auto max-w-sm sm:max-w-xl h-2/3">
                    <table>
                        <tr id="header-classement-pilotes">
                            <td></td>
                            <td class="font-bold"><%= __('retro_f1.all_seasons.standings.position') %></td>
                            <td class="font-bold pl-3"><%= __('retro_f1.all_seasons.standings.drivers') %></td>
                            <td class="font-bold pl-3"><%= __('retro_f1.all_seasons.standings.points') %></td>
                        </tr>
                        <% retroDriversStandings.forEach(function(pilot) { %>
                        <tr>
                            <td class="pr-2">
                                <div class="h-6 w-1 rounded-3xl overflow-hidden flex flex-col box-border">
                                    <% if (pilot.constructorIds && pilot.constructorIds.length > 0) { pilot.constructorIds.forEach(id => { %>
                                    <div class="flex-1 bg-<%= id %> border border-<%= id %>"></div>
                                    <% });
                                    } %>
                                </div>
                            </td>
                            <td class="font-bold pr-3"><%= String(pilot.positionNumber).padStart(2, '0' ) %></td>
                            <td class="border-l-2 pl-3 pr-3">
                                <a href="/driver/<%= pilot.driverId %>"> <%= pilot.driver.firstName %> <%= pilot.driver.lastName %> </a>
                            </td>
                            <td class="border-l-2 pl-3"><%= pilot.points %></td>
                        </tr>
                        <% }); %>
                    </table>
                </div>

                <div id="constructors" class="bg-s-<%= theme %> p-4 mt-8 rounded-3xl mx-auto max-w-sm sm:max-w-xl h-2/3 hidden">
                    <table>
                        <tr>
                            <td></td>
                            <td class="font-bold"><%= __('retro_f1.all_seasons.standings.position') %></td>
                            <td class="pl-3 font-bold"><%= __('retro_f1.all_seasons.standings.constructors') %></td>
                            <td class="pl-3 font-bold"><%= __('retro_f1.all_seasons.standings.points') %></td>
                        </tr>
                        <% retroConstructorsStandings.forEach(function(constructor) { %>
                        <tr>
                            <td class="pr-2">
                                <span class="border-2 border-<%= constructor.constructorId %> h-auto w-1 box-border bg-<%= constructor.constructorId %> rounded-3xl"> </span>
                            </td>
                            <td class="pr-3 font-bold"><%= String(constructor.positionNumber).padStart(2, '0' ) %></td>
                            <td class="border-l-2 pl-3 pr-3">
                                <a href="/constructor/<%= constructor.constructorId %>"> <%= constructor.constructor.name %> </a>
                            </td>
                            <td class="border-l-2 pl-3"><%= constructor.points %></td>
                        </tr>
                        <% }); %>
                    </table>
                </div>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>
    <script>
        const pathParts = window.location.pathname.split('/');
        const selectedYear = pathParts[pathParts.length - 1];

        if (selectedYear) {
            const options = document.querySelectorAll('#seasonSelect option');
            options.forEach((option) => {
                if (option.value === selectedYear) {
                    option.selected = true;
                }
            });
        }
    </script>
    <script>
        function openTab(tabName) {
            if (tabName === 'drivers') {
                document.getElementById('drivers').classList.remove('hidden');
                document.getElementById('constructors').classList.add('hidden');
                document.getElementById('btnDrivers').classList.add('active');
                document.getElementById('btnDrivers').classList.add('underline');
                document.getElementById('btnConstructors').classList.remove('active');
                document.getElementById('btnConstructors').classList.remove('underline');
            } else if (tabName === 'constructors') {
                document.getElementById('constructors').classList.remove('hidden');
                document.getElementById('drivers').classList.add('hidden');
                document.getElementById('btnConstructors').classList.add('active');
                document.getElementById('btnConstructors').classList.add('underline');
                document.getElementById('btnDrivers').classList.remove('active');
                document.getElementById('btnDrivers').classList.remove('underline');
            }
        }
    </script>
</html>
