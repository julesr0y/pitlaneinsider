                                <div class="w-6/12">
                                    <span class="flex justify-center">
                                        <a href="/circuit/<%= gpDetails.gpInfos[0].circuitId %>">
                                            <img src="/img/circuits/<%= gpDetails.gpInfos[0].circuitId %>.svg" alt="<%= gpDetails.gpInfos[0].circuitId %>" class="h-44 w-auto" />
                                        </a>
                                    </span>
                                </div>
                                <div class="flex flex-col items-center w-6/12 text-sm gap-y-2">
                                    <span>
                                        <%= gpDetails.gpInfos[0].date %>
