                                    <td class="pr-3"><%= detail.q2time %></td>
                                    <td class="pl-3 border-l-2"></td>
                                    <td>
                                        <%= detail.q3time %>
                                    </td>
                                </tr>
                                <% } %>
                                <% }); %>
                            </table>

                            <% } else { %>

                            <% if(gpDetails.gpInfos[0].date.split("-")[0] >= 1988) { %>
