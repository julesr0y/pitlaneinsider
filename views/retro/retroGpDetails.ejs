<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <meta charset="UTF-8" />
        <title>PLI - <%= __('retro_f1.all_seasons.gp_details.tab_title') %> <%= gpDetails.gpInfos.id %></title>
        <link href="" rel="stylesheet" />
    </head>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %>">
        <main>
            <div class="app-container">
                <div class="text-center my-4 font-regular bg-s-<%= theme %> p-4 shadow-md rounded-2xl mx-4 w-11/12 md:hidden">
                    <div class="flex flex-col items-center gap-2">
                        <span class="text-xl font-bold"> <%= __('retro_f1.all_seasons.gp_details.title') %> <%= gpDetails.gpInfos.id %> </span>
                        <span class="flex flex-col">
                            <%= gpDetails.gpInfos.officialName %>
                            <img src="/img/countryFlags/<%= gpDetails.gpInfos.circuit.countryId %>.svg" alt="<%= gpDetails.gpInfos.circuit.countryId %>" class="h-6 w-auto" />
                        </span>
                    </div>
                    <div class="flex items-center mt-2">
                        <div class="w-6/12">
                            <span>
                                <a href="/circuit/<%= gpDetails.gpInfos.circuitId %>">
                                    <img src="/img/circuits/<%= gpDetails.gpInfos.circuitId %>.svg" alt="<%= gpDetails.gpInfos.circuitId %>" />
                                </a>
                            </span>
                        </div>
                        <div class="flex flex-col items-center w-6/12 text-sm gap-y-2">
                            <span>
                                <%= gpDetails.gpInfos.date %>
                            </span>
                            <span>
                                <%= (gpDetails.gpInfos.grandPrix.fullName || gpDetails.gpInfos.officialName) %>
                            </span>
                            <span>
                                <%= gpDetails.gpInfos.circuit.name %>
                            </span>
                        </div>
                    </div>
                </div>
                <style>
                    /* Hide scrollbar for Chrome, Safari and Opera */
                    .no-scrollbar::-webkit-scrollbar {
                        display: none;
                    }

                    /* Hide scrollbar for IE, Edge and Firefox */
                    .no-scrollbar {
                        -ms-overflow-style: none;
                        /* IE and Edge */
                        scrollbar-width: none;
                        /* Firefox */
                    }
                </style>
                <div class="flex flex-col md:flex-row gap-y-4 md:gap-y-0 mt-4">
                    <div id="GPDetails" class="bg-s-<%= theme %> p-4 shadow-md rounded-2xl mx-4 w-11/12 md:w-9/12">
                        <div id="toggleTable" class="flex items-center justify-center w-full">
                            <span id="prevButton" class="grow-0">
                                <img src="/img/assets/arrow-left.png" alt="left-arrow" class="h-4 w-auto hover:cursor-pointer" />
                            </span>
                            <span id="tableTitle" class="grow-1 text-center">Race</span>
                            <span id="nextButton" class="grow-0-0">
                                <img src="/img/assets/arrow-right.png" alt="right-arrow" class="h-4 w-auto hover:cursor-pointer" />
                            </span>
                        </div>
                        <div id="tables" class="overflow-x-scroll whitespace-nowrap no-scrollbar pt-2 w-full">
                            <table id="tableRace" data-title="Race">
                                <tr>
                                    <td></td>
                                    <td class="font-bold"><%= __('retro_f1.all_seasons.gp_details.position') %></td>
                                    <td></td>
                                    <td class="font-bold"><%= __('retro_f1.all_seasons.gp_details.drivers') %></td>
                                    <td></td>
                                    <td class="font-bold"><%= __('retro_f1.all_seasons.gp_details.gap') %></td>
                                </tr>

                                <% gpDetails.raceData.sort((a, b) => (a.race ? a.race.positionDisplayOrder : 999) - (b.race ? b.race.positionDisplayOrder : 999)); %> <% gpDetails.raceData.forEach(detail=> { const constructorId = detail.race?.constructorId || detail.fp1?.constructorId || detail.fp2?.constructorId || detail.fp3?.constructorId || detail.quali?.constructorId || detail.sprintQuali?.constructorId || detail.sprintRace?.constructorId || 'unknown'; %>
                                <% if (detail.race) { %>
                                <% if (detail.race?.gap=="DNQ" || detail.race?.gap=="DNS" || detail.race?.gap=="DNF" || detail.race?.gap=="DSQ" || detail.race?.gap=="NC" ) { %>
                                <tr class="text-hasnt-finished-race">
                                    <% } else { %>
                                </tr>

                                <tr>
                                    <% } %>
                                    <td class="pr-2">
                                        <span class="border-2 border-<%= constructorId %> h-auto w-1 box-border bg-<%= constructorId %> rounded-3xl"> </span>
                                    </td>
                                    <td class="font-bold pr-3"><%= detail.race?.positionText ? (isNaN(detail.race?.positionText) ? detail.race?.positionText : String(detail.race?.positionText).padStart(2, '0')) : 'NC' %></td>
                                    <td class="pl-3 border-l-2"></td>
                                    <td class="pr-3">
                                        <a href="/driver/<%= detail.driver.id %>">
                                            <span class="flex gap-x-1">
                                                <span><%= detail.driver.lastName %></span>
                                            </span>
                                        </a>
                                    </td>
                                    <td class="pl-3 border-l-2"></td>
                                    <td>
                                        <%= detail.race?.gap || '+0.000' %>
                                    </td>
                                </tr>
                                <% } %>
                                <% }); %>
                            </table>

