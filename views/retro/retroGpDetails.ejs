                                <% gpDetails.raceData.sort((a, b) => (a.quali ? a.quali.positionDisplayOrder : 999) - (b.quali ? b.quali.positionDisplayOrder : 999)); %> <% gpDetails.raceData.forEach(detail=> { const constructorId = detail.race?.constructorId || detail.fp1?.constructorId || detail.fp2?.constructorId || detail.fp3?.constructorId || detail.quali?.constructorId || detail.sprintQuali?.constructorId || detail.sprintRace?.constructorId || 'unknown'; %>
                                <% if (detail.quali) { %>
                                <tr>
                                    <td class="pr-2">
                                        <span class="border-2 border-<%= constructorId %> h-auto w-1 box-border bg-<%= constructorId %> rounded-3xl"> </span>
                                    </td>
                                    <td class="font-bold pr-3"><%= detail.quali?.positionText ? (isNaN(detail.quali?.positionText) ? detail.quali?.positionText : String(detail.quali?.positionText).padStart(2, '0')) : 'NC' %></td>
                                    <td class="pl-3 border-l-2"></td>
                                    <td class="pr-3">
                                        <a href="/driver/<%= detail.driver.id %>">
                                            <span class="flex gap-x-1">
                                                <span>
                                                    <%= detail.driver.lastName %>
                                                </span>
                                            </span>
                                        </a>
                                    </td>
                                    <td class="pl-3 border-l-2"></td>
                                    <td class="pr-3"><%= detail.quali?.time || '-' %></td>
                                </tr>
                                <% } %>
                                <% }); %>
                            </table>
                            <% } %>
                            <% } %>
                        </div>
                    </div>

                    <div class="w-full gap-4">
                        <div class="text-center mb-8 font-regular bg-s-<%= theme %> p-4 shadow-md rounded-2xl mx-4 hidden md:block">
                            <div class="flex flex-col items-center gap-2">
                                <span class="text-xl font-bold"> <%= __('retro_f1.all_seasons.gp_details.title') %> <%= gpDetails.gpInfos.id %> </span>
                                <span class="flex gap-2">
                                    <%= gpDetails.gpInfos.officialName %>
                                    <img src="/img/countryFlags/<%= gpDetails.gpInfos.circuit.countryId %>.svg" alt="<%= gpDetails.gpInfos.circuit.countryId %>" class="h-6 w-auto" />
                                </span>
                            </div>
                            <div class="flex items-center mt-2">
                                <div class="w-6/12">
                                    <span class="flex justify-center">
                                        <a href="/circuit/<%= gpDetails.gpInfos.circuitId %>">
                                            <img src="/img/circuits/<%= gpDetails.gpInfos.circuitId %>.svg" alt="<%= gpDetails.gpInfos.circuitId %>" class="h-44 w-auto" />
                                        </a>
                                    </span>
                                </div>
                                <div class="flex flex-col items-center w-6/12 text-sm gap-y-2">
                                    <span>
                                        <%= gpDetails.gpInfos.date %>
                                    </span>
                                    <span>
                                        <%= (gpDetails.gpInfos.grandPrix.fullName || gpDetails.gpInfos.officialName) %>
                                    </span>
                                    <span>
                                        <%= gpDetails.gpInfos.circuit.name %>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <span class="grid grid-cols-12 md:flex-col items-center gap-1">
                            <% gpDetails.raceData.forEach(function(grid){ if (grid.quali?.positionNumber==1) { %>
                            <a href="/driver/<%= grid.driver.id %>" class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 flex flex-col justify-end gap-2 items-center px-2 col-span-6">
                                <span>
                                    <%= __('retro_f1.all_seasons.gp_details.poleposition') %>
                                </span>
                                <img src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= grid.driver.id %>.webp" alt="<%= grid.driver.lastName %>" class="h-24 w-auto" />
                            </a>
                            <% } }) %>
                            <% gpDetails.raceData.forEach(function(grid){ if (grid.race?.positionNumber==1) { %>
                            <a href="/driver/<%= grid.driver.id %>" class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 flex flex-col justify-end gap-2 items-center px-2 col-span-6">
                                <span>
                                    <%= __('retro_f1.all_seasons.gp_details.winner') %>
                                </span>
                                <img src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= grid.driver.id %>.webp" alt="<%= grid.driver.lastName %>" class="h-24 w-auto" />
                            </a>
                            <% } }) %>
                        </span>
                        <br />
                        <span class="grid grid-cols-12 md:flex-col items-center gap-1">
                            <div class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 flex flex-col justify-center gap-2 items-center px-2 col-span-6 h-32">
                                <% gpDetails.raceData.forEach(function(lap){ if (lap.fastestLap?.time !=null) { %>
                                <span class="text-center"> <%= __('retro_f1.all_seasons.gp_details.fastestLap') %> </span>
                                <div class="flex flex-col items-center grow justify-center w-full">
                                    <div>
                                        <%= lap.driver.abbreviation %>
                                        - <span class="text-fuchsia-700"> <%= lap.fastestLap?.time %> </span>
                                    </div>
                                </div>
                                <% } }) %>
                            </div>
                            <div class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 flex flex-col justify-center gap-2 items-center px-2 col-span-6 h-32">
                                <% gpDetails.raceData.forEach(function(pit){ if (pit.fastestPit?.time !=null) { %>
                                <span class="text-center"> <%= __('retro_f1.all_seasons.gp_details.fastestPit') %> </span>
                                <div class="flex flex-col items-center grow justify-center w-full"><%= pit.driver.abbreviation %> - <%= pit.fastestPit?.time %></div>
                                <% }}); %>
                            </div>
                        </span>
                    </div>
                </div>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>

    <script>
        let currentIndex = 0;
        const tables = document.querySelectorAll('#tables table');
        const tableTitle = document.querySelector('#tableTitle');

        const sprintQualifyingFormat = '<%= gpDetails.gpInfos.sprintQualifyingFormat %>';
        const qualifyingFormat = '<%= gpDetails.gpInfos.qualifyingFormat %>';

        const date = parseInt('<%= gpDetails.gpInfos.date.split("-")[0] %>');

        function showTable(index) {
            tables.forEach((table, i) => {
                if (i === index) {
                    table.classList.remove('hidden');
                } else {
                    table.classList.add('hidden');
                }
            });
        }

        document.getElementById('prevButton').addEventListener('click', prevTable);
        document.getElementById('nextButton').addEventListener('click', nextTable);

        document.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowLeft') {
                prevTable();
            } else if (event.key === 'ArrowRight') {
                nextTable();
            }
        });

        function prevTable() {
            currentIndex = (currentIndex - 1 + tables.length) % tables.length;
            showTable(currentIndex);
            updateTitle();
        }

        function nextTable() {
            currentIndex = (currentIndex + 1) % tables.length;
            showTable(currentIndex);
            updateTitle();
        }

        function updateTitle() {
            if (sprintQualifyingFormat === 'SPRINT_SHOOTOUT') {
                if (currentIndex === 0) {
                    tableTitle.textContent = 'Race';
                } else if (currentIndex === 1) {
                    tableTitle.textContent = 'FP1';
                } else if (currentIndex === 2) {
                    tableTitle.textContent = 'SQ';
                } else if (currentIndex === 3) {
                    tableTitle.textContent = 'Sprint Race';
                } else if (currentIndex === 4) {
                    tableTitle.textContent = 'Qualifications';
                }
            }

            if (date < 1988) {
                if (currentIndex === 0) {
                    tableTitle.textContent = 'Race';
                } else if (currentIndex === 1) {
                    tableTitle.textContent = 'Qualifications';
                }
            } else if (date > 2003) {
                if (currentIndex === 0) {
                    tableTitle.textContent = 'Race';
                } else if (currentIndex === 1) {
                    tableTitle.textContent = 'FP1';
                } else if (currentIndex === 2) {
                    tableTitle.textContent = 'FP2';
                } else if (currentIndex === 3) {
                    tableTitle.textContent = 'FP3';
                } else if (currentIndex === 4) {
                    tableTitle.textContent = 'Qualifications';
                }
            } else {
                if (currentIndex === 0) {
                    tableTitle.textContent = 'Race';
                } else if (currentIndex === 1) {
                    tableTitle.textContent = 'FP1';
                } else if (currentIndex === 2) {
                    tableTitle.textContent = 'FP2';
                } else if (currentIndex === 3) {
                    tableTitle.textContent = 'Qualifications';
                }
            }
        }

        showTable(currentIndex);
        updateTitle();
    </script>
</html>
