                        <span class="text-xl font-bold"> <%= __('retro_f1.all_seasons.gp_details.title') %> <%= gpDetails.gpInfos[0].raceId %> </span>
                        <span class="flex flex-col">
                            <%= gpDetails.gpInfos[0].gpOfficialName %>
