                                    <td class="font-bold pr-3"><%= String(detail.fp3Position).padStart(2, '0' ) %></td>
                                    <td class="pl-3 border-l-2"></td>
                                    <td class="pr-3">
                                        <a href="/driver/<%= detail.driverId %>">
                                            <span class="flex gap-x-1">
                                                <span>
                                                    <%= detail.lastName %>
                                                </span>
                                            </span>
                                        </a>
                                    </td>
                                    <td class="pl-3 border-l-2"></td>
                                    <td class="pr-3"><%= detail.fp3Time %></td>
                                </tr>
                                <% } %>
                                <% }); %>
                            </table>
