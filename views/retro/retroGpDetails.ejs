                                </tr>

                                <% gpDetails.raceData.sort((a, b)=> a.fp2Position - b.fp2Position); %> <% gpDetails.raceData.forEach(detail=> { %>
                                <% if(detail.fp2Position != null){ %>
                                <tr>
                                    <td class="pr-2">
                                        <span class="border-2 border-<%= detail.constructorId %> h-auto w-1 box-border bg-<%= detail.constructorId %> rounded-3xl"> </span>
                                    </td>
                                    <td class="font-bold pr-3"><%= String(detail.fp2Position).padStart(2, '0' ) %></td>
                                    <td class="pl-3 border-l-2"></td>
                                    <td class="pr-3">
                                        <a href="/driver/<%= detail.driverId %>">
                                            <span class="flex gap-x-1">
                                                <span>
                                                    <%= detail.lastName %>
                                                </span>
                                            </span>
                                        </a>
                                    </td>
                                    <td class="pl-3 border-l-2"></td>
                                    <td class="pr-3"><%= detail.fp2Time %></td>
                                </tr>
                                <% } %>
                                <% }); %>
                            </table>
                            <% } %>

                            <% if(gpDetails.gpInfos[0].date.split("-")[0] >= 2004) { %>
                            <table id="tableFP3" class="hidden">
                                <tr>
                                    <td></td>
                                    <td class="font-bold"><%= __('retro_f1.all_seasons.gp_details.position') %></td>
                                    <td></td>
                                    <td class="font-bold"><%= __('retro_f1.all_seasons.gp_details.drivers') %></td>
                                    <td></td>
                                    <td class="font-bold">Time</td>
                                </tr>

