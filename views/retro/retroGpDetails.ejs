<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">

<head>
    <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
            <meta charset="UTF-8">
            <title>PLI - <%= __('retro_f1.all_seasons.gp_details.tab_title') %>
                    <%= gpDetails.gpInfo.raceId %>
            </title>
            <link href="" rel="stylesheet">
</head>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <main>
        <div class="app-container">
            <div
                class="text-center my-4 font-F1Regular bg-s-<%= theme %> p-4 shadow-md rounded-2xl mx-4 w-11/12 md:hidden">
                <div class="flex flex-col items-center gap-2">
                    <span class="text-xl font-F1Bold">
                        <%= __('retro_f1.all_seasons.gp_details.title') %>
                            <%= gpDetails.gpInfo.raceId %>
                    </span>
                    <span>
                        <%= gpDetails.gpInfo.gpOfficialName %>
                    </span>
                </div>
                <div class="flex items-center mt-2">
                    <div class="w-6/12">
                        <span>
                            <a href="/track/<%= gpDetails.gpInfo.circuitId %>">
                                <img src="/img/circuits/<%= gpDetails.gpInfo.circuitId %>.svg"
                                    alt="<%= gpDetails.gpInfo.circuitId %>">
                            </a>
                        </span>
                    </div>
                    <div class="flex flex-col items-center w-6/12 text-sm">
                        <span>
                            <%= gpDetails.gpInfo.date %>
                        </span>
                        <span>
                            <%= gpDetails.gpInfo.gpFullName %>
                        </span>
                        <img src="/img/countryFlags/<%= gpDetails.gpInfo.countryId %>.svg"
                            alt="<%= gpDetails.gpInfo.countryId %>" class="h-6 w-auto">
                        <span title="<%= gpDetails.gpInfo.weather.weather %>">
                            <video autoplay loop muted class="h-20 w-auto">
                                <source src="/animations/<%= gpDetails.gpInfo.weather.weather %>.webm"
                                    type="video/webm">
                                Your browser does not support the video tag.
                            </video>
                        </span>
                    </div>
                </div>
            </div>
            <div class="flex flex-col md:flex-row gap-y-4 md:gap-y-0 mt-4">
                <div id="GPDetails" class="bg-s-<%= theme %> p-4 shadow-md rounded-2xl mx-4 w-11/12 md:w-5/12">
                    <table>
                        <tr>
                            <td></td>
                            <td class="font-F1Bold">
                                <%= __('retro_f1.all_seasons.gp_details.position') %>
                            </td>
                            <td></td>
                            <td class="font-F1Bold">
                                <%= __('retro_f1.all_seasons.gp_details.drivers') %>
                            </td>
                            <td></td>
                            <td class="font-F1Bold">
                                <%= __('retro_f1.all_seasons.gp_details.gap') %>
                            </td>
                        </tr>

                        <% gpDetails.raceData.forEach(detail=> { %>
                            <tr>
                                <td class="pr-2">
                                    <span
                                        class="border-2 border-<%= detail.constructorId %> h-auto w-1 box-border bg-<%= detail.constructorId %> rounded-3xl">
                                    </span>
                                </td>
                                <td class="font-F1Bold pr-3">
                                    <%= String(detail.position).padStart(2, '0' ) %>
                                </td>
                                <td class="pl-3 border-l-2"></td>
                                <td class="pr-3">
                                    <% if (detail.gap=="DNS" || detail.gap=="DNF" || detail.gap=="DSQ" ) { %>
                                        <a href="/driver/<%= detail.driverId %>" class="opacity-30">
                                            <% } else { %>
                                                <a href="/driver/<%= detail.driverId %>">
                                                    <% } %>
                                                        <span class="flex gap-x-1">
                                                            <span class="hidden md:block">
                                                                <%= detail.firstName %>
                                                            </span>
                                                            <span>
                                                                <%= detail.lastName %>
                                                            </span>
                                                        </span>
                                                </a>
                                </td>
                                <td class="pl-3 border-l-2"></td>
                                <td>
                                    <%= detail.gap %>
                                </td>
                            </tr>
                            <% }); %>
                    </table>
                </div>

                <div class="w-full gap-4">
                    <div
                        class="text-center mb-8 font-F1Regular bg-s-<%= theme %> p-4 shadow-md rounded-2xl mx-4 hidden md:block">
                        <div class="flex flex-col items-center gap-2">
                            <span class="text-xl font-F1Bold">
                                <%= __('retro_f1.all_seasons.gp_details.title') %>
                                    <%= gpDetails.gpInfo.raceId %>
                            </span>
                            <span>
                                <%= gpDetails.gpInfo.gpOfficialName %>
                            </span>
                        </div>
                        <div class="flex items-center mt-2">
                            <div class="w-6/12">
                                <span class="flex justify-center">
                                    <a href="/track/<%= gpDetails.gpInfo.circuitId %>">
                                        <img src="/img/circuits/<%= gpDetails.gpInfo.circuitId %>.svg"
                                            alt="<%= gpDetails.gpInfo.circuitId %>" class="h-44 w-auto">
                                    </a>
                                </span>
                            </div>
                            <div class="flex flex-col items-center w-6/12 text-sm">
                                <span>
                                    <%= gpDetails.gpInfo.date %>
                                </span>
                                <span>
                                    <%= gpDetails.gpInfo.gpFullName %>
                                </span>
                                <img src="/img/countryFlags/<%= gpDetails.gpInfo.countryId %>.svg"
                                    alt="<%= gpDetails.gpInfo.countryId %>" class="h-6 w-auto">
                                <span title="<%= gpDetails.gpInfo.weather.weather %>">
                                    <video autoplay loop muted class="h-20 w-auto">
                                        <source src="/animations/<%= gpDetails.gpInfo.weather.weather %>.webm"
                                            type="video/webm">
                                        Your browser does not support the video tag.
                                    </video>
                                </span>
                            </div>
                        </div>
                    </div>

                    <span class="grid grid-cols-12 md:flex-col items-center gap-1">
                        <% gpDetails.raceData.forEach(function(grid){ if (grid.grid==1) { %>
                            <a href="/driver/<%= grid.driverId %>"
                                class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 flex flex-col justify-end gap-2 items-center px-2 col-span-6">
                                <span>
                                    <%= __('retro_f1.all_seasons.gp_details.poleposition') %>
                                </span>
                                <img src="https://ik.imagekit.io/pitlaneinsider/drivers/<%= grid.driverId %>.webp"
                                    alt="<%= grid.lastName %>" class="h-24 w-auto">
                            </a>
                            <% }}) %>
                                <% gpDetails.raceData.forEach(function(grid){ if (grid.position==1) { %>
                                    <a href="/driver/<%= grid.driverId %>"
                                        class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 flex flex-col justify-end gap-2 items-center px-2 col-span-6">
                                        <span>
                                            <%= __('retro_f1.all_seasons.gp_details.winner') %>
                                        </span>
                                        <img src="https://ik.imagekit.io/pitlaneinsider/drivers/<%= grid.driverId %>.webp"
                                            alt="<%= grid.lastName %>" class="h-24 w-auto">
                                    </a>
                                    <% }}) %>
                    </span>
                    <br>
                    <span class="grid grid-cols-12 md:flex-col items-center gap-1">
                        <div
                            class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 flex flex-col justify-center gap-2 items-center px-2 col-span-6 h-32">
                            <% gpDetails.raceData.forEach(function(lap){ if (lap.fastestLapTime !=null) { %>
                                <span class="text-center">
                                    <%= __('retro_f1.all_seasons.gp_details.fastestLap') %>
                                </span>
                                <div class="flex flex-col items-center flex-grow justify-center w-full">
                                    <div>
                                        <%= lap.abbreviation %> - <span class="text-fuchsia-700">
                                                <%= lap.fastestLapTime %>
                                            </span>
                                    </div>
                                </div>
                                <% }}) %>
                        </div>
                        <div
                            class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 flex flex-col justify-center gap-2 items-center px-2 col-span-6 h-32">
                            <% gpDetails.raceData.forEach(function(pit){ if (pit.fastestPitTime !=null) { %>
                                <span class="text-center">
                                    <%= __('retro_f1.all_seasons.gp_details.fastestPit') %>
                                </span>
                                <div class="flex flex-col items-center flex-grow justify-center w-full">
                                    <%= pit.abbreviation %> - <%= pit.fastestPitTime %>
                                </div>
                                <% }}) %>
                        </div>
                    </span>
                </div>
            </div>

    </main>
    <%- include('../partials/footer.ejs') %>
</body>

</html>