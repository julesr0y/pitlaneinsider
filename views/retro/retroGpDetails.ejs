<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
            <meta charset="UTF-8">
            <title>PLI - <%= __('retro_f1.all_seasons.gp_details.tab_title') %>
            </title>
            <link href="" rel="stylesheet">

            <style>
                :root {
                    --primary-color: #3498db;
                    /* Bleu */
                    --primary-color-rgb: 52, 152, 219;
                    --second-color: #058785;
                    /* Vert pour le fond du sélecteur et du tableau */
                    --second-color-dark: #024644;
                    /* Vert foncé pour le survol */
                    --gray-400: #ccc;
                    --gray-500: #b3b3b3;
                    --text-color: #333;
                    /* Gris foncé pour le texte */
                    --white-color: #fff;
                    /* Blanc pour le texte sur les fonds colorés */
                }

                .custom-select {
                    background-color: var(--second-color);
                    border: 2px solid var(--gray-400);
                    border-radius: 9999px;
                    /* rounded-full */
                    padding: 0.5rem 1rem;
                    /* p-2 */
                    font-size: 1.25rem;
                    /* text-xl */
                    width: 100%;
                    /* w-full */
                    appearance: none;
                    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
                    color: var(--white-color);
                    /* Texte blanc */
                }

                .custom-select:hover {
                    background-color: var(--second-color-dark);
                    border-color: var(--gray-500);
                    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
                }

                .custom-select:focus {
                    outline: none;
                    border-color: var(--primary-color);
                    box-shadow: 0 0 0 3px rgba(var(--primary-color-rgb), 0.3);
                }

                .custom-select option {
                    background-color: var(--white-color);
                    /* Fond blanc pour les options */
                    color: var(--text-color);
                    /* Texte gris foncé */
                }

                /* Add a custom arrow */
                .custom-select-container {
                    position: relative;
                    display: inline-block;
                    width: 100%;
                }

                .custom-select-container::after {
                    content: '▼';
                    position: absolute;
                    top: 50%;
                    right: 1rem;
                    transform: translateY(-50%);
                    pointer-events: none;
                    font-size: 1rem;
                    color: var(--white-color);
                    /* Couleur blanche pour la flèche */
                }
            </style>
</head>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <div class="app-container">
        <div class="text-xl font-bold text-center my-4 w-full lg:font-bold">
            <%= __('retro_f1.all_seasons.gp_details.title') %>
        </div>
        <div class="flex mt-4">
            <div id="GPDetails" class="bg-s-<%= theme %> p-4 shadow-md rounded-2xl mx-4 w-5/12">
                <div class="grid grid-cols-12 text-left">
                    <span class="col-span-6 font-F1Bold">
                        <%= __('retro_f1.all_seasons.gp_details.position') %>
                    </span>
                    <span class="col-span-6 font-F1Bold">
                        <%= __('retro_f1.all_seasons.gp_details.drivers') %>
                    </span>
                </div>

                <div class="gp-detail-list grid grid-cols-12 mt-4 text-base text-left">
                    <% gpDetails.forEach(detail=> { %>
                        <span class="col-span-6 font-F1Bold">
                            <%= String(detail.position).padStart(2, '0' ) %>
                        </span>
                        <span class="col-span-6">
                            <%= detail.abbreviation %>
                        </span>
                        <% }); %>
                </div>
            </div>

            <div class="w-7/12 grid grid-rows-12 gap-4">
                <div
                    class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-end gap-2 items-center px-2">
                    <% gpDetails.forEach(function(grid){ if (grid.grid==1) { %>
                        <span>Pole position</span>
                        <img src="/img/drivers/<%= grid.driverId %>.webp" alt="<%= grid.lastName %>"
                            class="h-24 w-auto">
                        <% }}) %>
                </div>
                <div
                    class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-end gap-2 items-center px-2">
                    <% gpDetails.forEach(function(grid){ if (grid.position==1) { %>
                        <span>Vainqueur</span>
                        <img src="/img/drivers/<%= grid.driverId %>.webp" alt="<%= grid.lastName %>"
                            class="h-24 w-auto">
                        <% }}) %>
                </div>
                <div
                    class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-center gap-2 items-center px-2">
                    <% gpDetails.forEach(function(lap){ if (lap.fastestLapTime !=null) { %>
                        <span class="text-center">Tour le plus rapide</span>
                        <div class="flex flex-col items-center flex-grow justify-center w-full">
                            <div>
                                <%= lap.abbreviation %> - <span class="text-fuchsia-700">
                                        <%= lap.fastestLapTime %>
                                    </span>
                            </div>
                        </div>
                        <% }}) %>
                </div>
                <div
                    class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-center gap-2 items-center px-2">
                    <% gpDetails.forEach(function(pit){ if (pit.fastestPitTime !=null) { %>
                        <span class="text-center">PitStop le plus rapide (temps total)</span>
                        <div class="flex flex-col items-center flex-grow justify-center w-full">
                            <%= pit.abbreviation %> - <%= pit.fastestPitTime %>
                        </div>
                        <% }}) %>
                </div>
            </div>
        </div>
        <script>
            function changeSeason(select) {
                var selectedYear = select.value;
                window.location.href = '/retrocalendar/' + selectedYear;
            }
            function updateLinks() {
                var selectedYear = document.getElementById('seasonSelect').value;
                document.getElementById('classementLink').href = '/retrostandings/' + selectedYear;
                document.getElementById('calendrierLink').href = '/retrocalendar/' + selectedYear;
            }
            document.addEventListener('DOMContentLoaded', function () {
                updateLinks();
                document.getElementById('seasonSelect').addEventListener('change', updateLinks);
            });
        </script>
        <%- include('../partials/footer.ejs') %>
</body>

</html>