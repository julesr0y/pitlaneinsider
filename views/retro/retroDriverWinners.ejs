<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>" class="bg-b-<%= theme %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>PLI - <%= __('retro_f1.winners.tab_title') %></title>
    </head>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %>">
        <main>
            <div class="container mx-auto px-4">
                <div class="text-4xl font-bold text-center my-8"><%= __('retro_f1.winners.title') %></div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% for (let index in retro_titre) { %>
                    <a href="/driver/<%= retro_titre[index].id %>">
                        <div class="bg-s-<%= theme %> flex flex-col items-center justify-center p-6 rounded-lg transform transition-transform hover:-translate-y-1 hover:shadow-xl">
                            <div class="w-full border-l-4 border-main-color pl-4">
                                <div class="flex items-center justify-between w-full">
                                    <div>
                                        <span class="text-2xl font-bold">
                                            <%= retro_titre[index].firstName %>
                                            <br />
                                            <%= retro_titre[index].lastName %>
                                        </span>
                                        <div class="bg-main-color h-1 w-12 mt-2"></div>
                                    </div>
                                    <img src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= retro_titre[index].id %>.webp" alt="<%= retro_titre[index].firstName %> <%= retro_titre[index].lastName %>" class="h-16 w-16 object-cover rounded-full flex-shrink-0 border border-gray-400/20 shadow-xs ml-4" onerror="this.style.display = 'none'" />
                                </div>
                                <div class="flex items-center mt-4 text-t-s-<%= theme %>">
                                    <span class="text-lg"> <%= __('retro_f1.winners.number_of_titles') %> : </span>
                                    <span class="text-4xl font-semibold text-main-color ml-2"> <%= retro_titre[index].totalChampionshipWins %> </span>
                                </div>
                            </div>
                        </div>
                    </a>
                    <% } %>
                </div>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>
</html>
