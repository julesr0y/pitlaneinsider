<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head.ejs') %>
        <%- include('partials/header.ejs') %>
            <title>PLI - <%= __('drivers.tab_title') %>
            </title>
</head>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <div class="text-3xl font-bold text-center my-8 mb-4 w-full pt-4 lg:pt-8 lg:text-3xl lg:font-bold lg:my-8">
        <%= __('drivers.season') %>
    </div>
    <div class="w-9/10 mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 pt-10">
        <% pilotesFront.forEach(function(pilote) { %>
            <div
                class="bg-s-<%= theme %> rounded-lg shadow-lg overflow-hidden transform transition duration-300 hover:scale-105 p-4 m-2">
                <a href="/driver/<%= pilote.id %>" class="block text-center relative">
                    <div class="relative mb-4">
                        <img src="/img/drivers/<%= pilote.id %>.webp" alt="<%= pilote.id %>"
                            class="w-full h-40 object-contain">
                        <div class="absolute top-2 right-2 w-16 h-16">
                            <img src="/img/countryFlags/<%= pilote.nationality.toLowerCase() %>.svg"
                                alt="<%= pilote.nationality %>" class="w-12 h-auto">
                        </div>
                        <div class="absolute top-2 left-2 w-16 h-16">
                            <img src="/img/2024/logo_pilote/<%= pilote.lastName.toLowerCase() %>Logo.webp"
                                alt="Logo of <%= pilote.firstName %> <%= pilote.lastName %>"
                                class="w-full h-full object-contain">
                        </div>
                    </div>
                    <div>
                        <img src="/img/teams/<%= pilote.constructorId.toLowerCase() %>.webp"
                            alt="<%= pilote.constructorId %>" class="h-10 w-auto mx-auto mb-2">
                        <div class="font-F1Bold text-2xl text-<%= pilote.constructorId.toLowerCase() %> mb-1">
                            <%= pilote.permanentNumber %>
                        </div>
                        <div class="text-xl font-semibold">
                            <%= pilote.firstName %> <br>
                                <span class="font-F1Bold text-2xl">
                                    <%= pilote.lastName %>
                                </span>
                        </div>
                    </div>
                </a>
            </div>
            <% }); %>
    </div>
    <%- include('partials/footer.ejs') %>
</body>

</html>