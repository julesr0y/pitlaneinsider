<header class="font-F1Regular">
    <div class="nav">
        <input type="checkbox" id="nav-check">
        <div class="nav-header">
            <div class="nav-title">
                <p class="font-F1Wide text-3xl text-white" id="mobile"><a href="/">PLI</a></p>
                <p class="font-F1Wide text-2xl text-white" id="pc"><a href="/">PitLane Insider</a></p>
            </div>
        </div>
        <div class="nav-btn">
            <label for="nav-check">
                <span class="span1"></span>
                <span class="span2"></span>
                <span class="span3"></span>
            </label>
        </div>
        <div class="nav-links">
            <a href="/teams" id="ecuries">
                <%= __('header.teams') %>
            </a>
            <a href="/drivers" id="pilotes">
                <%= __('header.drivers') %>
            </a>
            <a href="/calendar" id="calendrier">
                <%= __('header.calendar') %>
            </a>
            <a href="/standings" id="classement">
                <%= __('header.standings') %>
            </a>
            <a href="/reglementations" id="reglement">
                <%= __('header.reglementation') %>
            </a>
            <a href="/retrohome" id="retro">
                <%= __('header.retro_f1') %>
            </a>
            <a href="/live" id="live">
                <%= __('header.live') %>
            </a>
            <a href="/profile" id="compte">
                <%= __('header.account') %>
            </a>
        </div>
    </div>
</header>

<script>
    document.getElementById('nav-check').addEventListener('change', function () {
        document.body.classList.toggle('no-scroll', this.checked);
        document.querySelector('.nav-btn').classList.toggle('cross', this.checked);
        document.querySelector('.nav-links').classList.toggle('show', this.checked);
    });
</script>