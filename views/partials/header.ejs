<header class="font-regular">
    <div class="nav">
        <input type="checkbox" id="nav-check" />
        <div class="nav-header">
            <div class="nav-title">
                <p class="font-wide text-3xl text-white" id="mobile"><a href="/">PLI</a></p>
                <p class="font-wide text-2xl text-white" id="pc"><a href="/">PitLane Insider</a></p>
            </div>
        </div>
        <label class="hamburger-menu" id="hamburger-menu-label" for="nav-check">
            <div class="bar" id="bar1"></div>
            <div class="bar" id="bar2"></div>
            <div class="bar" id="bar3"></div>
        </label>

        <div class="nav-links no-scrollbar">
            <table class="mx-auto text-center w-full">
                <tr class="border-t-2 border-b-2 border-white">
                    <td>
                        <a href="/constructors" id="ecuries"> <%= __('header.constructors') %> </a>
                    </td>
                </tr>
                <tr class="border-b-2 border-white">
                    <td><a href="/drivers" id="pilotes"> <%= __('header.drivers') %> </a></td>
                </tr>
                <tr class="border-b-2 border-white">
                    <td><a href="/calendar" id="calendrier"> <%= __('header.calendar') %> </a></td>
                </tr>
                <tr class="border-b-2 border-white">
                    <td><a href="/driverstandings" id="classement"> <%= __('header.standings') %> </a></td>
                </tr>
                <tr class="border-b-2 border-white">
                    <td><a href="/reglementations" id="reglement"> <%= __('header.reglementation') %> </a></td>
                </tr>
                <tr class="border-b-2 border-white">
                    <td><a href="/retrohome" id="retro"> <%= __('header.retro_f1') %> </a></td>
                </tr>
                <tr class="border-b-2 border-white">
                    <td><a href="/live" id="live"> <%= __('header.live') %> </a></td>
                </tr>
                <tr class="border-b-2 border-white">
                    <td><a href="/news" id="news"> <%= __('header.news') %> </a></td>
                </tr>
            </table>
        </div>
    </div>
</header>
<script>
    // Uncheck menu on page load/back
    window.addEventListener('pageshow', function (event) {
        const navCheck = document.getElementById('nav-check');
        if (navCheck) navCheck.checked = false;
        document.body.style.overflow = '';
    });

    // Uncheck menu when clicking a link
    document.querySelectorAll('.nav-links a').forEach(function (link) {
        link.addEventListener('click', function () {
            const navCheck = document.getElementById('nav-check');
            if (navCheck) navCheck.checked = false;
            document.body.style.overflow = '';
        });
    });

    // Prevent jump to top bug on some browsers when clicking the label
    const hamburgerLabel = document.getElementById('hamburger-menu-label');
    if (hamburgerLabel) {
        hamburgerLabel.addEventListener('click', function (e) {
            e.preventDefault(); // Empêche le comportement par défaut qui peut faire scroller en haut
            const navCheck = document.getElementById('nav-check');
            if (navCheck) {
                navCheck.checked = !navCheck.checked;
                // Bloquer le scroll du body quand le menu est ouvert
                if (navCheck.checked) {
                    document.body.style.overflow = 'hidden';
                } else {
                    document.body.style.overflow = '';
                }
            }
        });
    }
</script>
