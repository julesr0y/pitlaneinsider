<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <title>PLI - <%= __('standings.tab_title') %></title>
    </head>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %>">
        <main class="flex flex-col justify-center items-center">
            <div class="text-3xl font-bold text-center my-8 mb-4 w-full pt-4 lg:pt-8 lg:text-3xl lg:font-bold lg:my-8"><%= __('global.current_year') %> <%= __('standings.season') %></div>
            <div class="tabs flex justify-center">
                <div class="tab">
                    <a href="/driverstandings" class="mr-4"><%= __('standings.drivers') %></a>
                    <a href="/constructorstandings" class="underline"><%= __('standings.constructors') %></a>
                </div>
            </div>

            <div class="bg-s-<%= theme %> p-4 mt-8 rounded-3xl mx-auto max-w-sm sm:max-w-xl h-2/3">
                <table>
                    <tr>
                        <td></td>
                        <td class="font-bold"><%= __('standings.position') %></td>
                        <td class="pl-3 font-bold"><%= __('standings.constructors') %></td>
                        <td class="font-bold pl-3"><%= __('standings.chassis') %></td>
                        <td class="pl-3 font-bold"><%= __('standings.points') %></td>
                    </tr>
                    <% actualTeamsStanding.forEach(function(team) { %>
                    <tr>
                        <td class="pr-2">
                            <span class="border-2 border-<%= team.constructorId %> h-auto w-1 box-border bg-<%= team.constructorId %> rounded-3xl"> </span>
                        </td>
                        <td class="pr-3 font-bold"><%= String(team.position).padStart(2, '0' ) %></td>
                        <td class="border-l-2 pl-3 pr-3">
                            <a href="/constructor/<%= team.constructorId %>"> <%= team.name %> </a>
                        </td>
                        <td class="border-l-2 pl-3 pr-3">
                            <span> TBC </span>
                        </td>
                        <td class="border-l-2 pl-3"><%= team.points %></td>
                    </tr>
                    <% }); %>
                </table>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>
</html>
