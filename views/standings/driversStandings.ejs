<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <title>PLI - <%= __('standings.tab_title') %></title>
        <script src="/js/noscroll.js"></script>
    </head>

    <body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
        <main class="flex flex-col justify-center items-center">
            <div class="text-3xl font-bold text-center my-8 mb-4 w-full pt-4 lg:pt-8 lg:text-3xl lg:font-bold lg:my-8"><%= __('global.current_year') %> <%= __('standings.season') %></div>
            <div class="tabs flex justify-center">
                <div class="tab">
                    <a href="/driverstandings" class="mr-4 underline"><%= __('standings.drivers') %></a>
                    <a href="/constructorstandings"><%= __('standings.constructors') %></a>
                </div>
            </div>

            <div class="bg-s-<%= theme %> p-4 mt-8 rounded-3xl mx-auto max-w-sm sm:max-w-xl h-2/3">
                <table>
                    <tr id="header-classement-pilotes">
                        <td></td>
                        <td class="font-F1Bold"><%= __('standings.position') %></td>
                        <td class="font-F1Bold pl-3"><%= __('standings.drivers') %></td>
                        <td class="font-F1Bold pl-3"><%= __('standings.points') %></td>
                    </tr>
                    <% actualDriversStanding.forEach(function(pilote) { %>
                    <tr>
                        <td class="pr-2">
                            <span class="border-2 border-<%= pilote.constructorId %> h-auto w-1 box-border bg-<%= pilote.constructorId %> rounded-3xl"> </span>
                        </td>
                        <td class="font-F1Bold pr-3"><%= String(pilote.position).padStart(2, '0' ) %></td>
                        <td class="border-l-2 pl-3 pr-3">
                            <a href="/driver/<%= pilote.driverId %>"> <%= pilote.firstName %> <%= pilote.lastName %> </a>
                        </td>
                        <td class="border-l-2 pl-3"><%= pilote.points %></td>
                    </tr>
                    <% }); %>
                </table>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>
</html>
