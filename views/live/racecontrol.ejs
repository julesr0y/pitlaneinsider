<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <title>PLI - <%= __('live.tab_title') %></title>
    </head>

    <body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
        <main>
            <div class="text-center flex items-center justify-center gap-x-3 text-xl font-bold mt-8 mb-4">
                <span>
                    <span class="w-4 h-4 rounded-full bg-red-500 animate-pulse inline-block"></span>
                    <span class="text-red-500"> <%= __('live.live_title') %> </span>
                </span>
                <span id="frontSession"></span>
                <span id="frontLocation"></span>
            </div>

            <div class="flex justify-center mb-8">
                <a href="/live" id="btnClassement" class="mr-4"> <%= __('live.link_standings') %> </a>
                <a href="/live/racecontrol" id="btnRaceControl" class="mr-4 underline" onclick="openTab('RaceControl')"> <%= __('live.link_race_control') %> </a>
                <a href="/live/radio" id="btnRadio" onclick="openTab('Radio')"> <%= __('live.link_radio') %> </a>
            </div>

            <div id="RaceControl" class="flex flex-col items-center justify-center p-4 sm:pt-8"></div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>

    <script src="/js/liveTitle.js"></script>
    <script src="/js/liveUpdates.js"></script>
</html>
