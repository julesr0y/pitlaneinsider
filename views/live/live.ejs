<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">

<head>
    <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
            <title>PLI - <%= __('live.tab_title') %>
            </title>
</head>

<style>
    .move {
        transition: transform 1s ease-in-out;
        /* Rendre la transition plus lente et fluide */
    }
</style>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <div class="text-center text-2xl font-bold my-8">
        <span>
            <span class="w-4 h-4 rounded-full bg-red-500 animate-pulse inline-block"></span>
            <span class="text-red-500">
                <%= __('live.live_title') %>
            </span> -
            <span id="frontLocation"></span>
        </span> - <span id="frontSession"></span>
    </div>

    <!-- <div class="text-center text-2xl font-bold my-8">
        <span id="lap"></span>
    </div> -->


    <div class="flex justify-center mb-8">
        <a href="/live" id="btnClassement" class="mr-4 underline">
            <%= __('live.link_standings') %>
        </a>
        <a href="/live/racecontrol" id="btnRaceControl" class="mr-4" onclick="openTab('RaceControl')">
            <%= __('live.link_race_control') %>
        </a>
        <a href="/live/radio" id="btnRadio" onclick="openTab('Radio')">
            <%= __('live.link_radio') %>
        </a>
    </div>

    <!-- <div class="flex justify-evenly">
        <span id="track_temp"></span>
        <span id="air_temp"></span>
        <span id="rain_fall"></span>
        <span id="wind_speed"></span>
    </div> -->

    <div class="flex mt-4">
        <div id="Classement" class="bg-s-<%= theme %> p-4 shadow-md rounded-2xl mx-4 w-5/12">
            <div class="grid grid-cols-2 justify-center items-center pb-4 font-F1Bold text-base">
                <span>Pos</span>
                <span>Drivers</span>
            </div>
        </div>

        <div class="w-7/12 grid grid-rows-12 gap-4">
            <div
                class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-end gap-2 items-center px-2">
                <span id="track_temp"></span>
            </div>
            <div
                class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-end gap-2 items-center px-2">
                <span id="air_temp"></span>
            </div>
            <div
                class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-center gap-2 items-center px-2">
                <span id="rain_fall"></span>
            </div>
            <div
                class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-center gap-2 items-center px-2">
                <span id="wind_speed"></span>
            </div>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>
</body>

<script src="/js/liveTitle.js"></script>
<!-- <script src="/js/liveStandingsMin.js"></script> -->
<script src="/js/liveWeather.js"></script>

<script>
    const rankings1 = [
        { driver_number: 81 }, { driver_number: 4 },
        { driver_number: 44 }, { driver_number: 16 },
        { driver_number: 1 }, { driver_number: 55 },
        { driver_number: 11 }, { driver_number: 63 },
        { driver_number: 22 }, { driver_number: 18 },
        { driver_number: 14 }, { driver_number: 3 },
        { driver_number: 27 }, { driver_number: 23 },
        { driver_number: 20 }, { driver_number: 77 },
        { driver_number: 2 }, { driver_number: 31 },
        { driver_number: 24 }, { driver_number: 10 }
    ];

    const rankings2 = [
        { driver_number: 81 }, { driver_number: 16 },
        { driver_number: 4 }, { driver_number: 44 },
        { driver_number: 1 }, { driver_number: 55 },
        { driver_number: 11 }, { driver_number: 63 },
        { driver_number: 22 }, { driver_number: 18 },
        { driver_number: 14 }, { driver_number: 3 },
        { driver_number: 27 }, { driver_number: 23 },
        { driver_number: 20 }, { driver_number: 77 },
        { driver_number: 2 }, { driver_number: 31 },
        { driver_number: 24 }, { driver_number: 10 }
    ];

    let currentRankings = rankings1;

    function renderRankings(rankings) {
        const classementDiv = document.getElementById('Classement');
        // Supprime les anciens éléments, sauf les en-têtes
        const children = Array.from(classementDiv.children).slice(1);
        children.forEach(child => classementDiv.removeChild(child));

        rankings.forEach((driver, index) => {
            const driverDiv = document.createElement('div');
            driverDiv.className = 'grid grid-cols-2 justify-center items-center driver move';
            driverDiv.dataset.driverNumber = driver.driver_number;

            const rankSpan = document.createElement('span');
            rankSpan.className = 'rank font-F1Bold';
            rankSpan.textContent = `${(index + 1).toString().padStart(2, '0')}`;

            const numberSpan = document.createElement('span');
            numberSpan.className = 'pilot-number';
            numberSpan.textContent = driver.driver_number;

            driverDiv.appendChild(rankSpan);
            driverDiv.appendChild(numberSpan);

            classementDiv.appendChild(driverDiv);
        });
    }

    function updateRankings(newRankings) {
        const classementDiv = document.getElementById('Classement');
        const driverDivs = classementDiv.querySelectorAll('.driver');

        newRankings.forEach((driver, newIndex) => {
            const driverDiv = Array.from(driverDivs).find(div => div.dataset.driverNumber == driver.driver_number);
            const oldIndex = Array.from(driverDivs).indexOf(driverDiv);
            if (oldIndex !== newIndex) {
                driverDiv.style.transform = `translateY(${(newIndex - oldIndex) * 100}%)`;
                setTimeout(() => {
                    driverDiv.style.transform = 'translateY(0)';
                    classementDiv.insertBefore(driverDiv, classementDiv.children[newIndex + 1] || null);
                }, 1000); // Synchronisé avec la durée de la transition
            }
        });
    }

    renderRankings(currentRankings);

    setInterval(() => {
        currentRankings = currentRankings === rankings1 ? rankings2 : rankings1;
        updateRankings(currentRankings);
        setTimeout(() => renderRankings(currentRankings), 1000); // Mettre à jour après l'animation
    }, 7000); // Temps ajusté pour les changements de classement
</script>

</html>