<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">

<head>
    <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
            <title>PLI - <%= __('live.tab_title') %>
            </title>
</head>

<style>
    .move {
        transition: transform 2s ease-in-out;
    }

    .arrow-up img,
    .arrow-down img {
        width: 20px;
        height: auto;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @keyframes fadeOut {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
        }
    }

    .fade-in {
        animation: fadeIn 0.5s ease-in-out forwards;
    }

    .fade-out {
        animation: fadeOut 0.5s ease-in-out forwards;
    }

    @keyframes highlightFirstPlace {
        0% {
            background-color: transparent;
        }

        25%,
        75% {
            background-color: #731c87;
        }

        100% {
            background-color: transparent;
        }
    }

    .first-place {
        animation: highlightFirstPlace 1s ease-in-out forwards;
    }
</style>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <main>
        <div class="text-center flex items-center justify-center gap-x-3 text-xl font-bold mt-8 mb-4">
            <span>
                <span class="w-4 h-4 rounded-full bg-red-500 animate-pulse inline-block"></span>
                <span class="text-red-500">
                    <%= __('live.live_title') %>
                </span>
            </span>
            <span id="frontSession"></span>
            <span id="frontLocation"></span>
        </div>

        <div class="flex justify-center mb-4">
            <a href="/live" id="btnClassement" class="mr-4 underline">
                <%= __('live.link_standings') %>
            </a>
            <a href="/live/racecontrol" id="btnRaceControl" class="mr-4" onclick="openTab('RaceControl')">
                <%= __('live.link_race_control') %>
            </a>
            <a href="/live/radio" id="btnRadio" onclick="openTab('Radio')">
                <%= __('live.link_radio') %>
            </a>
        </div>

        <div class="flex mt-4">
            <a href="/live/detailedstandings" id="Classement"
                class="bg-s-<%= theme %> py-4 shadow-md rounded-2xl mx-4 w-5/12">
                <div class="grid grid-cols-2 justify-center items-center px-4 pb-4 font-F1Bold text-base">
                    <span>Pos</span>
                    <span>Drivers</span>
                </div>
            </a>

            <div class="w-7/12 grid grid-rows-12 gap-4">
                <div
                    class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-center gap-3 items-center px-2">
                    <img src="/img/assets/track-<%= theme %>.svg" alt="track" class="h-16 w-auto">
                    <span id="track_temp"></span>
                </div>
                <div
                    class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-center gap-3 items-center px-2">
                    <img src="/img/assets/temperature-<%= theme %>.svg" alt="air-temp" class="h-16 w-auto">
                    <span id="air_temp"></span>
                </div>
                <div
                    class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-center gap-3 items-center px-2">
                    <img src="/img/assets/rain-<%= theme %>.svg" alt="rain" class="h-16 w-auto">
                    <span id="rain_fall"></span>
                </div>
                <div
                    class="bg-s-<%= theme %> shadow-md rounded-2xl mx-4 row-span-3 flex flex-col justify-center gap-3 items-center px-2">
                    <img src="/img/assets/wind-<%= theme %>.svg" alt="wind" class="h-16 w-auto">
                    <span id="wind_speed"></span>
                </div>
            </div>
        </div>
    </main>
    <%- include('../partials/footer.ejs') %>
</body>

<script src="/js/liveTitle.js"></script>
<script src="/js/liveStandingsMin.js"></script>
<script src="/js/liveWeather.js"></script>

</html>