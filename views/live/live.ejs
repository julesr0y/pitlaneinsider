<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>" class="bg-b-<%= theme %>">

<head>
    <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
            <title>PLI - <%= __('live.tab_title') %>
            </title>
</head>

<body class="font-regular text-gray-100 bg-b-<%= theme %> min-h-screen flex flex-col selection:bg-red-500/30">
    <main class="flex-grow container mx-auto px-4 py-8">
        <!-- Header Section -->
        <div class="flex flex-col items-center justify-center gap-2 pt-4">
            <div
                class="flex items-center gap-3 bg-s-<%= theme %>/80 border border-gray-400 md:backdrop-blur-sm rounded-full px-6 py-2 shadow-lg">
                <span
                    class="w-3 h-3 rounded-full bg-red-500 shadow-[0_0_10px_rgba(239,68,68,0.8)] animate-pulse inline-block"></span>
                <span class="text-red-500 font-bold uppercase tracking-widest text-[8px] md:text-sm">
                    <%= __('live.live_title') %>
                </span>
                <span class="text-gray-500 font-mono text-xs border-l border-gray-700 pl-3 ml-1" id="ws-status">
                    <%= __('live.connecting') %>
                </span>
            </div>
            <!-- Session Title Widget (Updated dynamically) -->
            <div id="session-title-container" class="text-center mt-2"></div>
        </div>

        <!-- Two-Column Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-7xl mx-auto relative">
            <!-- Ambient glow -->
            <div
                class="hidden md:block absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-64 bg-red-500/5 blur-[120px] rounded-full pointer-events-none">
            </div>

            <!-- LEFT COLUMN: STANDINGS (7/12) -->
            <div class="lg:col-span-7">
                <div
                    class="bg-s-<%= theme %> md:backdrop-blur-xl rounded-3xl shadow-2xl overflow-hidden h-[800px] flex flex-col">
                    <div
                        class="px-6 py-4 border-b border-gray-400 bg-s-<%= theme %>/40 flex justify-between items-center">
                        <span class="text-[8px] md:text-sm md:text-lg font-bold text-white tracking-wide">
                            <div class="flex items-center justify-center gap-3">
                                <img id="session-flag" src=""
                                    class="w-auto h-6 md:h-10 rounded shadow-md hidden object-cover"
                                    alt="<%= __('live.flag_alt') %>" />
                                <span id="session-name"></span>
                            </div>
                        </span>
                        <span id="session-laps" class="text-gray-400 font-mono text-[8px] md:text-sm mt-1"></span>
                    </div>

                    <div class="p-4 flex-grow overflow-y-auto custom-scrollbar">
                        <div id="standings-header"
                            class="grid grid-cols-12 gap-2 text-xs font-bold text-gray-500 uppercase tracking-widest px-4 mb-3">
                            <div class="col-span-1 text-center text-[8px] md:text-sm"></div>
                            <div class="col-span-2 text-[8px] md:text-sm">
                                <%= __('live.driver') %>
                            </div>
                            <div class="col-span-4 md:col-span-3 text-center text-[8px] md:text-sm">
                                <%= __('live.times') %>
                            </div>
                            <div class="col-span-1 md:col-span-2 text-center text-[8px] md:text-sm">
                                <%= __('live.tyre') %>
                            </div>
                            <div class="col-span-2 text-center text-[8px] md:text-sm">
                                <%= __('live.pit') %>
                            </div>
                            <div class="col-span-2 text-center text-[8px] md:text-sm">
                                <%= __('live.gap') %>
                            </div>
                        </div>

                        <div id="standings-container" class="flex flex-col gap-1">
                            <% for(let i=0; i < 10; i++) { %>
                                <div
                                    class="grid grid-cols-12 gap-2 items-center px-4 py-2.5 bg-s-<%= theme %>/30 rounded-xl border border-gray-700/30 animate-pulse">
                                    <div class="col-span-1 flex justify-center">
                                        <div class="w-6 h-5 bg-gray-700/60 rounded"></div>
                                    </div>
                                    <div class="col-span-2 flex items-center">
                                        <div class="w-14 h-6 bg-gray-700/60 rounded"></div>
                                    </div>
                                    <div class="col-span-3 flex flex-col items-center gap-1">
                                        <div class="w-24 h-3 bg-gray-700/50 rounded"></div>
                                        <div class="w-20 h-3 bg-gray-700/40 rounded"></div>
                                    </div>
                                    <div class="col-span-2 flex justify-center">
                                        <div class="w-6 h-6 bg-gray-700/50 rounded-full"></div>
                                    </div>
                                    <div class="col-span-2 flex justify-end">
                                        <div class="w-16 h-5 bg-gray-700/50 rounded"></div>
                                    </div>
                                </div>
                                <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: WIDGETS (5/12) -->
            <div class="lg:col-span-5 flex flex-col gap-6">
                <!-- WEATHER WIDGET -->
                <div class="bg-s-<%= theme %> md:backdrop-blur-xl rounded-3xl shadow-2xl overflow-hidden">
                    <div class="px-6 py-3 border-b border-gray-400 bg-s-<%= theme %>">
                        <h2 class="text-[8px] md:text-sm font-bold text-gray-300 tracking-wider uppercase">
                            <%= __('live.weather_conditions') %>
                        </h2>
                    </div>
                    <div class="p-5 grid grid-cols-2 gap-4" id="weather-container">
                        <div
                            class="bg-s-<%= theme %>/30 rounded-2xl p-4 flex flex-col items-center border border-gray-400/50">
                            <span class="text-gray-500 text-xs font-bold uppercase tracking-widest mb-1">
                                <%= __('live.air_temp') %>
                            </span>
                            <span id="w-air" class="text-2xl font-black text-white"><span
                                    class="inline-block w-12 h-6 bg-gray-700/50 animate-pulse rounded mt-1"></span></span>
                        </div>
                        <div
                            class="bg-s-<%= theme %>/30 rounded-2xl p-4 flex flex-col items-center border border-gray-400/50">
                            <span class="text-gray-500 text-xs font-bold uppercase tracking-widest mb-1">
                                <%= __('live.track_temp') %>
                            </span>
                            <span id="w-track" class="text-2xl font-black text-white"><span
                                    class="inline-block w-12 h-6 bg-gray-700/50 animate-pulse rounded mt-1"></span></span>
                        </div>
                        <div
                            class="bg-s-<%= theme %>/30 rounded-2xl p-4 flex flex-col items-center border border-gray-400/50">
                            <span class="text-gray-500 text-xs font-bold uppercase tracking-widest mb-1">
                                <%= __('live.wind') %>
                            </span>
                            <span id="w-wind" class="text-xl font-bold text-gray-200"><span
                                    class="inline-block w-16 h-5 bg-gray-700/50 animate-pulse rounded mt-1"></span></span>
                        </div>
                        <div
                            class="bg-s-<%= theme %>/30 rounded-2xl p-4 flex flex-col items-center border border-gray-400/50">
                            <span class="text-gray-500 text-xs font-bold uppercase tracking-widest mb-1">
                                <%= __('live.rainfall') %>
                            </span>
                            <span id="w-rain" class="text-xl font-bold text-gray-200"><span
                                    class="inline-block w-10 h-5 bg-gray-700/50 animate-pulse rounded mt-1"></span></span>
                        </div>
                    </div>
                </div>

                <!-- RACE CONTROL WIDGET -->
                <div
                    class="bg-s-<%= theme %> md:backdrop-blur-xl rounded-3xl shadow-2xl overflow-hidden flex flex-col h-[300px]">
                    <div class="px-6 py-3 border-b border-gray-400 bg-s-<%= theme %>/40">
                        <h2 class="text-[8px] md:text-sm font-bold text-gray-300 tracking-wider uppercase">
                            <%= __('live.race_control') %>
                        </h2>
                    </div>
                    <div id="race-control-container" class="p-4 flex flex-col gap-3 overflow-y-auto custom-scrollbar">
                        <div
                            class="p-3 rounded-xl border border-gray-700/30 bg-s-<%= theme %>/20 animate-pulse flex flex-col gap-2">
                            <div class="flex justify-between items-center">
                                <div class="w-20 h-3 bg-gray-700/60 rounded"></div>
                                <div class="w-12 h-3 bg-gray-700/40 rounded"></div>
                            </div>
                            <div class="w-3/4 h-4 bg-gray-700/50 rounded"></div>
                        </div>
                        <div
                            class="p-3 rounded-xl border border-gray-700/30 bg-s-<%= theme %>/20 animate-pulse flex flex-col gap-2">
                            <div class="flex justify-between items-center">
                                <div class="w-24 h-3 bg-gray-700/60 rounded"></div>
                                <div class="w-12 h-3 bg-gray-700/40 rounded"></div>
                            </div>
                            <div class="w-2/3 h-4 bg-gray-700/50 rounded"></div>
                        </div>
                    </div>
                </div>

                <!-- TEAM RADIO WIDGET -->
                <div
                    class="bg-s-<%= theme %> md:backdrop-blur-xl rounded-3xl shadow-2xl overflow-hidden flex flex-col h-[200px]">
                    <div class="px-6 py-3 border-b border-gray-400 bg-s-<%= theme %>/40">
                        <h2 class="text-[8px] md:text-sm font-bold text-gray-300 tracking-wider uppercase">
                            <%= __('live.team_radios') %>
                        </h2>
                    </div>
                    <div id="radio-container" class="p-4 flex flex-col gap-3 overflow-y-auto custom-scrollbar">
                        <div
                            class="p-3 rounded-xl bg-s-<%= theme %>/20 border border-gray-700/30 animate-pulse flex flex-col gap-2">
                            <div class="flex justify-between items-center">
                                <div class="w-24 h-3 bg-gray-700/60 rounded"></div>
                                <div class="w-12 h-3 bg-gray-700/40 rounded"></div>
                            </div>
                            <div class="w-full h-8 bg-gray-700/40 rounded-lg"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('../partials/footer.ejs') %>

        <style>
            .custom-scrollbar::-webkit-scrollbar {
                width: 6px;
            }

            .custom-scrollbar::-webkit-scrollbar-track {
                background: transparent;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: rgba(75, 85, 99, 0.4);
                border-radius: 10px;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background: rgba(75, 85, 99, 0.7);
            }
        </style>

        <script>
            const ui = {
                wsStatus: document.getElementById('ws-status'),
                sessionName: document.getElementById('session-name'),
                sessionLaps: document.getElementById('session-laps'),
                standings: document.getElementById('standings-container'),
                wAir: document.getElementById('w-air'),
                wTrack: document.getElementById('w-track'),
                wWind: document.getElementById('w-wind'),
                wRain: document.getElementById('w-rain'),
                raceControl: document.getElementById('race-control-container'),
                radio: document.getElementById('radio-container'),
            };

            let ws;
            const knownRadios = new Set();
            let currentSessionMode = 'race';

            function renderHeaders() {
                const header = document.getElementById('standings-header');
                if (!header) return;
                if (currentSessionMode === 'practice') {
                    header.innerHTML = `
                        <div class="col-span-1 text-center"></div>
                        <div class="col-span-2"><%= __('live.driver') %></div>
                        <div class="col-span-4 text-center"><%= __('live.times') %></div>
                        <div class="col-span-1 text-center"><%= __('live.tyre') %></div>
                        <div class="col-span-4 text-right"><%= __('live.gap') %></div>
                    `;
                } else {
                    header.innerHTML = `
                        <div class="col-span-1 text-center"></div>
                        <div class="col-span-2"><%= __('live.driver') %></div>
                        <div class="col-span-4 md:col-span-3 text-center"><%= __('live.times_pits') %></div>
                        <div class="col-span-1 md:col-span-2 text-center"><%= __('live.tyre') %></div>
                        <div class="col-span-2 text-center"><%= __('live.pit') %></div>
                        <div class="col-span-2 text-center justify-left"><%= __('live.interval') %> / <%= __('live.gap') %></div>
                    `;
                }
            }

            function connectWS() {
                const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
                ws = new WebSocket(`${protocol}//${window.location.host}`);

                ws.onopen = () => {
                    ui.wsStatus.textContent = `<%= __('live.connected') %>`;
                    ui.wsStatus.className = 'text-green-500 font-mono text-xs border-l border-gray-700 pl-3 ml-1 tracking-widest';
                };

                ws.onmessage = (event) => {
                    try {
                        const msg = JSON.parse(event.data);
                        handleMessage(msg);
                    } catch (e) {
                        console.error('Error parsing WS data', e);
                    }
                };

                ws.onclose = () => {
                    ui.wsStatus.textContent = `<%= __('live.reconnecting') %>`;
                    ui.wsStatus.className = 'text-orange-500 font-mono text-xs border-l border-gray-700 pl-3 ml-1 tracking-widest animate-pulse';
                    setTimeout(connectWS, 3000);
                };
            }

            function handleMessage(msg) {
                if (msg.sessionMode) {
                    if (currentSessionMode !== msg.sessionMode) {
                        currentSessionMode = msg.sessionMode;
                        renderHeaders();
                    }
                }

                if (msg.type === 'full_state') {
                    if (msg.session && Object.keys(msg.session).length > 0) {
                        renderSession(msg.session);
                    } else {
                        ui.sessionName.textContent = `<%= __('live.no_active_session') %>`;
                    }

                    if (msg.lapCount) renderLapCount(msg.lapCount);

                    if (msg.weather && Object.keys(msg.weather).length > 0) {
                        renderWeather(msg.weather);
                    } else {
                        renderDefaultWeather();
                    }

                    if (msg.standings && msg.standings.length > 0) {
                        renderStandings(msg.standings);
                    } else {
                        renderEmptyStandings();
                    }

                    if (msg.raceControl && msg.raceControl.length > 0) {
                        renderRaceControl(msg.raceControl);
                    } else {
                        ui.raceControl.innerHTML = '<div class="text-center text-gray-600 text-[8px] md:text-sm py-4 italic"><%= __('live.no_messages_yet') %></div>';
                    }

                    if (msg.teamRadio && msg.teamRadio.length > 0) {
                        renderRadios(msg.teamRadio);
                    } else {
                        ui.radio.innerHTML = '<div class="text-center text-gray-600 text-[8px] md:text-sm py-4 italic"><%= __('live.no_radios_yet') %></div>';
                    }
                } else if (msg.type === 'session') {
                    renderSession(msg.data);
                } else if (msg.type === 'lap_count') {
                    renderLapCount(msg.data);
                } else if (msg.type === 'weather') {
                    renderWeather(msg.data);
                } else if (msg.type === 'standings') {
                    renderStandings(msg.data);
                } else if (msg.type === 'race_control') {
                    renderRaceControl(msg.data);
                } else if (msg.type === 'team_radio') {
                    renderRadios(msg.data);
                }
            }

            let sessionPath = '';

            function renderSession(data) {
                if (!data) return;
                if (data.Path) sessionPath = data.Path;
                if (data.Name) {
                    const meetingName = data.Meeting ? `${data.Meeting.Name} - ` : '';
                    ui.sessionName.textContent = `${meetingName}${data.Name}`.toUpperCase();
                } else {
                    ui.sessionName.textContent = `<%= __('live.no_active_session') %>`;
                }

                if (data.Meeting && data.Meeting.Country && data.Meeting.Country.Name) {
                    const countryName = data.Meeting.Country.Name.toLowerCase().replace(/ /g, '-');
                    const flagImg = document.getElementById('session-flag');
                    if (flagImg) {
                        flagImg.src = `/img/countryFlags/${countryName}.svg`;
                        flagImg.classList.remove('hidden');
                    }
                }
            }

            function renderLapCount(data) {
                if (!data || !data.CurrentLap) return;
                ui.sessionLaps.textContent = `<%= __('live.lap') %> ${data.CurrentLap} / ${data.TotalLaps || '--'}`;
            }

            function renderWeather(data) {
                if (!data) return;
                if (data.AirTemp !== undefined) ui.wAir.textContent = `${data.AirTemp}°C`;
                if (data.TrackTemp !== undefined) ui.wTrack.textContent = `${data.TrackTemp}°C`;
                if (data.WindSpeed !== undefined) ui.wWind.textContent = `${data.WindSpeed} m/s`;
                if (data.Rainfall !== undefined) ui.wRain.textContent = data.Rainfall === '1' ? `<%= __('live.yes') %>` : `<%= __('live.no') %>`;
            }

            function renderDefaultWeather() {
                ui.wAir.textContent = '--°C';
                ui.wTrack.textContent = '--°C';
                ui.wWind.textContent = '-- m/s';
                ui.wRain.textContent = '--';
            }

            function renderEmptyStandings() {
                ui.standings.innerHTML = `
                    <div class="text-center text-gray-500 py-16 flex flex-col items-center justify-center gap-2">
                        <svg class="w-10 h-10 text-gray-600 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        <span class="font-bold text-gray-400"><%= __('live.no_live_session') %></span>
                        <span class="text-xs text-gray-600 font-mono"><%= __('live.waiting_next_session') %></span>
                    </div>`;
            }

            function renderRaceControl(messages) {
                if (!messages || messages.length === 0) return;

                // Keep the most recent at the top
                const reversed = [...messages].reverse();
                let html = '';

                reversed.forEach((msg) => {
                    let flagColor = 'bg-s-<%= theme %>';
                    if (msg.Flag === 'YELLOW' || msg.Flag === 'DOUBLE YELLOW') flagColor = 'bg-yellow-300 border-yellow-300 text-black';
                    if (msg.Flag === 'RED') flagColor = 'bg-red-600 border-red-600';
                    if (msg.Flag === 'GREEN' || msg.Flag === 'CLEAR') flagColor = 'bg-green-500 border-green-500';
                    if (msg.Category === 'SafetyCar') flagColor = 'border-2 border-yellow-300';
                    if (msg.Flag === 'CHEQUERED') flagColor = 'bg-white border-black text-black';
                    if (msg.Flag === 'BLUE') flagColor = 'bg-blue-500 border-blue-500';
                    if (msg.Category === 'Other') flagColor = 'bg-stewardsbg text-stewardstxt';

                    html += `
                    <div class="p-3 rounded-xl ${flagColor} text-[8px] md:text-sm">
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-xs font-black uppercase tracking-widest">${msg.Category}</span>
                            <span class="text-xs font-mono">${new Date(msg.Utc.endsWith('Z') ? msg.Utc : msg.Utc + 'Z').toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
                        </div>
                        <div class="font-medium">${msg.Message}</div>
                    </div>`;
                });
                ui.raceControl.innerHTML = html;
            }

            function renderRadios(captures) {
                if (!captures || captures.length === 0) return;

                // Clear initial skeleton loader if present
                if (ui.radio.querySelector('.animate-pulse')) {
                    ui.radio.innerHTML = '';
                }

                captures.forEach((cap) => {
                    const audioPath = cap.Path || cap.Url || cap.url;
                    if (!audioPath) return; // Skip if no path is provided

                    // Construct URL (F1 usually sends relative path)
                    let fullUrl = audioPath;
                    if (!audioPath.startsWith('http')) {
                        let cleanPath = audioPath.replace(/^\//, '');
                        // Audio is under /static/ + session path (ex: 2024/2024-05-26_Race/)
                        let basePath = 'static/';
                        if (sessionPath) {
                            basePath += sessionPath.replace(/^\//, '').replace(/\/$/, '') + '/';
                        }

                        if (cleanPath.startsWith(sessionPath.replace(/^\//, ''))) {
                            fullUrl = `https://livetiming.formula1.com/static/${cleanPath}`;
                        } else {
                            fullUrl = `https://livetiming.formula1.com/${basePath}${cleanPath}`;
                        }
                    }

                    if (!knownRadios.has(fullUrl)) {
                        knownRadios.add(fullUrl);

                        const driverText = cap.driverCode || cap.RacingNumber || `<%= __('live.radio_fallback') %>`;
                        const driverFullText = cap.driverFullName || driverText;
                        const teamColor = cap.teamColor || '808080';

                        const el = document.createElement('div');
                        el.className = 'p-3 rounded-xl flex flex-col gap-2 border-l-4 shadow-sm transition-all hover:brightness-110';
                        el.style.borderLeftColor = `#${teamColor}`;
                        el.style.backgroundColor = `#${teamColor}30`;

                        el.innerHTML = `
                            <div class="flex justify-between items-center">
                                <span class="text-[8px] md:text-sm font-black text-white tracking-widest">
                                    <span class="md:hidden">${driverText}</span>
                                    <span class="hidden md:inline">${driverFullText}</span>
                                </span>
                                <span class="text-xs text-gray-300 font-mono">${new Date(cap.Utc.endsWith('Z') ? cap.Utc : cap.Utc + 'Z').toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
                            </div>
                            <audio preload="none" controls src="${fullUrl}" class="w-full h-8 outline-none mt-1 opacity-80 hover:opacity-100 transition-opacity"></audio>
                        `;
                        // Insert at top
                        if (ui.radio.firstChild && ui.radio.firstChild.className !== 'text-center text-gray-600 text-[8px] md:text-sm py-4 italic') {
                            ui.radio.insertBefore(el, ui.radio.firstChild);
                        } else {
                            ui.radio.innerHTML = '';
                            ui.radio.appendChild(el);
                        }
                    }
                });
            }

            function renderStandings(standings) {
                if (!standings || standings.length === 0) {
                    renderEmptyStandings();
                    return;
                }

                if (ui.standings.querySelector('svg') || ui.standings.querySelector('.animate-pulse')) {
                    ui.standings.innerHTML = '';
                }

                // FLIP Phase 1: First
                const oldPositions = new Map();
                [...ui.standings.children].forEach(child => {
                    if (child.id) {
                        oldPositions.set(child.id, child.getBoundingClientRect().top);
                    }
                });

                const currentNodes = new Map();
                [...ui.standings.children].forEach(child => {
                    if (child.id) {
                        currentNodes.set(child.id, child);
                    }
                });

                standings.forEach((driver) => {
                    const rowId = `driver-row-${driver.racingNumber}`;
                    const isPitBadge = driver.inPit ? '<span class="bg-blue-900/40 text-blue-400 text-[10px] px-2.5 py-0.5 rounded-md border border-blue-700/50 uppercase font-black"><%= __('live.pit') %></span>' : '';
                    let statusHtml = '';
                    let posColor = 'text-gray-400';
                    let rowBg = 'bg-s-<%= theme %>/50';
                    let rowBorder = 'border-gray-700/50';

                    if (driver.retired || driver.stopped) {
                        statusHtml = '<span class="text-red-500 text-xs font-black uppercase tracking-widest"><%= __('live.out') %></span>';
                        posColor = 'text-gray-600';
                        rowBg = 'bg-red-950/10';
                        rowBorder = 'border-red-900/20';
                    } else {
                        if (currentSessionMode === 'practice') {
                            statusHtml = driver.position === 1 ? '<span class="text-purple-400 font-black tracking-widest"><%= __('live.leader') %></span>' : (driver.gapToLeader || '--');
                        } else {
                            if (driver.position === 1) {
                                statusHtml = '<span class="text-yellow-500 font-black tracking-widest"><%= __('live.leader') %></span>';
                            } else {
                                let intHtml = driver.interval || '';
                                let gapHtml = driver.gapToLeader || '';
                                statusHtml = intHtml ? `${intHtml}` : gapHtml;
                            }
                        }

                        if (driver.hasFastestLap) {
                            posColor = 'text-purple-400';
                            rowBg = 'bg-purple-900/20';
                            rowBorder = 'border-purple-500/40';
                        } else if (driver.position === 1) {
                            posColor = 'text-yellow-500';
                        }
                    }

                    let tireHtml = driver.currentTire && driver.currentTire !== 'unknown' ? `<img src="/img/tires/${driver.currentTire}.svg" class="w-6 h-6 drop-shadow-md" alt="${driver.currentTire}" onerror="this.style.display='none'">` : '';
                    if (currentSessionMode === 'practice' && driver.inPit) {
                        tireHtml = isPitBadge;
                    }

                    let trendHtml = '';
                    if (driver.trend === 'up') {
                        trendHtml = '<img src="/img/live/arrow-up.png" class="w-3 h-3 ml-1 animate-pulse" alt="<%= __('live.up') %>">';
                    } else if (driver.trend === 'down') {
                        trendHtml = '<img src="/img/live/arrow-down.png" class="w-3 h-3 ml-1 animate-pulse" alt="<%= __('live.down') %>">';
                    }

                    let centerColHtml = '';
                    if (currentSessionMode === 'practice') {
                        centerColHtml = `
                        <div class="col-span-4 text-[11px] font-mono text-gray-400 flex flex-col items-center justify-center gap-0.5">
                            <span><span class="text-gray-600"><%= __('live.last_lap_short') %></span> ${driver.lastLap || '--'}</span>
                            <span><span class="text-gray-600"><%= __('live.best_lap_short') %></span> ${driver.bestLap || '--'}</span>
                        </div>
                        `;
                    } else {
                        centerColHtml = `
                        <div class="col-span-4 md:col-span-3 text-[11px] font-mono text-gray-400 flex flex-col items-center justify-center gap-0.5">
                            <span><span class="text-gray-600"><%= __('live.last_lap_short') %></span> ${driver.lastLap || '--'}</span>
                            <span><span class="text-gray-600"><%= __('live.best_lap_short') %></span> ${driver.bestLap || '--'}</span>
                        </div>
                        `;
                    }

                    let rightColHtml = '';
                    if (currentSessionMode === 'practice' && !driver.retired && !driver.stopped) {
                        rightColHtml = `
                        <div class="col-span-4 text-right font-mono flex flex-col items-end">
                            <span class="text-[8px] md:text-sm text-gray-200 font-bold">${driver.bestLap || '--'}</span>
                            <span class="text-[11px] text-gray-500">${statusHtml}</span>
                        </div>`;
                    } else {
                        rightColHtml = `
                        <div class="col-span-2 font-mono text-[8px] md:text-sm text-gray-300 font-medium flex items-center text-center justify-center">
                            ${statusHtml}
                        </div>`;
                    }

                    const pitColumnHtml = driver.inPit ? isPitBadge : `<span class="text-gray-400 text-[8px] md:text-sm font-mono font-bold">${driver.pits || 0}</span>`;

                    const innerHtml = `
                        <div class="col-span-1 text-center font-mono text-[10px] md:text-lg font-black ${posColor} flex items-center justify-center relative">
                            ${String(driver.position).padStart(2, '0')} ${trendHtml}
                        </div>
                        <div class="col-span-2 font-bold flex items-center">
                            <span class="px-2.5 py-0.5 rounded text-white text-[8px] md:text-sm font-black border-l-4" style="border-left-color: #${driver.teamColor}; background-color: #${driver.teamColor}40;">
                                <span class="md:hidden">${driver.driverCode}</span>
                                <span class="hidden md:inline">${driver.driverFullName || driver.driverCode}</span>
                            </span>
                        </div>
                        ${centerColHtml}
                        <div class="col-span-1 flex justify-center">
                            ${tireHtml}
                        </div>
                        ${currentSessionMode === 'race' ? `<div class="col-span-2 flex justify-center items-center">${pitColumnHtml}</div>` : ''}
                        ${rightColHtml}
                    `;

                    let rowEl = currentNodes.get(rowId);
                    const className = `grid grid-cols-12 gap-2 items-center px-2 py-1 ${rowBg} hover:bg-s-<%= theme %> rounded-lg transition-all border ${rowBorder}`;

                    if (!rowEl) {
                        rowEl = document.createElement('div');
                        rowEl.id = rowId;
                        rowEl.className = className;
                        rowEl.innerHTML = innerHtml;
                    } else {
                        // Diff the html to avoid unnecessary DOM repaints inside the row?
                        // innerHTML assignment is very fast, but to be completely safe, we just assign it.
                        rowEl.className = className;
                        rowEl.innerHTML = innerHtml;
                    }
                    ui.standings.appendChild(rowEl);
                });

                // Remove stale nodes
                const validIds = new Set(standings.map(d => `driver-row-${d.racingNumber}`));
                [...ui.standings.children].forEach(child => {
                    if (child.id && !validIds.has(child.id)) {
                        child.remove();
                    }
                });

                // FLIP Phase 2: Invert & Play
                requestAnimationFrame(() => {
                    [...ui.standings.children].forEach(child => {
                        if (child.id) {
                            const oldTop = oldPositions.get(child.id);
                            if (oldTop !== undefined) {
                                const newTop = child.getBoundingClientRect().top;
                                const deltaY = oldTop - newTop;

                                if (deltaY !== 0) {
                                    // Invert
                                    child.style.transform = `translateY(${deltaY}px)`;
                                    child.style.transition = 'none';

                                    // Force reflow
                                    child.getBoundingClientRect();

                                    // Play
                                    child.style.transform = 'translateY(0)';
                                    child.style.transition = 'transform 0.5s cubic-bezier(0.4, 0, 0.2, 1)';

                                    // Cleanup inline styles to restore tailwind transitions
                                    setTimeout(() => {
                                        child.style.transform = '';
                                        child.style.transition = '';
                                    }, 500);
                                }
                            }
                        }
                    });
                });
            }

            connectWS();
        </script>
</body>

</html>