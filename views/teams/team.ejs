<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">

<head>
    <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
            <title>PLI - <%= teamFront.name %>
            </title>
</head>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <main>
        <div class="pt-10 px-4 sm:px-8 h-auto flex flex-col justify-center">
            <div class="bg-s-<%= theme %> p-4 rounded-3xl mx-auto max-w-sm sm:max-w-xl h-2/3">
                <div class="text-center">
                    <h1 class="text-lg font-F1Bold mb-2">
                        <%= teamFront.fullName %>
                    </h1>
                </div>

                <div class="flex justify-center">
                    <img src="/img/teams/<%= teamFront.constructorId %>.webp" alt="<%= teamFront.constructorId %>"
                        class="h-20 w-auto">
                </div>

                <div class="text-center">
                    <% if(teamFront.totalChampionshipWins !==0) { %>
                        <span class="grid grid-cols-12 mt-4">
                            <span class="col-span-12 flex flex-col items-center">
                                <span class="text-gold">
                                    <%= teamFront.totalChampionshipWins %>
                                </span>
                                <span class="text-t-s-<%= theme %> text-xs">
                                    <%= __('team.totalChampionshipWins') %>
                                </span>
                            </span>
                        </span>
                        <% } %>

                            <span class="grid grid-cols-12 mt-4">
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= teamFront.firstYear %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs">
                                        <%= __('team.team_start') %>
                                    </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= teamFront.numberOfSeasons %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs">
                                        <%= __('team.number_of_seasons') %>
                                    </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= teamFront.totalRaceStarts %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs">
                                        <%= __('team.total_races') %>
                                    </span>
                                </span>
                            </span>

                            <span class="grid grid-cols-12 mt-4">
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= teamFront.totalRaceWins %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs">
                                        <%= __('team.total_wins') %>
                                    </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= teamFront.totalPodiumRaces %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs">
                                        <%= __('team.total_podiums') %>
                                    </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= teamFront.totalPolePositions %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs">
                                        <%= __('team.total_poles') %>
                                    </span>
                                </span>
                            </span>

                            <span class="grid grid-cols-12 mt-4">
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= teamFront.totalChampionshipPoints %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs">
                                        <%= __('team.total_points') %>
                                    </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= teamFront.totalFastestLaps %>
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs">
                                        <%= __('team.total_fastest_laps') %>
                                    </span>
                                </span>
                            </span>

                            <span class="grid grid-cols-12 mt-4">
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= teamFront.victoryRatio %>%
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs">
                                        <%= __('team.victory_ratio') %>
                                    </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= teamFront.podiumRatio %>%
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs">
                                        <%= __('team.podium_ratio') %>
                                    </span>
                                </span>
                                <span class="col-span-4 flex flex-col">
                                    <span>
                                        <%= teamFront.poleRatio %>%
                                    </span>
                                    <span class="text-t-s-<%= theme %> text-xs">
                                        <%= __('team.pole_ratio') %>
                                    </span>
                                </span>
                            </span>

                            <% if (teamFront.currentSeasonTeam !==false) { %>
                                <div class="my-4">
                                    <h3 class="font-bold">
                                        <%= __('team.drivers') %> :
                                    </h3>
                                    <% teamFront.currentDrivers.forEach(function(driver){ %>
                                        <div class="flex items-center justify-center">
                                            <img src="/img/countryFlags/<%= driver.nationality %>.svg"
                                                alt="<%= driver.nationality %>" class="w-5 h-auto mr-2">
                                            <a href="/driver/<%= driver.id %>">
                                                <p>
                                                    <%= driver.firstName %>
                                                        <%= driver.lastName %> -
                                                            <% if (driver.permanentNumber==33) { %>
                                                                <%= 1 %>
                                                                    <% } else { %>
                                                                        <%= driver.permanentNumber %>
                                                                            <% } %>
                                                </p>
                                            </a>
                                        </div>
                                        <% }) %>
                                </div>
                                <div class="text-center mt-4">
                                    <h3 class="text-base sm:text-lg font-bold">
                                        <%= __('team.single_seater') %>:
                                    </h3>
                                    <p class="text-t-s-<%= theme %> mt-2">
                                        <%= teamFront.currentCarName %>
                                    </p>
                                    <span class="flex justify-center mt-2">
                                        <img src="https://ik.imagekit.io/pitlaneinsider/cars/<%= teamFront.currentCarId %>.webp"
                                            alt="<%= teamFront.currentCarName %>" class="w-2/3 h-auto">
                                    </span>
                                </div>
                                <% } %>
                </div>
            </div>
        </div>
    </main>
    <%- include('../partials/footer.ejs') %>
</body>

</html>