<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head.ejs') %>
        <%- include('partials/header.ejs') %>
            <title>PLI - <%= dataDriver.firstName %>
                    <%= dataDriver.lastName %>
            </title>
</head>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <div class="pt-10 px-4 h-auto flex flex-col justify-center">
        <div class="bg-s-<%= theme %> p-4 sm:p-8 rounded-3xl mx-auto max-w-sm sm:max-w-xl h-2/3">
            <div class="flex flex-row justify-between">
                <% if(dataDriver.currentSeasonDriver===true) { %>
                    <div class="flex flex-col items-center w-1/2">
                        <img src="/img/drivers/<%= dataDriver.id %>.webp"
                            alt="<%= dataDriver.firstName %> <%= dataDriver.lastName %>" class="h-32 w-auto mb-0">
                        <div class="bg-main-color text-white p-2 sm:p-4 shadow-md mt-0">
                            <p class="text-base sm:text-lg font-F1Bold">
                                <%= __('driver.actual_season') %>
                            </p>
                            <p class="text-sm sm:text-base">
                                <%= __('driver.races') %>: <%= dataDriver.numberOfRacesCurrentSeason %>
                            </p>
                            <p class="text-sm sm:text-base">
                                <%= __('driver.points') %>: <%= dataDriver.numberOfPointsCurrentSeason %>
                            </p>
                            <p class="text-sm sm:text-base">
                                <%= __('driver.podiums') %>: <%= dataDriver.numberOfPodiumsCurrentSeason %>
                            </p>
                            <p class="text-sm sm:text-base">
                                <%= __('driver.victories') %>: <%= dataDriver.numberOfWinsCurrentSeason %>
                            </p>
                        </div>
                    </div>
                    <div class="flex flex-col justify-center w-1/2">
                        <h1 class="text-lg sm:text-xl font-semibold text-center">
                            <%= dataDriver.firstName %>
                                <%= dataDriver.lastName %>
                        </h1>
                        <p class="text-sm sm:text-base text-t-s-<%= theme %> text-center">
                            <% if (dataDriver.dateOfDeath===null) { %>
                                <span>
                                    <%= dataDriver.dateOfBirth %> (<%= dataDriver.age %>
                                            <%= __('driver.age') %>)
                                </span>
                                <% } else { %>
                                    <span>
                                        <%= dataDriver.dateOfBirth %>
                                    </span>
                                    <span>
                                        <%= dataDriver.dateOfDeath %> (<%= dataDriver.age %>
                                                <%= __('driver.age') %>)
                                    </span>
                                    <% } %>
                        </p>
                        <div class="grid grid-cols-2 grid-rows-2 gap-x-4 justify-center items-center mt-16">
                            <div class="flex items-center justify-center">
                                <p class="text-<%= dataDriver.actualTeam %> text-4xl sm:text-5xl">
                                    <%= dataDriver.permanentNumber %>
                                </p>
                            </div>
                            <div class="flex items-center justify-center">
                                <img src="/img/teams/<%= dataDriver.actualTeam.toLowerCase() %>.webp"
                                    alt="<%= dataDriver.actualTeam %>" class="w-24 h-auto">
                            </div>
                            <div class="flex items-center justify-center">
                                <img src="/img/countryFlags/<%= dataDriver.nationality.toLowerCase() %>.svg"
                                    alt="<%= dataDriver.nationality %>.svg" class="w-12 h-auto">
                            </div>
                            <div class="flex items-center justify-center">
                                <img src="/img/2024/logo_pilote/<%= dataDriver.id %>-logo.webp"
                                    alt=" Logo of <%= dataDriver.firstName %> <%= dataDriver.lastName %>"
                                    class="w-20 h-auto">
                            </div>
                        </div>
                    </div>
                    <% } else { %>
                        <div class="flex flex-row justify-between">
                            <div class="flex flex-col justify-center">
                                <img src="/img/drivers/<%= dataDriver.id %>.webp"
                                    alt="<%= dataDriver.firstName %> <%= dataDriver.lastName %>"
                                    class="h-32 w-auto mb-0">
                            </div>
                            <div class="flex flex-col justify-center w-1/2">
                                <h1 class="text-lg sm:text-xl font-semibold text-center">
                                    <%= dataDriver.firstName %>
                                        <%= dataDriver.lastName %>
                                </h1>
                                <p class="text-sm sm:text-base text-t-s-<%= theme %> text-center">
                                    <% if (dataDriver.dateOfDeath===null) { %>
                                        <span>
                                            <%= dataDriver.dateOfBirth %> (<%= dataDriver.age %>
                                                    <%= __('driver.age') %>)
                                        </span>
                                        <% } else { %>
                                            <span>
                                                <%= dataDriver.dateOfBirth %> -
                                            </span>
                                            <span>
                                                <%= dataDriver.dateOfDeath %> (<%= dataDriver.age %>
                                                        <%= __('driver.age') %>)
                                            </span>
                                            <% } %>
                                </p>
                            </div>
                        </div>
                        <% } %>
            </div>

            <!-- Career Info -->
            <div class="text-center mt-4">
                <h3 class="text-base sm:text-lg font-bold">
                    <%= __('driver.carreer_title') %>:
                </h3>
                <p class="text-sm sm:text-base">
                    <%= __('driver.total_podiums') %>: <%= dataDriver.totalPodiums %>
                </p>
                <p class="text-sm sm:text-base">
                    <%= __('driver.total_victories') %>: <%= dataDriver.totalRaceWins %>
                </p>
                <p class="text-sm sm:text-base">
                    <%= __('driver.total_races') %>: <%= dataDriver.totalRaceStarts %>
                </p>
                <p class="text-sm sm:text-base">
                    <%= __('driver.total_points') %>: <%= dataDriver.totalPoints %>
                </p>
                <p class="text-sm sm:text-base">
                    <%= __('driver.total_poles') %>: <%= dataDriver.totalPolePositions %>
                </p>
            </div>

            <% if(dataDriver.allVictories !==null) { %>

                <div class="text-center mt-4">
                    <h3 class="text-base sm:text-lg font-bold">
                        <%= __('driver.victories_title') %>:
                    </h3>

                    <% for(const year in dataDriver.allVictories) { %>
                        <div class="mt-6">
                            <p class="text-xl">
                                <%= year %>
                            </p>
                            <% (dataDriver.allVictories[year]).forEach(function(victory) { %>

                                <div class="flex justify-center items-center mt-2">
                                    <div class="flex items-center">
                                        <p class="text-sm sm:text-base ml-2">
                                            <%= victory %>
                                        </p>
                                    </div>
                                </div>

                                <% }); %>
                        </div>
                        <% }; %>

                </div>

                <% } %>

        </div>
    </div>
    <%- include("partials/footer.ejs") %>
</body>

</html>