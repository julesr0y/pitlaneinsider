<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head.ejs') %>
        <%- include('partials/header.ejs') %>
            <title>PLI - <%= __('account.profile_edit.tab_title') %>
            </title>
</head>

<body class="font-F1Bold">
    <span class="flex justify-center text-center pt-4">
        <%= __('account.profile_edit.edit_title') %>
    </span>
    <div class="flex items-center justify-center">
        <form class="px-10 py-4 rounded-lg w-full max-w-sm" action="/profilEditProcess" method="post">
            <div class="grid gap-4 mb-4">
                <input type="email" name="email" placeholder="<%= __('account.profile_edit.email') %>"
                    class="input-bg px-4 py-2 rounded-3xl shadow-sm w-full bg-gray-200"
                    value="<%= userInfosFront.email %>" required>
                <input type="text" name="nom" placeholder="<%= __('account.profile_edit.name') %>"
                    class="input-bg px-4 py-2 rounded-3xl shadow-sm bg-gray-200" value="<%= userInfosFront.nom %>"
                    required>
                <input type="text" name="prenom" placeholder="<%= __('account.profile_edit.surname') %>"
                    class="input-bg px-4 py-2 rounded-3xl shadow-sm bg-gray-200" value="<%= userInfosFront.prenom %>"
                    required>
                <input type="text" name="username" placeholder="<%= __('account.profile_edit.username') %>"
                    class="input-bg px-4 py-2 rounded-3xl shadow-sm w-full bg-gray-200"
                    value="<%= userInfosFront.username %>" required>
                <input type="date" name="naissance" placeholder="<%= __('account.profile_edit.birthdate') %>"
                    class="input-bg px-4 py-2 rounded-3xl shadow-sm w-full bg-gray-200"
                    value="<%= new Date(userInfosFront.naissance.getTime() - userInfosFront.naissance.getTimezoneOffset() * 60000).toISOString().split('T')[0] %>"
                    required>
                <select name="language" id="<%= __('account.profile_edit.lang') %>"
                    class="input-bg px-4 py-2 rounded-3xl shadow-sm w-full bg-gray-200" placeholder="Langue" required>
                    <option value="en" <%=userInfosFront.language==='en' ? 'selected' : '' %>><%=
                            __('account.profile_edit.languages.en') %>
                    </option>
                    <option value="fr" <%=userInfosFront.language==='fr' ? 'selected' : '' %>><%=
                            __('account.profile_edit.languages.fr') %>
                    </option>
                    <option value="fr" <%=userInfosFront.language==='es' ? 'selected' : '' %>><%=
                            __('account.profile_edit.languages.es') %>
                    </option>
                    <option value="fr" <%=userInfosFront.language==='de' ? 'selected' : '' %>><%=
                            __('account.profile_edit.languages.de') %>
                    </option>
                    <option value="fr" <%=userInfosFront.language==='it' ? 'selected' : '' %>><%=
                            __('account.profile_edit.languages.it') %>
                    </option>
                </select>
            </div>
            <div class="flex items-center justify-between mb-4">
                <button type="submit" class="px-4 py-2 bg-main-color text-white font-semibold rounded-3xl w-full mr-2">
                    <%= __('account.profile_edit.btn_save') %>
                </button>
            </div>
        </form>
    </div>
    <%- include('partials/footer.ejs') %>
</body>

</html>