<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <link rel="canonical" href="https://pitlaneinsider.fr/" />
        <meta name="description" content="Everything about F1" />
        <%- include('../partials/header.ejs') %>
        <title>PitLane Insider</title>
        <style>
            @keyframes slideUpDown {
                0% {
                    transform: translateY(-50%);
                    opacity: 0;
                }

                100% {
                    transform: translateY(0);
                    opacity: 1;
                }
            }

            .animation-slide {
                animation: slideUpDown 0.5s ease-in-out;
            }

            .gold {
                background-color: gold;
            }

            .silver {
                background-color: silver;
            }

            .bronze {
                background-color: #cd7f32;
            }
        </style>
    </head>

    <body class="font-regular text-<%= theme %> flex flex-col min-h-screen">
        <main class="bg-b-<%= theme %> grow">
            <div class="next text-center text-white bg-black py-2">
                <h1>
                    <div class="flex items-center justify-center gap-1">
                        <span>
                            <%= __('home.next_race') %>
                        </span>
                        <span>-</span>
                        <span id="race-location"> <%= __('home.loading') %> </span>
                        <span></span>
                        <span id="flag"></span>
                    </div>
                    <div id="countdown" class="flex justify-center mt-4">
                        <div class="flex flex-col items-center mx-2">
                            <span class="text-sm text-center mb-1"> <%= __('home.days') %> </span>
                            <span id="days" class="inline-block w-12 text-center text-2xl">00</span>
                        </div>
                        <div class="flex flex-col items-center mx-2">
                            <span class="text-sm text-center mb-1"> <%= __('home.hours') %> </span>
                            <span id="hours" class="inline-block w-12 text-center text-2xl">00</span>
                        </div>
                        <div class="flex flex-col items-center mx-2">
                            <span class="text-sm text-center mb-1"> <%= __('home.minutes') %> </span>
                            <span id="minutes" class="inline-block w-12 text-center text-2xl">00</span>
                        </div>
                        <div class="flex flex-col items-center mx-2">
                            <span class="text-sm text-center mb-1"> <%= __('home.seconds') %> </span>
                            <span id="seconds" class="inline-block w-12 text-center text-2xl">00</span>
                        </div>
                    </div>
                </h1>
            </div>

            <div class="px-4 pt-4">
                <div class="block md:grid grid-cols-2 gap-4 items-stretch">
                    <div class="w-full h-full">
                        <div id="championnats" class="flex gap-4 w-full">
                            <a href="/driver/<%= homeData[0].driverLeader.driverId %>" class="w-full">
                                <div id="chPilotes" class="h-36 bg-s-<%= theme %> flex flex-col justify-center items-center font-bold rounded-3xl overflow-hidden">
                                    <span class="text-center pt-2"> <%= __('home.drivers_championship') %> </span>
                                    <span class="flex justify-evenly items-center mt-auto gap-2">
                                        <span class="flex flex-col items-center text-xl">
                                            <span>
                                                <%= homeData[0].driverLeader.abbreviation %>
                                            </span>
                                            <span class="text-<%= homeData[0].driverLeader.constructorId %>"> <% if(homeData[0].driverLeader.permanentNumber==33) { %> <%= 1 %> <% } else { %> <%= homeData[0].driverLeader.permanentNumber %> <% } %> </span>
                                        </span>
                                        <img src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= homeData[0].driverLeader.driverId %>.webp" class="h-20 md:h-24 w-auto" />
                                    </span>
                                </div>
                            </a>

                            <a href="/constructor/<%= homeData[0].constructorLeader.constructorId %>" class="w-full">
                                <div id="chContructeurs" class="h-36 bg-s-<%= theme %> flex flex-col items-center rounded-3xl">
                                    <span class="text-center font-bold pt-2"> <%= __('home.constructors_championship') %> </span>
                                    <span>
                                        <img src="/img/constructors/<%= homeData[0].constructorLeader.constructorId %>.webp" class="h-12 md:h-16 w-auto mt-5" />
                                    </span>
                                </div>
                            </a>
                        </div>

                        <a href="/retrogpdetails/2025/<%= homeData[0].lastPodiumLocalisation[0].raceId %>">
                            <div class="w-full bg-s-<%= theme %> mt-4 rounded-3xl overflow-hidden">
                                <span class="flex justify-center text-center mb-4 font-bold gap-2 pt-2">
                                    <%= __('home.last_race') %> - <%= homeData[0].lastPodiumLocalisation[0].name %>
                                    <img src="/img/countryFlags/<%= homeData[0].lastPodiumLocalisation[0].country %>.svg" alt="<%= homeData[0].lastPodiumLocalisation[0].country %>" class="h-6 w-auto" />
                                </span>
                                <div class="flex justify-evenly items-end h-full">
                                    <div class="flex flex-col items-center">
                                        <img src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= homeData[0].lastPodium[1].driverId %>.webp" class="h-20 md:h-24 w-auto" />
                                        <div class="w-24 h-24 silver rounded-t-lg flex flex-col items-center justify-center">
                                            <span class="text-lg font-bold">2</span>
                                            <span class="text-sm font-bold mt-2"> <%= homeData[0].lastPodium[1].abbreviation %> </span>
                                        </div>
                                    </div>
                                    <div class="flex flex-col items-center">
                                        <img src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= homeData[0].lastPodium[0].driverId %>.webp" class="h-20 md:h-24 w-auto" />
                                        <div class="w-24 h-32 gold rounded-t-lg flex flex-col items-center justify-center">
                                            <span class="text-lg font-bold">1</span>
                                            <span class="text-sm font-bold mt-2"> <%= homeData[0].lastPodium[0].abbreviation %> </span>
                                        </div>
                                    </div>
                                    <div class="flex flex-col items-center">
                                        <img src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= homeData[0].lastPodium[2].driverId %>.webp" class="h-20 md:h-24 w-auto" />
                                        <div class="w-24 h-20 bronze rounded-t-lg flex flex-col items-center justify-center">
                                            <span class="text-lg font-bold">3</span>
                                            <span class="text-sm font-bold mt-2"> <%= homeData[0].lastPodium[2].abbreviation %> </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="bg-s-<%= theme %> hidden md:flex flex-col justify-between items-center font-bold rounded-3xl w-full h-full py-2">
                        <a href="">News</a>
                        <table>
                            <% newsFront.forEach(function(article) { %>
                            <tr class="border-b-2">
                                <td>
                                    <a href="<%= article.link %>" target="_blank">
                                        <div class="pt-2 px-4">
                                            <p class="text-xs text-t-s-<%= theme %> font-bold"><%= article.pubDate %></p>
                                            <h2 class="text-md font-bold mb-2 pt-4"><%= article.title %></h2>
                                        </div>
                                    </a>
                                </td>
                            </tr>
                            <% }); %>
                        </table>
                        <div class="grow flex items-center justify-center w-full">
                            <a href="https://motorsport.com/" target="_blank">
                                <img src="/img/assets/motorsport.png" alt="motorsport.com" class="h-12 w-auto" />
                            </a>
                        </div>
                    </div>
                </div>

                <div class="bg-s-<%= theme %> md:hidden flex flex-col justify-center items-center font-bold rounded-3xl w-full h-full mt-4 px-2 pt-2 pb-6">
                    <a href="">News</a>
                    <table>
                        <% newsFront.forEach(function(article) { %>
                        <tr class="border-b-2">
                            <td>
                                <a href="<%= article.link %>" target="_blank">
                                    <div class="pt-2 px-4">
                                        <p class="text-xs text-t-s-<%= theme %> font-bold"><%= article.pubDate %></p>
                                        <h2 class="text-md font-bold mb-2 pt-4"><%= article.title %></h2>
                                    </div>
                                </a>
                            </td>
                        </tr>
                        <% }); %>
                    </table>
                </div>

                <div class="flex flex-col md:flex-row gap-y-1 gap-x-4">
                    <div class="w-full bg-s-<%= theme %> mt-4 py-2 rounded-3xl">
                        <a href="/driverstandings" class="flex justify-center text-center font-bold"> <%= __('home.drivers_standings') %> </a>
                        <span class="flex justify-evenly">
                            <table>
                                <% homeData[0].driverStandings.slice(0, 10).forEach(function(pilote) { %>
                                <tr>
                                    <td class="pr-2">
                                        <span class="border-2 border-<%= pilote.constructorId %> h-auto w-1 box-border bg-<%= pilote.constructorId %> rounded-3xl"> </span>
                                    </td>
                                    <td class="font-bold"><%= String(pilote.position).padStart(2, '0' ) %></td>
                                    <td class="px-1">-</td>
                                    <td>
                                        <a href="/driver/<%= pilote.driverId %>"> <%= pilote.lastName %> </a>
                                    </td>
                                </tr>
                                <% }); %>
                            </table>
                            <span class="border border-<%= theme %> h-auto w-0.3 box-border bg-<%= theme %>"></span>
                            <table>
                                <% homeData[0].driverStandings.slice(10, 20).forEach(function(pilote) { %>
                                <tr>
                                    <td class="pr-2">
                                        <span class="border-2 border-<%= pilote.constructorId %> h-auto w-1 box-border bg-<%= pilote.constructorId %> rounded-3xl"> </span>
                                    </td>
                                    <td class="font-bold"><%= String(pilote.position).padStart(2, '0' ) %></td>
                                    <td class="px-1">-</td>
                                    <td>
                                        <a href="/driver/<%= pilote.driverId %>"> <%= pilote.lastName %> </a>
                                    </td>
                                </tr>
                                <% }); %>
                            </table>
                        </span>
                    </div>

                    <div class="w-full bg-s-<%= theme %> mt-4 py-2 rounded-3xl">
                        <a href="/constructorstandings" class="flex justify-center text-center font-bold"> <%= __('home.constructors_standings') %> </a>
                        <span class="flex justify-evenly">
                            <table>
                                <% homeData[0].constructorStandings.slice(0, 10).forEach(function(constructor) { %>
                                <tr>
                                    <td class="pr-2">
                                        <span class="border-2 border-<%= constructor.constructorId %> h-auto w-1 box-border bg-<%= constructor.constructorId %> rounded-3xl"> </span>
                                    </td>
                                    <td class="font-bold"><%= String(constructor.position).padStart(2, '0') %></td>
                                    <td class="px-1">-</td>
                                    <td>
                                        <a href="/constructor/<%= constructor.constructorId %>"> <%= constructor.name %> </a>
                                    </td>
                                </tr>
                                <% }); %>
                            </table>
                        </span>
                    </div>
                </div>

                <div class="block md:grid grid-cols-2 gap-x-4 items-stretch pt-4">
                    <div class="bg-s-<%= theme %> flex md:flex-col items-center font-bold rounded-3xl w-full h-full">
                        <a href="/chassis/<%= homeOTDData[0].chassisOTD[0].chassisId %>" class="w-full">
                            <div id="chPilotes" class="h-48 bg-s-<%= theme %> font-bold rounded-3xl flex flex-col">
                                <span class="text-center pt-2 px-2"> <%= __('home.chassis_otd') %> </span>
                                <span class="flex flex-col md:flex-row justify-evenly items-center mt-auto gap-2 pt-2">
                                    <span class="flex gap-x-2 md:flex-col items-center text-md md:text-xl">
                                        <span><%= homeOTDData[0].chassisOTD[0].constructorFullName %></span>
                                        <span><%= homeOTDData[0].chassisOTD[0].chassisName %></span>
                                    </span>
                                    <img src="https://pitlaneinsider-data.alwaysdata.net/cars_img/<%= homeOTDData[0].chassisOTD[0].chassisId %>.webp" class="h-28 md:h-36 w-auto" />
                                </span>
                            </div>
                        </a>
                    </div>

                    <div class="w-full h-full mt-4 md:mt-0">
                        <div id="championnats" class="flex gap-4 w-full">
                            <a href="/driver/<%= homeOTDData[0].driverOTD[0].driverId %>" class="w-full">
                                <div id="chPilotes" class="h-36 md:h-48 bg-s-<%= theme %> flex flex-col justify-center items-center font-bold rounded-3xl">
                                    <span class="text-center pt-2 px-2"> <%= __('home.driver_otd') %> </span>
                                    <span class="flex justify-evenly items-center mt-auto gap-2">
                                        <img src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= homeOTDData[0].driverOTD[0].driverId %>.webp" class="h-24 md:h-36 w-auto" />
                                    </span>
                                </div>
                            </a>

                            <a href="/constructor/<%= homeOTDData[0].constructorOTD[0].constructorId %>" class="w-full">
                                <div id="chContructeurs" class="h-36 md:h-48 bg-s-<%= theme %> flex flex-col items-center rounded-3xl">
                                    <span class="text-center font-bold pt-2 px-2"> <%= __('home.constructor_otd') %> </span>
                                    <span>
                                        <img src="/img/constructors/<%= homeOTDData[0].constructorOTD[0].constructorId %>.webp" class="h-16 md:h-28 w-auto mt-3 md:mt-6" />
                                    </span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>

    <script>
        function updateNextRaceInfo() {
            document.getElementById('race-location').textContent = '<%= homeData[0].nextRaceInfo[0].name %>';
            const flagElement = document.getElementById('flag');
            flagElement.innerHTML = ''; // Clear any existing flag
            const img = document.createElement('img');
            img.setAttribute('class', 'h-6 w-auto');
            img.setAttribute('src', `/img/countryFlags/${'<%= homeData[0].nextRaceInfo[0].country %>'}.svg`);
            flagElement.appendChild(img);

            // Inclure l'heure de la course dans le démarrage du compte à rebours
            startCountdown('<%= homeData[0].nextRaceInfo[0].raceDate %>', '<%= homeData[0].nextRaceInfo[0].raceTime %>');
        }

        /**
         * @description Démarre le compte à rebours pour la prochaine course
         * @param {string} raceDate
         * @param {string} raceTime
         * @returns {void}
         */
        function startCountdown(raceDate, raceTime) {
            // Convertit la date et l'heure de la course en UTC+2 (heure d'été française)
            const offset = 2; // UTC+2 pour l'heure d'été française
            const raceDateTime = new Date(`${raceDate}T${raceTime}`).getTime();
            const adjustedRaceDateTime = raceDateTime + offset * 60 * 60 * 1000; // Ajuste pour le fuseau horaire français

            let previousDays, previousHours, previousMinutes, previousSeconds;

            function updateCountdown() {
                const now = new Date().getTime();
                const distance = adjustedRaceDateTime - now;

                if (distance < 0) {
                    clearInterval(countdownInterval);
                    document.getElementById('countdown').innerHTML = `<div class="col-span-12 flex justify-evenly items-center gap-2">Session started - <span class="flex gap-1 items-center"><span class="w-4 h-4 rounded-full bg-red-500 animate-pulse inline-block"></span><a href="/live" class="text-red-500">Live</a></span></div>`;
                    return;
                }

                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                if (days !== previousDays) {
                    updateTimeElement('days', days);
                    previousDays = days;
                }
                if (hours !== previousHours) {
                    updateTimeElement('hours', hours);
                    previousHours = hours;
                }
                if (minutes !== previousMinutes) {
                    updateTimeElement('minutes', minutes);
                    previousMinutes = minutes;
                }
                if (seconds !== previousSeconds) {
                    updateTimeElement('seconds', seconds);
                    previousSeconds = seconds;
                }
            }

            function updateTimeElement(id, value) {
                const element = document.getElementById(id);
                element.classList.remove('animation-slide');
                void element.offsetWidth; // Trigger reflow to restart the animation
                element.classList.add('animation-slide');
                element.textContent = String(value).padStart(2, '0');
            }

            const countdownInterval = setInterval(updateCountdown, 1000);
            updateCountdown();
        }

        function convertDate(dateString) {
            var date = new Date(dateString);
            var day = date.getDate();
            var month = date.getMonth() + 1; // Les mois sont indexés à partir de 0 en JavaScript
            return (day < 10 ? '0' : '') + day + '/' + (month < 10 ? '0' : '') + month;
        }

        function convertTime(timeString) {
            var timeParts = timeString.split(':'); // Les heures sont le premier élément, les minutes sont le deuxième
            var hour = timeParts[0];
            var minute = timeParts[1];
            return minute === '00' ? hour + 'h' : hour + 'h' + minute;
        }

        updateNextRaceInfo();
    </script>
</html>
