<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>" class="bg-b-<%= theme %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <style>
            @keyframes slideUpDown {
                0% {
                    transform: translateY(-50%);
                    opacity: 0;
                }

                100% {
                    transform: translateY(0);
                    opacity: 1;
                }
            }

            .animation-slide {
                animation: slideUpDown 0.5s ease-in-out;
            }

            .gold {
                background-color: gold;
            }

            .silver {
                background-color: silver;
            }

            .bronze {
                background-color: #cd7f32;
            }
        </style>
    </head>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %> flex flex-col min-h-screen">
        <main class="bg-b-<%= theme %> grow">
            <div class="px-4 md:pt-4">
                <div class="block md:grid grid-cols-2 gap-4 items-stretch">
                    <div class="bg-s-<%= theme %> flex flex-col justify-between items-center font-bold rounded-3xl w-full h-full py-2 mt-4 md:mt-0 relative overflow-hidden">
                        <% if (homeData.nextRaceInfo) { %>
                        <!-- Circuit Background SVG -->
                        <img src="/img/circuits/<%= homeData.nextRaceInfo.circuitLayoutId %>.svg" class="absolute inset-0 m-auto h-3/4 opacity-10 pointer-events-none" alt="" />

                        <div class="z-10 flex flex-col items-center text-center w-full mt-4">
                            <div class="flex items-center gap-x-3 mb-2">
                                <img id="flag" src="/img/countryFlags/<%= homeData.nextRaceInfo.country %>.svg" class="h-6 w-auto shadow-md rounded-sm" alt="Flag" />
                                <h2 class="font-wide text-lg md:text-2xl m-0"><%= homeData.nextRaceInfo.name %></h2>
                            </div>
                            <div class="text-orange-400 font-bold tracking-widest uppercase text-sm mb-6"><%= homeData.nextRaceInfo.nextSessionName %></div>

                            <div id="countdown" class="grid grid-cols-4 gap-4 font-wide text-3xl m-0 bg-b-<%= theme %> px-6 py-4 rounded-2xl shadow-inner w-full max-w-sm md:max-w-lg border border-gray-700">
                                <div class="flex flex-col items-center"><span id="days" class="text-xl md:text-2xl font-bold">00</span><span class="text-xs text-t-s-<%= theme %> tracking-wider"><%= __('home.days') %></span></div>
                                <div class="flex flex-col items-center"><span id="hours" class="text-xl md:text-2xl font-bold">00</span><span class="text-xs text-t-s-<%= theme %> tracking-wider"><%= __('home.hours') %></span></div>
                                <div class="flex flex-col items-center"><span id="minutes" class="text-xl md:text-2xl font-bold">00</span><span class="text-xs text-t-s-<%= theme %> tracking-wider"><%= __('home.minutes') %></span></div>
                                <div class="flex flex-col items-center"><span id="seconds" class="text-xl md:text-2xl font-bold">00</span><span class="text-xs text-t-s-<%= theme %> tracking-wider"><%= __('home.seconds') %></span></div>
                            </div>
                        </div>
                        <% } else { %>
                        <div class="flex flex-col justify-center items-center h-full z-10">
                            <h2 class="text-center text-orange-400 font-wide text-2xl m-0"><%= __('home.season_finished') || 'Saison terminée' %></h2>
                        </div>
                        <% } %>
                    </div>

                    <div class="w-full h-full md:mt-0 mt-4">
                        <% if (homeData.lastPodiumLocalisation) { %>
                        <a href="/retrogpdetails/<%= currentYear %>/<%= homeData.lastPodiumLocalisation.id %>">
                            <div class="w-full bg-s-<%= theme %> rounded-3xl overflow-hidden">
                                <span class="flex justify-center text-center mb-4 font-bold gap-2 pt-2">
                                    <%= __('home.last_race') %> - <%= homeData.lastPodiumLocalisation.name %>
                                    <img src="/img/countryFlags/<%= homeData.lastPodiumLocalisation.country %>.svg" alt="<%= homeData.lastPodiumLocalisation.country %>" class="h-6 w-auto" />
                                </span>
                                <div class="flex justify-evenly items-end h-full">
                                    <div class="flex flex-col items-center">
                                        <img alt="F1 Image" src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= homeData.lastPodium[1].driverId %>.webp" class="h-20 md:h-24 w-auto" />
                                        <div class="w-24 h-24 silver rounded-t-lg flex flex-col items-center justify-center">
                                            <span class="text-lg font-bold">2</span>
                                            <span class="text-sm font-bold mt-2"> <%= homeData.lastPodium[1].abbreviation %> </span>
                                        </div>
                                    </div>
                                    <div class="flex flex-col items-center">
                                        <img alt="F1 Image" src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= homeData.lastPodium[0].driverId %>.webp" class="h-20 md:h-24 w-auto" />
                                        <div class="w-24 h-32 gold rounded-t-lg flex flex-col items-center justify-center">
                                            <span class="text-lg font-bold">1</span>
                                            <span class="text-sm font-bold mt-2"> <%= homeData.lastPodium[0].abbreviation %> </span>
                                        </div>
                                    </div>
                                    <div class="flex flex-col items-center">
                                        <img alt="F1 Image" src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= homeData.lastPodium[2].driverId %>.webp" class="h-20 md:h-24 w-auto" />
                                        <div class="w-24 h-20 bronze rounded-t-lg flex flex-col items-center justify-center">
                                            <span class="text-lg font-bold">3</span>
                                            <span class="text-sm font-bold mt-2"> <%= homeData.lastPodium[2].abbreviation %> </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                        <% } %>

                        <div id="championnats" class="flex gap-4 w-full mt-4">
                            <a href="/driver/<%= homeData.driverLeader.driverId %>" class="w-full">
                                <div id="chPilotes" class="h-40 md:h-36 bg-s-<%= theme %> flex flex-col justify-center items-center font-bold rounded-3xl overflow-hidden">
                                    <span class="text-center pt-2"> <%= __('home.drivers_championship') %> </span>
                                    <span class="flex justify-evenly items-center mt-auto gap-2">
                                        <span class="flex flex-col items-center text-xl">
                                            <span>
                                                <%= homeData.driverLeader.abbreviation %>
                                            </span>
                                            <span class="text-<%= homeData.driverLeader.constructorId %>"> <% if(homeData.driverLeader.permanentNumber==4) { %> <%= 1 %> <% } else { %> <%= homeData.driverLeader.permanentNumber %> <% } %> </span>
                                        </span>
                                        <img alt="F1 Image" src="https://pitlaneinsider-data.alwaysdata.net/drivers_img/<%= homeData.driverLeader.driverId %>.webp" class="h-20 md:h-24 w-auto" />
                                    </span>
                                </div>
                            </a>

                            <a href="/constructor/<%= homeData.constructorLeader.constructorId %>" class="w-full">
                                <div id="chContructeurs" class="h-40 md:h-36 bg-s-<%= theme %> flex flex-col items-center rounded-3xl">
                                    <span class="text-center font-bold pt-2"> <%= __('home.constructors_championship') %> </span>
                                    <span>
                                        <img alt="F1 Image" src="/img/constructors/<%= homeData.constructorLeader.constructorId %>.webp" class="h-12 md:h-16 w-auto mt-5" />
                                    </span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col md:flex-row gap-y-4 gap-x-4 mt-4 mb-8">
                    <!-- Classements (Merged) -->
                    <div class="w-full lg:w-1/2 bg-s-<%= theme %> py-2 rounded-3xl p-4">
                        <div class="flex justify-around mb-4 border-b border-gray-600 pb-2">
                            <a href="/driverstandings" class="text-center font-bold text-lg hover:underline"><%= __('home.drivers_standings') %></a>
                            <a href="/constructorstandings" class="text-center font-bold text-lg hover:underline"><%= __('home.constructors_standings') %></a>
                        </div>
                        <div class="flex justify-evenly gap-x-2">
                            <!-- Drivers -->
                            <div class="w-1/2">
                                <table class="w-full text-sm">
                                    <% homeData.driverStandings.slice(0, 10).forEach(function(pilote) { %>
                                    <tr>
                                        <td class="pr-1 py-1">
                                            <span class="border-2 border-<%= pilote.constructorId %> h-auto w-1 box-border bg-<%= pilote.constructorId %> rounded-3xl"> </span>
                                        </td>
                                        <td class="font-bold"><%= String(pilote.position).padStart(2, '0' ) %></td>
                                        <td class="truncate max-w-[60px]">
                                            <a href="/driver/<%= pilote.driverId %>" class="hover:underline"> <%= pilote.lastName %> </a>
                                        </td>
                                        <td class="pl-3 border-l-2 border-gray-600 py-1"></td>
                                        <td class="px-1 hidden md:block"><%= pilote.points %>pts</td>
                                        <td class="px-1 block md:hidden"><%= pilote.points %></td>
                                    </tr>
                                    <% }); %>
                                </table>
                            </div>
                            <span class="border border-<%= theme %> w-0.5 box-border bg-<%= theme %> mx-2"></span>
                            <!-- Constructors -->
                            <div class="w-1/2">
                                <table class="w-full text-sm">
                                    <% homeData.constructorStandings.slice(0, 10).forEach(function(constructor) { %>
                                    <tr>
                                        <td class="pr-1 py-1">
                                            <span class="border-2 border-<%= constructor.constructorId %> h-auto w-1 box-border bg-<%= constructor.constructorId %> rounded-3xl"> </span>
                                        </td>
                                        <td class="font-bold"><%= String(constructor.position).padStart(2, '0') %></td>
                                        <td class="truncate max-w-[60px]">
                                            <a href="/constructor/<%= constructor.constructorId %>" class="hover:underline"> <%= constructor.name %> </a>
                                        </td>
                                        <td class="pl-3 border-l-2 border-gray-600 py-1"></td>
                                        <td class="px-1 hidden md:block"><%= constructor.points %>pts</td>
                                        <td class="px-1 block md:hidden"><%= constructor.points %></td>
                                    </tr>
                                    <% }); %>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="w-full lg:w-1/2 bg-s-<%= theme %> py-4 px-6 rounded-3xl flex flex-col justify-center items-center relative overflow-hidden">
                        <a href="">News</a>
                        <table>
                            <% newsFront.forEach(function(article) { %>
                            <tr class="border-b-2">
                                <td>
                                    <a href="<%= article.link %>" target="_blank">
                                        <div class="pt-2 px-4">
                                            <p class="text-xs text-t-s-<%= theme %> font-bold"><%= article.pubDate %></p>
                                            <h2 class="text-md font-bold mb-2 pt-4"><%= article.title %></h2>
                                        </div>
                                    </a>
                                </td>
                            </tr>
                            <% }); %>
                        </table>
                    </div>
                </div>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>

    <script>
        /**
         * @description Démarre le compte à rebours pour la prochaine course
         * @param {string} raceDate
         * @param {string} raceTime
         * @returns {void}
         */
        function startCountdown(raceDate, raceTime) {
            // Convertit la date et l'heure de la course en UTC+2 (heure d'été française)
            const offset = 2; // UTC+2 pour l'heure d'été française
            const raceDateTime = new Date(`${raceDate}T${raceTime}`).getTime();
            const adjustedRaceDateTime = raceDateTime + offset * 60 * 60 * 1000; // Ajuste pour le fuseau horaire français

            let previousDays, previousHours, previousMinutes, previousSeconds;

            function updateCountdown() {
                const now = new Date().getTime();
                const distance = adjustedRaceDateTime - now;

                if (distance < 0) {
                    clearInterval(countdownInterval);
                    document.getElementById('countdown').innerHTML = `<div class="col-span-12 flex justify-evenly items-center gap-2"><span class="flex gap-1 items-center"><span class="w-4 h-4 rounded-full bg-red-500 animate-pulse inline-block"></span><a href="/live" class="text-red-500">Live</a></span></div>`;
                    return;
                }

                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                if (days !== previousDays) {
                    updateTimeElement('days', days);
                    previousDays = days;
                }
                if (hours !== previousHours) {
                    updateTimeElement('hours', hours);
                    previousHours = hours;
                }
                if (minutes !== previousMinutes) {
                    updateTimeElement('minutes', minutes);
                    previousMinutes = minutes;
                }
                if (seconds !== previousSeconds) {
                    updateTimeElement('seconds', seconds);
                    previousSeconds = seconds;
                }
            }

            function updateTimeElement(id, value) {
                const element = document.getElementById(id);
                element.classList.remove('animation-slide');
                void element.offsetWidth; // Trigger reflow to restart the animation
                element.classList.add('animation-slide');
                element.textContent = String(value).padStart(2, '0');
            }

            const countdownInterval = setInterval(updateCountdown, 1000);
            updateCountdown();
        }

        function convertDate(dateString) {
            var date = new Date(dateString);
            var day = date.getDate();
            var month = date.getMonth() + 1; // Les mois sont indexés à partir de 0 en JavaScript
            return (day < 10 ? '0' : '') + day + '/' + (month < 10 ? '0' : '') + month;
        }

        function convertTime(timeString) {
            var timeParts = timeString.split(':'); // Les heures sont le premier élément, les minutes sont le deuxième
            var hour = timeParts[0];
            var minute = timeParts[1];
            return minute === '00' ? hour + 'h' : hour + 'h' + minute;
        }

        ('<% if (homeData.nextRaceInfo && homeData.nextRaceInfo.nextSessionDate && homeData.nextRaceInfo.nextSessionTime) { %>');
        startCountdown('<%= homeData.nextRaceInfo.nextSessionDate %>', '<%= homeData.nextRaceInfo.nextSessionTime %>');
        ('<% } %>');
    </script>
</html>
