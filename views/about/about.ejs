<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
            <title>PLI - <%= __('about.tab_title') %>
            </title>
</head>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <div class="flex flex-col gap-4 items-center pt-4">

        <span class="font-F1Wide text-xl md:text-3xl">PitLane Insider</span>

        <span class="italic">La Remontée Formula 1 Team</span>

        <span>
            <span class="underline font-bold">
                <%= __('about.devteam') %> :
            </span>
            <ul>
                <li>ROY Jules</li>
                <li>HU Lucas</li>
                <li>DUMAS Antonin</li>
                <li>HUBERT Matthieu</li>
                <li>DELRUE Cyprien</li>
                <li>BASSET Maxime</li>
                <li>BERGHE Nathan</li>
            </ul>
        </span>

        <span class="flex flex-col items-center pt-8">
            <span class="font-F1Bold text-xl">DISCLAIMER</span>
            <span class="pt-2 w-2/3">
                <%= __('about.disclaimer') %>
            </span>
        </span>

        <span class="flex flex-col items-center pt-8">
            <span class="font-F1Bold text-xl">
                <%= __('about.dataorigin_title') %> :
            </span>
            <span class="pt-2 w-2/3">
                <%= __('about.dataorigin_beginning') %><a
                        href="https://fr.wikipedia.org/wiki/Interface_de_programmation" target="_blank"
                        class="text-blue-400">
                        <%= __('about.dataorigin_link1') %>
                    </a>
                    <%= __('about.dataorigin_explanation_link_1') %> :
            </span>
            <ul class="w-2/3">
                <li class="pt-2">- <a href="https://ergast.com/mrd/" target="_blank" class="text-blue-400">Ergast
                        Developer API</a>
                    <%= __('about.dataorigin_explanation_link_2') %>
                </li>
                <li class="pt-2">- <a href="https://openf1.org/" target="_blank" class="text-blue-400">OpenF1 API</a>
                    <%= __('about.dataorigin_explanation_link_3') %>
                </li>
            </ul>
        </span>

        <span class="flex flex-col items-center pt-8">
            <span class="font-F1Bold text-xl">
                <%= __('about.dataorigin_cookie_policy_title') %>
            </span>
            <span class="pt-2 w-2/3">
                <strong>
                    <%= __('about.dataorigin_cookie_policy_introduction_title') %> :
                </strong>
                <%= __('about.dataorigin_cookie_policy_introduction') %>
            </span>
            <span class="pt-2 w-2/3">
                <strong>
                    <%= __('about.dataorigin_cookie_policy_explanantion1_title') %>
                </strong>
                <%= __('about.dataorigin_cookie_policy_explanantion1') %>
            </span>
            <span class="pt-2 w-2/3">
                <strong>
                    <%= __('about.dataorigin_cookie_policy_explanantion2_title') %> :
                </strong>
                <%= __('about.dataorigin_cookie_policy_explanantion2') %>
            </span>
            <span class="pt-2 w-2/3">
                <strong>
                    <%= __('about.dataorigin_cookie_policy_explanantion3_title') %> :
                </strong>
                <%= __('about.dataorigin_cookie_policy_explanantion3') %>
            </span>
        </span>

    </div>
    <%- include('../partials/footer.ejs') %>
</body>

</html>