<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <title>PLI - <%= __('about.tab_title') %></title>
    </head>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %> text-justify">
        <main>
            <div class="flex flex-col gap-4 items-center pt-4">
                <span class="font-wide text-xl md:text-3xl">PitLane Insider</span>

                <span class="font-bold">v2026.1.0</span>

                <span class="flex flex-col items-center gap-y-1">
                    <span class="italic">La Remontée Formula 1 Team</span>
                    <span class="text-xs">2024-<%= new Date().getFullYear() %></span>
                </span>

                <span class="flex flex-col gap-y-6">
                    <div>
                        <span class="underline font-bold"> <%= __('about.leaddev') %></span>
                        <ul>
                            <li><a href="https://julesr0y.xyz/" target="_blank">ROY Jules</a></li>
                        </ul>
                    </div>

                    <div>
                        <span class="underline font-bold"> <%= __('about.devteam') %></span>
                        <ul>
                            <li>HU Lucas</li>
                            <li>DUMAS Antonin</li>
                            <li>HUBERT Matthieu</li>
                            <li>DELRUE Cyprien</li>
                            <li>BASSET Maxime</li>
                            <li>BERGHE Nathan</li>
                        </ul>
                    </div>
                </span>

                <span class="flex flex-col items-center pt-8">
                    <span class="font-bold text-xl">DISCLAIMER</span>
                    <span class="pt-2 w-2/3"> <%= __('about.disclaimer') %> </span>
                </span>

                <span class="flex flex-col items-center pt-8 w-2/3">
                    <span class="font-bold text-xl"> <%= __('about.dataorigin_title') %> </span>
                    <span class="pt-2">
                        <%= __('about.dataorigin_beginning') %><a href="https://fr.wikipedia.org/wiki/Interface_de_programmation" target="_blank" class="text-blue-400"> <%= __('about.dataorigin_link1') %> </a>
                        <%= __('about.dataorigin_explanation_link_1') %>
                    </span>
                    <ul class="w-full">
                        <li class="pt-2">
                            - <a href="https://github.com/f1db/f1db/" target="_blank" class="text-blue-400">f1db</a>
                            <%= __('about.dataorigin_explanation_link_2') %>
                        </li>
                        <li class="pt-2">
                            - <a href="https://openf1.org/" target="_blank" class="text-blue-400">OpenF1 API</a>
                            <%= __('about.dataorigin_explanation_link_3') %>
                        </li>
                        <li class="pt-2">
                            - <a href="https://www.statsf1.com/" target="_blank" class="text-blue-400">STATS F1</a>
                            <%= __('about.dataorigin_explanation_link_4') %>
                        </li>
                        <li class="pt-2">
                            - <a href="https://github.com/julesr0y/f1-circuits-svg" target="_blank" class="text-blue-400">F1 circuits SVG</a>
                            <%= __('about.dataorigin_explanation_link_5') %>
                        </li>
                    </ul>
                </span>

                <span class="flex flex-col items-center gap-y-2">
                    <p>Follow us :</p>
                    <div class="flex gap-4">
                        <a href="https://github.com/julesr0y/pitlaneinsider" target="_blank">
                            <img src="img/social/github_logo_<%= theme %>.svg" alt="Github" class="w-auto h-8" />
                        </a>
                        <a href="https://x.com/pli_app" target="_blank">
                            <img src="img/social/x_logo_<%= theme %>.svg" alt="X" class="w-auto h-8" />
                        </a>
                    </div>
                </span>
            </div>
        </main>
        <%- include('../partials/footer.ejs') %>
    </body>
</html>
