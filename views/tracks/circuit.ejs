<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
            <title>PLI - <%= trackFront.trackName %>
            </title>
</head>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <div class="h-auto flex flex-col justify-center">
        <div class="bg-s-<%= theme %> p-4 sm:p-8 rounded-3xl mx-auto max-w-sm sm:max-w-xl h-2/3 mt-8">
            <div class="flex items-center justify-center gap-4">
                <img src="/img/countryFlags/<%= trackFront.trackCountry.toLowerCase() %>.svg" alt="Drapeau de l'Italie"
                    class="h-12 w-auto">
                <h1 class="text-lg font-F1Bold mb-2">
                    <%= trackFront.trackName %>
                </h1>
            </div>

            <!-- Circuit Map -->
            <div class="flex justify-center">
                <img src="/img/2024/circuit/<%= trackFront.trackId.toLowerCase() %>.webp" alt="Map of Monza Circuit"
                    class="w-full h-auto">
            </div>

            <!-- Race Info -->
            <div class="text-center mt-4">
                <p><strong>
                        <%= __('calendar_element.creation_year') %> :
                    </strong>
                    <%= dataCircuit.creationYear %>
                </p>
                <p><strong>
                        <%= __('calendar_element.laps') %> :
                    </strong>
                    <%= dataCircuit.lapsNumber %>
                </p>
                <p><strong>
                        <%= __('calendar_element.one_lap_length') %> :
                    </strong>
                    <%= dataCircuit.oneLapDistance %>km
                </p>
                <p><strong>
                        <%= __('calendar_element.length') %> :
                    </strong>
                    <%= dataCircuit.totalDistance %>km
                </p>
                <p><strong>
                        <%= __('calendar_element.pole_record') %> :
                    </strong>
                    <%= dataCircuit.lapRecord %>
                </p>
            </div>
        </div>
    </div>
    <%- include('../partials/footer.ejs') %>
</body>

</html>