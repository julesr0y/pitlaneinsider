<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head.ejs') %>
        <%- include('partials/header.ejs') %>
            <title>PLI - Administration </title>
</head>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<style>
    .loading {
        display: none;
        z-index: 1000;
    }
</style>

<body class="font-F1Regular">

    <p class="text-center">
        Administration
    </p>

    <span class="flex justify-center mt-4">
        <button id="updateCachesBtn" class="py-2 px-4 text-white bg-main-color">Mettre à jour les caches</button>
    </span>

    <div class="loading flex flex-col justify-center items-center min-h-screen">
        <img src="/img/assets/sainz.gif" alt="Chargement..." class="w-2/3 md:w-1/4 mx-auto">
        <p class="text-center">Mise à jour des caches en cours...</p>
    </div>

    <script>
        // JavaScript pour déclencher la mise à jour des caches et montrer/cacher l'animation
        $('#updateCachesBtn').on('click', function () {
            // Montrer l'animation de chargement
            $('.loading').show();

            // Appeler votre route de mise à jour des caches
            $.get('/administration/updateCaches', function (data) {
                const taskId = data.taskId;
                console.log(`Tâche ${taskId} de mise à jour des caches démarrée`);

                // Vérifier régulièrement si la tâche est terminée
                const checkTaskStatus = setInterval(function () {
                    $.get(`/checkTaskStatus?taskId=${taskId}`, function (status) {
                        if (status === 'completed') {
                            console.log(`Tâche ${taskId} de mise à jour des caches terminée`);
                            clearInterval(checkTaskStatus);
                            // Cacher l'animation de chargement
                            $('.loading').hide();
                            // Mettre à jour la page avec un message ou une action supplémentaire si nécessaire
                        }
                    });
                }, 1000); // Vérifier toutes les 1 seconde
            });
        });
    </script>
</body>

</html>