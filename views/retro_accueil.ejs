<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head.ejs') %>
        <%- include('partials/header.ejs') %>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>PLI - <%= __('retro_f1.home.tab_title') %>
            </title>
</head>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <div class="text-3xl font-bold text-center my-8 mb-4 w-full pt-4 lg:pt-8 lg:text-3xl lg:font-bold lg:my-8">
        <%= __('retro_f1.home.title') %>
    </div>
    <div class="max-w-screen-xl mx-auto">

        <div class="flex flex-col lg:flex-row justify-center items-start mt-4 space-y-4 lg:space-y-0 lg:space-x-4 px-4">
            <a href="retro_titre" class="w-full lg:w-1/3 bg-second-color rounded-3xl pt-2 px-2 pr-4 flex-grow">
                <h2 class="text-center font-F1Bold mb-4">
                    <%= __('retro_f1.home.winners_title') %>
                </h2>
                <div class="flex flex-wrap justify-center items-center">
                    <% retro_accueil.forEach((winner, index)=> { %>
                        <div class="<%= index < 2 ? 'w-1/2' : 'w-full' %> text-center p-2">
                            <div class="bg-s-<%= theme %> shadow-lg rounded-lg overflow-hidden">
                                <div class="p-4">
                                    <% if (index===0) { %>
                                        <img src="/img/drivers/michael_schumacher.webp" alt="Schumacher"
                                            class="h-32 w-32 object-cover mx-auto">
                                        <% } else if (index===1) { %>
                                            <img src="/img/drivers/hamilton.webp" alt="Hamilton"
                                                class="h-32 w-32l object-cover mx-auto">
                                            <% } else if (index===2) { %>
                                                <img src="/img/drivers/fangio.webp" alt="Fangio"
                                                    class="h-32 w-32 object-cover mx-auto">
                                                <% } %>
                                </div>
                                <div class="p-4">
                                    <h3 class="font-F1Bold text-xl md:text-2xl mb-2">
                                        <%= winner.firstName %>
                                            <%= winner.lastName %>
                                    </h3>
                                    <p class="text-t-s-<%= theme %> text-lg md:text-xl">
                                        <%= winner.wins %>
                                            <% if (index < 3) { %>
                                                <%= __('retro_f1.home.driver_titles') %>
                                                    <% } else { %>
                                                        wins
                                                        <% } %>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                </div>
            </a>
        </div>

        <div>
            <div
                class="flex flex-col md:flex-row justify-center items-start mt-4 space-y-4 md:space-y-0 md:space-x-4 px-4">
                <a href="retro_pilotes" class="bg-s-<%= theme %> w-full md:w-1/2 lg:w-1/3 rounded-3xl pt-4 flex-grow">
                    <h2 class="text-center font-F1Bold mb-4">
                        <%= __('retro_f1.home.all_data') %>
                    </h2>
                    <div class="flex flex-col items-center justify-around h-full">
                        <img src="/img/teams/aston_martin.webp" alt="Aston Martin" class="h-8 md:h-16">
                        <div class="flex items-center">
                            <div class="flex-row">
                                <p class="font-F1Bold text-aston_martin">14</p>
                                <p class="font-F1Bold">ALO</p>
                            </div>
                            <div>
                                <img src="img/2024/drivers/alonso.webp" alt="Alonso" class="h-20 md:h-24 object-cover">
                            </div>
                        </div>
                    </div>
                </a>

                <a href="retro_classement"
                    class="bg-s-<%= theme %> w-full md:w-1/2 lg:w-1/3 rounded-3xl pt-4 flex-grow">
                    <h2 class="text-center font-F1Bold mb-4">
                        <%= __('retro_f1.home.all_seasons') %>
                    </h2>
                    <div class="flex flex-col items-center justify-around h-full">
                        <div class="flex flex-col justify-evenly items-center">
                            <p class="font-F1Bold">2023</p>
                            <img src="/img/2024/circuit/monza.webp" alt="Monza" class="w-48">
                            <p class="text-center">Vainqueur : Max Verstappen</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
    <%- include('partials/footer.ejs') %>
</body>

</html>