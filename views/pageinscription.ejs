<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head.ejs') %>
        <%- include('partials/header.ejs') %>
            <title>PLI - Inscription</title>
</head>

<body class="bg-gray-100">
    <div class="flex items-center justify-center h-screen">
        <div class="bg-white px-10 py-8 rounded-lg shadow-md w-full max-w-sm" style="border-radius: 20px;">
            <div class="mb-4">
                <!-- Ajouter les autres éléments comme le logo PLI ici si nécessaire -->
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
                <input type="text" name="last_name" placeholder="Nom"
                    class="input-bg px-4 py-2 border border-gray-300 rounded-lg shadow-sm bg-gray-200 rounded-full"
                    required>
                <input type="text" name="first_name" placeholder="Prénom"
                    class="input-bg px-4 py-2 border border-gray-300 rounded-lg shadow-sm bg-gray-200 rounded-full"
                    required>
            </div>
            <div class="grid gap-4 mb-4">
                <input type="email" name="email" placeholder="Email"
                    class="input-bg px-4 py-2 border border-gray-300 rounded-lg shadow-sm w-full bg-gray-200 rounded-full"
                    required>
                <input type="text" name="username" placeholder="Username"
                    class="input-bg px-4 py-2 border border-gray-300 rounded-lg shadow-sm w-full bg-gray-200 rounded-full "
                    required>
                <input type="password" name="password" placeholder="Mot de passe"
                    class="input-bg px-4 py-2 border border-gray-300 rounded-lg shadow-sm w-full bg-gray-200 rounded-full"
                    required>
                <input type="password" name="confirm_password" placeholder="Confirmer le mot de passe"
                    class="input-bg px-4 py-2 border border-gray-300 rounded-lg shadow-sm w-full bg-gray-200 rounded-full"
                    required>
            </div>
            <div class="flex items-center justify-between mb-4">
                <button type="submit"
                    class="px-4 py-2 bg-green-700 text-white font-semibold rounded-lg shadow-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50 w-full mr-2 rounded-full">
                    Inscription
                </button>
                <button type="button"
                    class="px-4 py-2 bg-transparent text-058785 font-semibold rounded-lg border border-green-600 shadow-md hover:bg-green-100 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50 w-full ml-2 rounded-full">
                    Connexion
                </button>
            </div>
        </div>
    </div>
    <%- include('partials/footer.ejs') %>
</body>

</html>