<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head.ejs') %>
        <%- include('partials/header.ejs') %>
            <title>PLI - <%= __('teams.tab_title') %>
            </title>
</head>

<body class="font-F1Regular text-<%= theme %> bg-b-<%= theme %>">
    <div class="text-3xl font-bold text-center my-8 lg:text-3xl lg:font-bold lg:my-8">
        <%= __('teams.season') %>
    </div>
    <div class="max-w-7xl mx-auto p-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            <% teamsFront.forEach(function(ecurie) { %>
                <a href="/team/<%= ecurie.equipe_id %>" class="block text-center relative">
                    <div
                        class="bg-s-<%= theme %> rounded-3xl shadow-lg transition-transform transform hover:-translate-y-1 hover:shadow-xl border-t-4 border-transparent hover:border-teal-700 p-6 flex flex-col items-center text-center">
                        <div class="mb-4">
                            <img src="/img/2024/logo/<%= ecurie.equipe_id %>.webp" alt="<%= ecurie.equipe %>"
                                class="h-16 mb-4 object-contain">
                        </div>
                        <div class="text-xl font-bold mt-2">
                            <%= ecurie.equipe %>
                        </div>
                    </div>
                </a>
                <% }); %>
        </div>
    </div>
    <%- include('partials/footer.ejs') %>
</body>

</html>