<!DOCTYPE html>
<html lang="<%= __('lang.lang') %>">
    <head>
        <%- include('../partials/head.ejs') %>
        <%- include('../partials/header.ejs') %>
        <title>PLI - <%= __('news.tab_title') %></title>
    </head>

    <body class="font-regular text-<%= theme %> bg-b-<%= theme %>">
        <main>
            <div class="text-3xl font-bold text-center my-8 mb-4 w-full pt-4 lg:pt-8 lg:text-3xl lg:font-bold lg:my-8"><%= __('news.news_title') %></div>

            <div class="w-9/10 mx-auto p-4 pt-0">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pt-10">
                    <% newsFront.forEach(function(article) { %>
                    <a href="<%= article.link %>" target="_blank">
                        <div class="bg-s-<%= theme %> rounded-lg overflow-hidden transform transition duration-300 hover:scale-105">
                            <img src="<%= article.enclosure.url %>" alt="<%= article.title %>" class="rounded-t-lg w-full h-48 object-cover" />
                            <div class="pt-2 pb-4 px-4">
                                <p class="text-xs text-t-s-<%= theme %> font-bold"><%= article.pubDate %></p>
                                <h2 class="text-xl font-bold mb-2 pt-4"><%= article.title %></h2>
                            </div>
                        </div>
                    </a>
                    <% }); %>
                </div>
            </div>
        </main>

        <%- include('../partials/footer.ejs') %>
    </body>
</html>
