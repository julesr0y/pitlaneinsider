{
    "name": "pitlaneinsider",
    "version": "2025.0.2-beta.1",
    "private": true,
    "scripts": {
        "start": "node ./bin/www",
        "dev": "nodemon",
        "build:css": "npx @tailwindcss/cli -i ./public/stylesheets/tailwind.css -o ./public/stylesheets/style.css",
        "doc": "npx jsdoc -c Documentation.json",
        "format:views": "prettier --write ./views/**/*.ejs",
        "release": "npm run doc && npm run format:views"
    },
    "dependencies": {
        "compression": "^1.7.5",
        "cors": "^2.8.5",
        "debug": "~4.4.0",
        "ejs": "^3.1.10",
        "express": "^4.21.2",
        "express-session": "^1.18.1",
        "fast-xml-parser": "^4.5.1",
        "helmet": "^8.0.0",
        "http-errors": "~2.0.0",
        "i18n": "^0.15.1",
        "msgpack-lite": "^0.1.26"
    },
    "devDependencies": {
        "jsdoc": "^4.0.4",
        "nodemon": "^3.1.9",
        "prettier": "^3.4.2",
        "prettier-plugin-ejs": "^1.0.3",
        "tailwindcss": "^4.0.15"
    }
}
