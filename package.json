{
    "name": "pitlaneinsider",
    "version": "2026.1.0",
    "private": true,
    "scripts": {
        "start": "node ./bin/www",
        "dev": "nodemon",
        "build:css": "npx @tailwindcss/cli -i ./public/stylesheets/tailwind.css -o ./public/stylesheets/style.css",
        "doc": "npx jsdoc -c Documentation.json",
        "format:views": "prettier --write ./views/**/*.ejs",
        "release": "npm run doc && npm run format:views"
    },
    "dependencies": {
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "debug": "~4.4.3",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.0",
        "express-session": "^1.19.0",
        "fast-xml-parser": "^5.10.0",
        "helmet": "^8.3.0",
        "http-errors": "~2.0.1",
        "i18n": "^0.15.3",
        "morgan": "^1.11.0",
        "msgpack-lite": "^0.1.26",
        "ws": "^8.21.1"
    },
    "devDependencies": {
        "jsdoc": "^4.0.5",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.5",
        "prettier-plugin-ejs": "^1.0.3",
        "tailwindcss": "^4.3.2"
    }
}
